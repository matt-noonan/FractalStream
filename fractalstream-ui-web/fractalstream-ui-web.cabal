cabal-version:       3.0
name:                fractalstream-ui-web
version:             2.0.0.0
synopsis:            FractalStream in the browser: the engine.
description:         The engine of FractalStream's web app (see WEB_PLAN.md and
                     web/): the core and the wasm backend, as a WebAssembly
                     reactor module that runs in a Web Worker and talks to the
                     page (web/src) by messages. Only builds for wasm32; build
                     the web app with dev-tools/web/build.sh.
license:             BSD-3-Clause
license-file:        LICENSE
author:              Matt Noonan
maintainer:          matt.noonan@gmail.com
copyright:           2026, Matt Noonan
category:            Math
build-type:          Simple

common FractalStream-common
  ghc-options:         -Wall -Werror -O2 -Wno-star-is-type
  -- This is basically the list of extensions from
  -- https://lexi-lambda.github.io/blog/2018/02/10/an-opinionated-guide-to-haskell-in-2018/
  -- with a few minor additions like ViewPatterns.
  -- I also switch on RecordWildCards because I like it: it lets you bring
  -- all fields of a record into scope, giving some of the flavor of an OOP
  -- language with member variables automatically in scope of object methods.
  default-extensions:  ApplicativeDo
                     , BangPatterns
                     , ConstraintKinds
                     , DataKinds
                     , DefaultSignatures
                     , DeriveFoldable
                     , DeriveFunctor
                     , DeriveGeneric
                     , DeriveLift
                     , DeriveTraversable
                     , DerivingStrategies
                     , EmptyCase
                     , ExistentialQuantification
                     , FlexibleContexts
                     , FlexibleInstances
                     , FunctionalDependencies
                     , GADTs
                     , GeneralizedNewtypeDeriving
                     , InstanceSigs
                     , KindSignatures
                     , LambdaCase
                     , MultiParamTypeClasses
                     , MultiWayIf
                     , NamedFieldPuns
                     , PatternSynonyms
                     , RankNTypes
                     , RecordWildCards
                     , ScopedTypeVariables
                     , StandaloneDeriving
                     , TupleSections
                     , TypeApplications
                     , TypeFamilies
                     , TypeFamilyDependencies
                     , TypeOperators
                     , ViewPatterns
  default-language:    Haskell2010

executable fractalstream-web
  import: FractalStream-common
  if !arch(wasm32)
    buildable:         False
  main-is:             Main.hs
  hs-source-dirs:      src
  -- (a reactor module: the page's worker calls its exports; see web/src/engine.ts)
  ghc-options:         -no-hs-main -optl-mexec-model=reactor
                       "-optl-Wl,--export=fs_library,--export=fs_open,--export=fs_open_file,--export=fs_save,--export=fs_set,--export=fs_view,--export=fs_resize,--export=fs_smoothing,--export=fs_rotate"
  build-depends:       base >=4.8 && <5
                     , fractalstream-core
                     , fractalstream-library
                     , fractalstream-backend-wasm
                     , ghc-experimental
                     , aeson
                     , base64-bytestring
                     , bytestring
                     , text
                     , containers
                     , filepath
