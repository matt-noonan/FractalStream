cabal-version:       3.0
name:                fractalstream-backend-wgpu
version:             2.0.0.0
synopsis:            FractalStream's desktop GPU: wgpu-native.
description:         The GPU device the GPU backends (fractalstream-backend-wgsl) draw on, on the desktop: wgpu-native, WebGPU's C API. macOS, Linux and Windows; run dev-tools/wgpu/fetch.sh first.
license:             BSD-3-Clause
license-file:        LICENSE
author:              Matt Noonan
maintainer:          matt.noonan@gmail.com
copyright:           2026, Matt Noonan
category:            Math
build-type:          Custom

-- (Setup.hs: where wgpu-native is)
custom-setup
  setup-depends:     base >=4.8 && <5, Cabal, directory

library
  exposed-modules:     Backend.WGPU
  build-depends:       base >=4.8 && <5
                     , fractalstream-backend-wgsl
  hs-source-dirs:      src
  default-language:    Haskell2010
  default-extensions:  LambdaCase
  ghc-options:         -Wall -Werror -O2
  if os(darwin) || os(linux) || os(windows)
    c-sources:         cbits/fsgpu.c
    cc-options:        -std=c11 -Wall
    -- (wgpu-native: dev-tools/wgpu/fetch.sh puts it in
    -- third_party/wgpu-native, whose library folder Setup.hs adds:
    -- statically on macOS and Linux, and on Windows its DLL)
    include-dirs:      ../third_party/wgpu-native/include
    extra-libraries:   wgpu_native
  -- (what wgpu-native needs from the system: it finds the GPU's drivers,
  -- Metal, or Vulkan's loader, libvulkan.so.1, itself, when it starts)
  if os(darwin)
    frameworks:        Metal QuartzCore Foundation
  if os(linux)
    extra-libraries:   dl pthread m gcc_s
