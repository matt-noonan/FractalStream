=== viewer 0: Standard spider
--- body
let `[internal] vanishing radius` = vanishing_radius in:
  let `[internal] escape radius` = escape_radius in:
    let `[internal] iteration limit` = max_iters in:
      let `[internal] stuck` = False in:
        let `[internal] iteration count` = 0 in:
          let `z` = ([internal] x:C + (0.0 :+ 1.0 * [internal] y:C)) in:
            let `pixel_size` = [internal] dx in:
              block:
                set `color` := Color 255 255 255


--- tool Draw standard spider
  -- on refresh
let `[internal] vanishing radius` = vanishing_radius in:
  let `[internal] escape radius` = escape_radius in:
    let `[internal] iteration limit` = max_iters in:
      let `[internal] stuck` = False in:
        let `[internal] iteration count` = 0 in:
          let `pixel_size` = [internal] px in:
            block:
              let `savedP` = p in:
                block:
                  let `savedQ` = q in:
                    block:
                      let `h2` = p in:
                        block:
                          let `h1` = (p + q) in:
                            block:
                              set `p` := (2 * p)
                              set `q` := (2 * q)
                              erase
                              use Color 128 128 128 for line
                              draw circle at 0:R:C:R^2 with radius 1:R
                              let `star1` = (2.718281828459045:C ^ ((((2:R * 3.141592653589793):C * 0.0 :+ 1.0) * h1:R:C) / q:R:C)) in:
                                block:
                                  let `star2` = (2.718281828459045:C ^ ((((2:R * 3.141592653589793):C * 0.0 :+ 1.0) * h2:R:C) / q:R:C)) in:
                                    block:
                                      draw line from star1:R^2 to star2:R^2
                                      use Color 0 0 0 for line
                                      write "A" at ((0.0 :+ 1.0 * star2) / 2:R:C):R^2
                                      write "B" at (-(0.0 :+ 1.0 * star2) / 2:R:C):R^2
                                      let `power` = 1 in:
                                        block:
                                          set `λ` := 1
                                          let `tortoise` = p in:
                                            block:
                                              let `hare` = ((2 * p) mod q) in:
                                                block:
                                                  let `[internal] fresh #31` = 0 in:
                                                    let `[internal] fresh #32` = [internal] iteration limit in:
                                                      block:
                                                        if ((tortoise ≠ hare) and ([internal] fresh #31 < [internal] fresh #32)) then:
                                                          do-while ((tortoise ≠ hare) and ([internal] fresh #31 < [internal] fresh #32)):
                                                            block:
                                                              block:
                                                                if (power = λ) then:
                                                                  block:
                                                                    set `tortoise` := hare
                                                                    set `power` := (2 * power)
                                                                    set `λ` := 0
                                                                else:
                                                                  no-op
                                                                set `hare` := ((2 * hare) mod q)
                                                                set `λ` := (λ + 1)
                                                              set `[internal] fresh #31` := ([internal] fresh #31 + 1)
                                                        else:
                                                          no-op
                                                        set `[internal] iteration count` := [internal] fresh #31
                                                        set `[internal] stuck` := ([internal] fresh #31 = [internal] fresh #32)
                                                  set `tortoise` := p
                                                  set `hare` := p
                                                  let `[internal] fresh #31` = 0 in:
                                                    let `[internal] fresh #32` = λ in:
                                                      block:
                                                        if (True and ([internal] fresh #31 < [internal] fresh #32)) then:
                                                          do-while (True and ([internal] fresh #31 < [internal] fresh #32)):
                                                            block:
                                                              set `hare` := ((2 * hare) mod q)
                                                              set `[internal] fresh #31` := ([internal] fresh #31 + 1)
                                                        else:
                                                          no-op
                                                        set `[internal] iteration count` := [internal] fresh #31
                                                        set `[internal] stuck` := ([internal] fresh #31 = [internal] fresh #32)
                                                  set `μ` := 0
                                                  let `[internal] fresh #31` = 0 in:
                                                    let `[internal] fresh #32` = [internal] iteration limit in:
                                                      block:
                                                        if ((tortoise ≠ hare) and ([internal] fresh #31 < [internal] fresh #32)) then:
                                                          do-while ((tortoise ≠ hare) and ([internal] fresh #31 < [internal] fresh #32)):
                                                            block:
                                                              block:
                                                                set `tortoise` := ((2 * tortoise) mod q)
                                                                set `hare` := ((2 * hare) mod q)
                                                                set `μ` := (μ + 1)
                                                              set `[internal] fresh #31` := ([internal] fresh #31 + 1)
                                                        else:
                                                          no-op
                                                        set `[internal] iteration count` := [internal] fresh #31
                                                        set `[internal] stuck` := ([internal] fresh #31 = [internal] fresh #32)
                                                  let `delta` = (1:R / (λ + μ):R) in:
                                                    block:
                                                      let `ci` = 0:R in:
                                                        block:
                                                          let `t` = p in:
                                                            block:
                                                              set `iters` := []
                                                              let `S1` = 0 in:
                                                                block:
                                                                  let `S2` = 1 in:
                                                                    block:
                                                                      let `A` = 2 in:
                                                                        block:
                                                                          let `B` = 3 in:
                                                                            block:
                                                                              set `kneading_seq` := ""
                                                                              set `t` := p
                                                                              let `[internal] fresh #38` = 0 in:
                                                                                let `[internal] fresh #39` = μ in:
                                                                                  block:
                                                                                    if (True and ([internal] fresh #38 < [internal] fresh #39)) then:
                                                                                      do-while (True and ([internal] fresh #38 < [internal] fresh #39)):
                                                                                        block:
                                                                                          block:
                                                                                            let `omega` = (2.718281828459045:C ^ ((((2:R * 3.141592653589793):C * 0.0 :+ 1.0) * t:R:C) / q:R:C)) in:
                                                                                              block:
                                                                                                let `c` = let #wheel-arg = (ci mod 1.0) in blend((1st if (#wheel-arg < (1.0 / 2.0)) then if (#wheel-arg < (1.0 / 4.0)) then if (#wheel-arg < (1.0 / 8.0)) then ((8.0 * (#wheel-arg - 0.0)), (Color 255 100 0, Color 255 0 0)) else ((8.0 * (#wheel-arg - 0.125)), (Color 255 255 0, Color 255 100 0)) else if (#wheel-arg < (3.0 / 8.0)) then ((8.0 * (#wheel-arg - 0.25)), (Color 0 180 0, Color 255 255 0)) else ((8.0 * (#wheel-arg - 0.375)), (Color 0 128 128, Color 0 180 0)) else if (#wheel-arg < (3.0 / 4.0)) then if (#wheel-arg < (5.0 / 8.0)) then ((8.0 * (#wheel-arg - 0.5)), (Color 0 0 255, Color 0 128 128)) else ((8.0 * (#wheel-arg - 0.625)), (Color 128 0 128, Color 0 0 255)) else if (#wheel-arg < (7.0 / 8.0)) then ((8.0 * (#wheel-arg - 0.75)), (Color 255 0 160, Color 128 0 128)) else ((8.0 * (#wheel-arg - 0.875)), (Color 255 0 0, Color 255 0 160))), (1st (2nd if (#wheel-arg < (1.0 / 2.0)) then if (#wheel-arg < (1.0 / 4.0)) then if (#wheel-arg < (1.0 / 8.0)) then ((8.0 * (#wheel-arg - 0.0)), (Color 255 100 0, Color 255 0 0)) else ((8.0 * (#wheel-arg - 0.125)), (Color 255 255 0, Color 255 100 0)) else if (#wheel-arg < (3.0 / 8.0)) then ((8.0 * (#wheel-arg - 0.25)), (Color 0 180 0, Color 255 255 0)) else ((8.0 * (#wheel-arg - 0.375)), (Color 0 128 128, Color 0 180 0)) else if (#wheel-arg < (3.0 / 4.0)) then if (#wheel-arg < (5.0 / 8.0)) then ((8.0 * (#wheel-arg - 0.5)), (Color 0 0 255, Color 0 128 128)) else ((8.0 * (#wheel-arg - 0.625)), (Color 128 0 128, Color 0 0 255)) else if (#wheel-arg < (7.0 / 8.0)) then ((8.0 * (#wheel-arg - 0.75)), (Color 255 0 160, Color 128 0 128)) else ((8.0 * (#wheel-arg - 0.875)), (Color 255 0 0, Color 255 0 160)))), (2nd (2nd if (#wheel-arg < (1.0 / 2.0)) then if (#wheel-arg < (1.0 / 4.0)) then if (#wheel-arg < (1.0 / 8.0)) then ((8.0 * (#wheel-arg - 0.0)), (Color 255 100 0, Color 255 0 0)) else ((8.0 * (#wheel-arg - 0.125)), (Color 255 255 0, Color 255 100 0)) else if (#wheel-arg < (3.0 / 8.0)) then ((8.0 * (#wheel-arg - 0.25)), (Color 0 180 0, Color 255 255 0)) else ((8.0 * (#wheel-arg - 0.375)), (Color 0 128 128, Color 0 180 0)) else if (#wheel-arg < (3.0 / 4.0)) then if (#wheel-arg < (5.0 / 8.0)) then ((8.0 * (#wheel-arg - 0.5)), (Color 0 0 255, Color 0 128 128)) else ((8.0 * (#wheel-arg - 0.625)), (Color 128 0 128, Color 0 0 255)) else if (#wheel-arg < (7.0 / 8.0)) then ((8.0 * (#wheel-arg - 0.75)), (Color 255 0 160, Color 128 0 128)) else ((8.0 * (#wheel-arg - 0.875)), (Color 255 0 0, Color 255 0 160))))) in:
                                                                                                  block:
                                                                                                    set `ci` := (ci + delta)
                                                                                                    use blend(0.333, Color 0 0 0, c) for line
                                                                                                    use blend(0.333, Color 255 255 255, c) for line
                                                                                                    if (t = h1) then:
                                                                                                      block:
                                                                                                        set `iters` := join(iters, [S1])
                                                                                                        set `kneading_seq` := text(kneading_seq, "\9733\8321")
                                                                                                    else:
                                                                                                      if (t = h2) then:
                                                                                                        block:
                                                                                                          set `iters` := join(iters, [S2])
                                                                                                          set `kneading_seq` := text(kneading_seq, "\9733\8322")
                                                                                                      else:
                                                                                                        if (0:R < re(((0.0 :+ 1.0 * star2) * bar(omega)))) then:
                                                                                                          block:
                                                                                                            set `iters` := join(iters, [A])
                                                                                                            set `kneading_seq` := text(kneading_seq, "A")
                                                                                                        else:
                                                                                                          block:
                                                                                                            set `iters` := join(iters, [B])
                                                                                                            set `kneading_seq` := text(kneading_seq, "B")
                                                                                                    draw line from omega:R^2 to (10:R:C * omega):R^2
                                                                                                    draw filled circle at omega:R^2 with radius foot
                                                                                                    set `t` := ((2 * t) mod q)
                                                                                          set `[internal] fresh #38` := ([internal] fresh #38 + 1)
                                                                                    else:
                                                                                      no-op
                                                                                    set `[internal] iteration count` := [internal] fresh #38
                                                                                    set `[internal] stuck` := ([internal] fresh #38 = [internal] fresh #39)
                                                                              set `kneading_seq` := text(kneading_seq, "[")
                                                                              let `[internal] fresh #38` = 0 in:
                                                                                let `[internal] fresh #39` = λ in:
                                                                                  block:
                                                                                    if (True and ([internal] fresh #38 < [internal] fresh #39)) then:
                                                                                      do-while (True and ([internal] fresh #38 < [internal] fresh #39)):
                                                                                        block:
                                                                                          block:
                                                                                            let `omega` = (2.718281828459045:C ^ ((((2:R * 3.141592653589793):C * 0.0 :+ 1.0) * t:R:C) / q:R:C)) in:
                                                                                              block:
                                                                                                if (t = h1) then:
                                                                                                  block:
                                                                                                    set `iters` := join(iters, [S1])
                                                                                                    set `kneading_seq` := text(kneading_seq, "\9733\8321")
                                                                                                else:
                                                                                                  if (t = h2) then:
                                                                                                    block:
                                                                                                      set `iters` := join(iters, [S2])
                                                                                                      set `kneading_seq` := text(kneading_seq, "\9733\8322")
                                                                                                  else:
                                                                                                    if (0:R < re(((0.0 :+ 1.0 * star2) * bar(omega)))) then:
                                                                                                      block:
                                                                                                        set `iters` := join(iters, [A])
                                                                                                        set `kneading_seq` := text(kneading_seq, "A")
                                                                                                    else:
                                                                                                      block:
                                                                                                        set `iters` := join(iters, [B])
                                                                                                        set `kneading_seq` := text(kneading_seq, "B")
                                                                                                let `c` = let #wheel-arg = (ci mod 1.0) in blend((1st if (#wheel-arg < (1.0 / 2.0)) then if (#wheel-arg < (1.0 / 4.0)) then if (#wheel-arg < (1.0 / 8.0)) then ((8.0 * (#wheel-arg - 0.0)), (Color 255 100 0, Color 255 0 0)) else ((8.0 * (#wheel-arg - 0.125)), (Color 255 255 0, Color 255 100 0)) else if (#wheel-arg < (3.0 / 8.0)) then ((8.0 * (#wheel-arg - 0.25)), (Color 0 180 0, Color 255 255 0)) else ((8.0 * (#wheel-arg - 0.375)), (Color 0 128 128, Color 0 180 0)) else if (#wheel-arg < (3.0 / 4.0)) then if (#wheel-arg < (5.0 / 8.0)) then ((8.0 * (#wheel-arg - 0.5)), (Color 0 0 255, Color 0 128 128)) else ((8.0 * (#wheel-arg - 0.625)), (Color 128 0 128, Color 0 0 255)) else if (#wheel-arg < (7.0 / 8.0)) then ((8.0 * (#wheel-arg - 0.75)), (Color 255 0 160, Color 128 0 128)) else ((8.0 * (#wheel-arg - 0.875)), (Color 255 0 0, Color 255 0 160))), (1st (2nd if (#wheel-arg < (1.0 / 2.0)) then if (#wheel-arg < (1.0 / 4.0)) then if (#wheel-arg < (1.0 / 8.0)) then ((8.0 * (#wheel-arg - 0.0)), (Color 255 100 0, Color 255 0 0)) else ((8.0 * (#wheel-arg - 0.125)), (Color 255 255 0, Color 255 100 0)) else if (#wheel-arg < (3.0 / 8.0)) then ((8.0 * (#wheel-arg - 0.25)), (Color 0 180 0, Color 255 255 0)) else ((8.0 * (#wheel-arg - 0.375)), (Color 0 128 128, Color 0 180 0)) else if (#wheel-arg < (3.0 / 4.0)) then if (#wheel-arg < (5.0 / 8.0)) then ((8.0 * (#wheel-arg - 0.5)), (Color 0 0 255, Color 0 128 128)) else ((8.0 * (#wheel-arg - 0.625)), (Color 128 0 128, Color 0 0 255)) else if (#wheel-arg < (7.0 / 8.0)) then ((8.0 * (#wheel-arg - 0.75)), (Color 255 0 160, Color 128 0 128)) else ((8.0 * (#wheel-arg - 0.875)), (Color 255 0 0, Color 255 0 160)))), (2nd (2nd if (#wheel-arg < (1.0 / 2.0)) then if (#wheel-arg < (1.0 / 4.0)) then if (#wheel-arg < (1.0 / 8.0)) then ((8.0 * (#wheel-arg - 0.0)), (Color 255 100 0, Color 255 0 0)) else ((8.0 * (#wheel-arg - 0.125)), (Color 255 255 0, Color 255 100 0)) else if (#wheel-arg < (3.0 / 8.0)) then ((8.0 * (#wheel-arg - 0.25)), (Color 0 180 0, Color 255 255 0)) else ((8.0 * (#wheel-arg - 0.375)), (Color 0 128 128, Color 0 180 0)) else if (#wheel-arg < (3.0 / 4.0)) then if (#wheel-arg < (5.0 / 8.0)) then ((8.0 * (#wheel-arg - 0.5)), (Color 0 0 255, Color 0 128 128)) else ((8.0 * (#wheel-arg - 0.625)), (Color 128 0 128, Color 0 0 255)) else if (#wheel-arg < (7.0 / 8.0)) then ((8.0 * (#wheel-arg - 0.75)), (Color 255 0 160, Color 128 0 128)) else ((8.0 * (#wheel-arg - 0.875)), (Color 255 0 0, Color 255 0 160))))) in:
                                                                                                  block:
                                                                                                    set `ci` := (ci + delta)
                                                                                                    use blend(0.333, Color 0 0 0, c) for line
                                                                                                    use blend(0.333, Color 255 255 255, c) for line
                                                                                                    draw line from omega:R^2 to (10:R:C * omega):R^2
                                                                                                    draw filled circle at omega:R^2 with radius foot
                                                                                                    set `t` := ((2 * t) mod q)
                                                                                          set `[internal] fresh #38` := ([internal] fresh #38 + 1)
                                                                                    else:
                                                                                      no-op
                                                                                    set `[internal] iteration count` := [internal] fresh #38
                                                                                    set `[internal] stuck` := ([internal] fresh #38 = [internal] fresh #39)
                                                                              set `kneading_seq` := text(kneading_seq, "]")
                                                                              set `spider` := []
                                                                              set `spider_ready` := False
                                                                              set `p` := savedP
                                                                              set `q` := savedQ


=== viewer 1: Iterated spider
--- body
let `[internal] vanishing radius` = vanishing_radius in:
  let `[internal] escape radius` = escape_radius in:
    let `[internal] iteration limit` = max_iters in:
      let `[internal] stuck` = False in:
        let `[internal] iteration count` = 0 in:
          let `z` = ([internal] x:C + (0.0 :+ 1.0 * [internal] y:C)) in:
            let `pixel_size` = [internal] dx in:
              block:
                set `color` := Color 255 255 255


--- tool Reset spider
  -- on button Apply spider map
let `[internal] vanishing radius` = vanishing_radius in:
  let `[internal] escape radius` = escape_radius in:
    let `[internal] iteration limit` = max_iters in:
      let `[internal] stuck` = False in:
        let `[internal] iteration count` = 0 in:
          let `pixel_size` = [internal] px in:
            block:
              erase
              let `new_spider` = [] in:
                block:
                  let `z_2` = ((spider@2)@1) in:
                    block:
                      let `j` = 1 in:
                        block:
                          let `[internal] fresh #25` = 0 in:
                            let `[internal] fresh #26` = (μ + λ) in:
                              block:
                                if (True and ([internal] fresh #25 < [internal] fresh #26)) then:
                                  do-while (True and ([internal] fresh #25 < [internal] fresh #26)):
                                    block:
                                      block:
                                        let `gamma_jp1` = (spider@@(j + 1)) in:
                                          block:
                                            let `z_jp1` = (gamma_jp1@1) in:
                                              block:
                                                let `w` = (-2:R:C + (2:R:C * sqrt((z_jp1 / z_2)))) in:
                                                  block:
                                                    let `integral` = 0:R:C in:
                                                      block:
                                                        let `last_zeta` = 0:R:C in:
                                                          block:
                                                            let `first` = True in:
                                                              block:
                                                                {TODO: ForEach}
                                                                let `zero_winding` = if encloses_zero then 1 else -1 in:
                                                                  block:
                                                                    let `sqrt_sign` = if (0:R < im(integral)) then 1 else -1 in:
                                                                      block:
                                                                        if (j = 1) then:
                                                                          block:
                                                                            use Color 0 0 0 for line
                                                                            write text("w: ", w:Text) at 1:R:C:R^2
                                                                            write text("zero_winding: ", zero_winding:Text) at (1:R:C - (0.3:C * 0.0 :+ 1.0)):R^2
                                                                            write text("sqrt_sign: ", sqrt_sign:Text) at (1:R:C - (0.6:C * 0.0 :+ 1.0)):R^2
                                                                        else:
                                                                          no-op
                                                                        let `S1` = 0 in:
                                                                          block:
                                                                            let `S2` = 1 in:
                                                                              block:
                                                                                let `A` = 2 in:
                                                                                  block:
                                                                                    let `B` = 3 in:
                                                                                      block:
                                                                                        let `symbol` = (iters@j) in:
                                                                                          block:
                                                                                            let `last_pre` = 0:R:C in:
                                                                                              block:
                                                                                                if (symbol = A) then:
                                                                                                  block:
                                                                                                    set `last_pre` := (-2:R:C + (((2 * sqrt_sign) * zero_winding):R:C * sqrt((z_jp1 / z_2))))
                                                                                                else:
                                                                                                  if (symbol = B) then:
                                                                                                    block:
                                                                                                      set `last_pre` := (-2:R:C - (((2 * sqrt_sign) * zero_winding):R:C * sqrt((z_jp1 / z_2))))
                                                                                                  else:
                                                                                                    no-op
                                                                                                if (j = 1) then:
                                                                                                  block:
                                                                                                    write text("last_pre: ", last_pre:Text) at (1:R:C - (0.9:C * 0.0 :+ 1.0)):R^2
                                                                                                else:
                                                                                                  no-op
                                                                                                let `scale` = sqrt(10:R) in:
                                                                                                  block:
                                                                                                    let `new_leg` = [(scale:C * last_pre)] in:
                                                                                                      block:
                                                                                                        set `first` := True
                                                                                                        {TODO: ForEach}
                                                                                                        if (|last_pre| < 10:R) then:
                                                                                                          block:
                                                                                                            set `new_leg` := join(new_leg, [(((scale * 10:R):C * last_pre) / |last_pre|:C)])
                                                                                                        else:
                                                                                                          no-op
                                                                                                        set `new_spider` := join(new_spider, [new_leg])
                                                                                                        set `j` := (j + 1)
                                      set `[internal] fresh #25` := ([internal] fresh #25 + 1)
                                else:
                                  no-op
                                set `[internal] iteration count` := [internal] fresh #25
                                set `[internal] stuck` := ([internal] fresh #25 = [internal] fresh #26)
                          set `spider` := new_spider
                          let `delta` = (1:R / (λ + μ):R) in:
                            block:
                              let `ci` = 0:R in:
                                block:
                                  {TODO: ForEach}
                                  let `leg1` = (spider@1) in:
                                    block:
                                      let `last_gamma` = (leg1@2) in:
                                        block:
                                          use blend(0.333, Color 255 255 255, Color 128 128 128) for line
                                          let `z2` = ((spider@2)@1) in:
                                            block:
                                              set `contour` := [-2:R:C]
                                              let `last_pre` = (-2:R:C + (2:R:C * sqrt((last_gamma / z2)))) in:
                                                block:
                                                  let `first` = True in:
                                                    block:
                                                      {TODO: ForEach}
                                                      set `last_pre` := (-2:R:C - (2:R:C * sqrt((last_gamma / z2))))
                                                      let `t` = 0:R in:
                                                        block:
                                                          set `first` := True
                                                          {TODO: ForEach}
                                                          let `first_pt` = (contour@1) in:
                                                            block:
                                                              let `last_pt` = (contour@-1) in:
                                                                block:
                                                                  set `contour` := join(contour, [(10:R:C + (0.0 :+ 1.0 * im(last_pt):C)); (10:R:C + (0.0 :+ 1.0 * im(first_pt):C)); first_pt])
                                                                  use blend(0.333, Color 255 255 255, Color 128 128 128) for line
                                                                  set `t` := 0:R
                                                                  set `first` := True
                                                                  {TODO: ForEach}
                                                                  let `lastPt` = 0:R:C in:
                                                                    block:
                                                                      set `first` := True
                                                                      let `integral` = 0:R:C in:
                                                                        block:
                                                                          {TODO: ForEach}
                                                                          set `encloses_zero` := (0:R < im(integral))
                                                                          use blend(0.333, Color 255 255 255, Color 128 128 128) for line
                                                                          draw point at -2:R:C:R^2
                                                                          write "-2" at -2.2:C:R^2
                                                                          write "\947" at (first_pt - (0.15:C * 0.0 :+ 1.0)):R^2

  -- on refresh
let `[internal] vanishing radius` = vanishing_radius in:
  let `[internal] escape radius` = escape_radius in:
    let `[internal] iteration limit` = max_iters in:
      let `[internal] stuck` = False in:
        let `[internal] iteration count` = 0 in:
          let `pixel_size` = [internal] px in:
            block:
              if !spider_ready then:
                block:
                  erase
              else:
                no-op

  -- on activated
let `[internal] vanishing radius` = vanishing_radius in:
  let `[internal] escape radius` = escape_radius in:
    let `[internal] iteration limit` = max_iters in:
      let `[internal] stuck` = False in:
        let `[internal] iteration count` = 0 in:
          let `pixel_size` = [internal] px in:
            block:
              erase
              set `spider` := []
              set `next_leg` := 0
              let `R` = 10:R in:
                block:
                  let `b` = -(2.718281828459045:C ^ ((((2:R * 3.141592653589793):C * 0.0 :+ 1.0) * p:R:C) / q:R:C)) in:
                    block:
                      let `omega` = (2.718281828459045:C ^ ((((2:R * 3.141592653589793):C * 0.0 :+ 1.0) * p:R:C) / q:R:C)) in:
                        block:
                          let `delta` = (1:R / (λ + μ):R) in:
                            block:
                              let `ci` = 0:R in:
                                block:
                                  let `leg` = [] in:
                                    block:
                                      let `[internal] fresh #28` = 0 in:
