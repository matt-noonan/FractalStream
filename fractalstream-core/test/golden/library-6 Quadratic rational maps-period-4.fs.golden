--- tool Trace orbit
  -- on click
let `[internal] vanishing radius` = vanishing_radius in:
  let `[internal] escape radius` = escape_radius in:
    let `[internal] iteration limit` = iters in:
      let `[internal] stuck` = False in:
        let `[internal] iteration count` = 0 in:
          let `w` = ([internal] x:C + (0.0 :+ 1.0 * [internal] y:C)) in:
            let `pixel_size` = [internal] px in:
              block:
                erase
                use Color 255 255 0 for line
                let `prev` = w in:
                  block:
                    let `[internal] fresh #19` = 0 in:
                      let `[internal] fresh #20` = 200 in:
                        block:
                          do-while (!([internal] escape radius < |w|) and ([internal] fresh #19 < [internal] fresh #20)):
                            block:
                              block:
                                draw point at w:R^2
                                set `prev` := w
                                set `w` := let [internal] f.z #0 = w in ((([internal] f.z #0 - c) * ((([internal] f.z #0 * (c - 1:R:C)) - (2:R:C * c)) + 1:R:C)) / (([internal] f.z #0 ^ 2:R:C) * (c - 1:R:C)))
                                draw line from prev:R^2 to w:R^2
                              set `[internal] fresh #19` := ([internal] fresh #19 + 1)
                          set `[internal] iteration count` := [internal] fresh #19
                          set `[internal] stuck` := ([internal] fresh #19 = [internal] fresh #20)

  -- on deactivated
let `[internal] vanishing radius` = vanishing_radius in:
  let `[internal] escape radius` = escape_radius in:
    let `[internal] iteration limit` = iters in:
      let `[internal] stuck` = False in:
        let `[internal] iteration count` = 0 in:
          let `pixel_size` = [internal] px in:
            block:
              erase


