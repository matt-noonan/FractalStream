--- tool Trace
  -- on click
let `[internal] vanishing radius` = vanishing_radius in:
  let `[internal] escape radius` = escape_radius in:
    let `[internal] iteration limit` = max_iters in:
      let `[internal] stuck` = False in:
        let `[internal] iteration count` = 0 in:
          let `z` = ([internal] x:C + (0.0 :+ 1.0 * [internal] y:C)) in:
            let `pixel_size` = [internal] px in:
              block:
                let `prevZ` = z in:
                  block:
                    erase
                    let `[internal] fresh #36` = 0 in:
                      let `[internal] fresh #37` = 100 in:
                        block:
                          if (!([internal] escape radius < |z|) and ([internal] fresh #36 < [internal] fresh #37)) then:
                            do-while (!([internal] escape radius < |z|) and ([internal] fresh #36 < [internal] fresh #37)):
                              block:
                                block:
                                  set `prevZ` := z
                                  draw point at z:R^2
                                  block:
                                    block:
                                      set `z` := let [internal] f.z #0 = z in (([internal] f.z #0 ^ 2:R:C) + C)
                                      let `d` = |(z - twist_center)| in:
                                        block:
                                          if ((r0 < d) and (d < r1)) then:
                                            block:
                                              let `theta` = (((2:R * 3.141592653589793) * (d - r0)) / (r1 - r0)) in:
                                                block:
                                                  set `z` := (((2.718281828459045:C ^ (0.0 :+ 1.0 * theta:C)) * (z - twist_center)) + twist_center)
                                          else:
                                            no-op
                                  draw line from z:R^2 to prevZ:R^2
                                set `[internal] fresh #36` := ([internal] fresh #36 + 1)
                          else:
                            no-op
                          set `[internal] iteration count` := [internal] fresh #36
                          set `[internal] stuck` := ([internal] fresh #36 = [internal] fresh #37)

  -- on drag
let `[internal] vanishing radius` = vanishing_radius in:
  let `[internal] escape radius` = escape_radius in:
    let `[internal] iteration limit` = max_iters in:
      let `[internal] stuck` = False in:
        let `[internal] iteration count` = 0 in:
          let `z` = ([internal] x:C + (0.0 :+ 1.0 * [internal] y:C)) in:
            let `[unused] start` = ([internal] oldx:C + (0.0 :+ 1.0 * [internal] oldy:C)) in:
              let `pixel_size` = [internal] px in:
                block:
                  let `prevZ` = z in:
                    block:
                      erase
                      let `[internal] fresh #39` = 0 in:
                        let `[internal] fresh #40` = 100 in:
                          block:
                            if (!([internal] escape radius < |z|) and ([internal] fresh #39 < [internal] fresh #40)) then:
                              do-while (!([internal] escape radius < |z|) and ([internal] fresh #39 < [internal] fresh #40)):
                                block:
                                  block:
                                    set `prevZ` := z
                                    draw point at z:R^2
                                    block:
                                      block:
                                        set `z` := let [internal] f.z #0 = z in (([internal] f.z #0 ^ 2:R:C) + C)
                                        let `d` = |(z - twist_center)| in:
                                          block:
                                            if ((r0 < d) and (d < r1)) then:
                                              block:
                                                let `theta` = (((2:R * 3.141592653589793) * (d - r0)) / (r1 - r0)) in:
                                                  block:
                                                    set `z` := (((2.718281828459045:C ^ (0.0 :+ 1.0 * theta:C)) * (z - twist_center)) + twist_center)
                                            else:
                                              no-op
                                    draw line from z:R^2 to prevZ:R^2
                                  set `[internal] fresh #39` := ([internal] fresh #39 + 1)
                            else:
                              no-op
                            set `[internal] iteration count` := [internal] fresh #39
                            set `[internal] stuck` := ([internal] fresh #39 = [internal] fresh #40)

  -- on deactivated
let `[internal] vanishing radius` = vanishing_radius in:
  let `[internal] escape radius` = escape_radius in:
    let `[internal] iteration limit` = max_iters in:
      let `[internal] stuck` = False in:
        let `[internal] iteration count` = 0 in:
          let `pixel_size` = [internal] px in:
            block:
              erase


--- tool Dehn twist
  -- on drag
let `[internal] vanishing radius` = vanishing_radius in:
  let `[internal] escape radius` = escape_radius in:
    let `[internal] iteration limit` = max_iters in:
      let `[internal] stuck` = False in:
        let `[internal] iteration count` = 0 in:
          let `z` = ([internal] x:C + (0.0 :+ 1.0 * [internal] y:C)) in:
            let `z0` = ([internal] oldx:C + (0.0 :+ 1.0 * [internal] oldy:C)) in:
              let `pixel_size` = [internal] px in:
                block:
                  let `eps` = (5:R * pixel_size) in:
                    block:
                      if (drag_target = 0) then:
                        block:
                          if (|(z0 - twist_center)| < eps) then:
                            block:
                              set `drag_target` := 1
                          else:
                            if (|(|(z0 - twist_center)| - r0)| < eps) then:
                              block:
                                set `drag_target` := 2
                            else:
                              if (|(|(z0 - twist_center)| - r1)| < eps) then:
                                block:
                                  set `drag_target` := 3
                              else:
                                no-op
                      else:
                        no-op
                      if (drag_target = 1) then:
                        block:
                          set `twist_center` := z
                      else:
                        no-op
                      if (drag_target = 2) then:
                        block:
                          set `r0` := |(z - twist_center)|
                      else:
                        no-op
                      if (drag_target = 3) then:
                        block:
                          set `r1` := |(z - twist_center)|
                      else:
                        no-op
                      if (0 < drag_target) then:
                        block:
                          erase
                          block:
                            block:
                              use Color 255 0 0 for line
                              draw point at twist_center:R^2
                              use Color 255 255 255 for line
                              draw circle at twist_center:R^2 with radius r0
                              draw circle at twist_center:R^2 with radius r1
                      else:
                        no-op

  -- on drag-done
let `[internal] vanishing radius` = vanishing_radius in:
  let `[internal] escape radius` = escape_radius in:
    let `[internal] iteration limit` = max_iters in:
      let `[internal] stuck` = False in:
        let `[internal] iteration count` = 0 in:
          let `z` = ([internal] x:C + (0.0 :+ 1.0 * [internal] y:C)) in:
            let `[unused] start` = ([internal] oldx:C + (0.0 :+ 1.0 * [internal] oldy:C)) in:
              let `pixel_size` = [internal] px in:
                block:
                  set `drag_target` := 0

  -- on activated
let `[internal] vanishing radius` = vanishing_radius in:
  let `[internal] escape radius` = escape_radius in:
    let `[internal] iteration limit` = max_iters in:
      let `[internal] stuck` = False in:
        let `[internal] iteration count` = 0 in:
          let `pixel_size` = [internal] px in:
            block:
              block:
                block:
                  use Color 255 0 0 for line
                  draw point at twist_center:R^2
                  use Color 255 255 255 for line
                  draw circle at twist_center:R^2 with radius r0
                  draw circle at twist_center:R^2 with radius r1

  -- on deactivated
let `[internal] vanishing radius` = vanishing_radius in:
  let `[internal] escape radius` = escape_radius in:
    let `[internal] iteration limit` = max_iters in:
      let `[internal] stuck` = False in:
        let `[internal] iteration count` = 0 in:
          let `pixel_size` = [internal] px in:
            block:
              erase


