            let `[unused] start` = ([internal] oldx:C + (0.0 :+ 1.0 * [internal] oldy:C)) in:
              let `pixel_size` = [internal] px in:
                block:
                  let `prevZ` = z in:
                    block:
                      erase
                      let `[internal] fresh #20` = 0 in:
                        let `[internal] fresh #21` = [internal] iteration limit in:
                          block:
                            if (!(|z| < [internal] vanishing radius) and ([internal] fresh #20 < [internal] fresh #21)) then:
                              do-while (!(|z| < [internal] vanishing radius) and ([internal] fresh #20 < [internal] fresh #21)):
                                block:
                                  block:
                                    set `prevZ` := z
                                    draw point at z:R^2
                                    set `z` := (((z / 2:R:C) * (cos(((3.141592653589793:C * z) / 2:R:C)) ^ 2:R:C)) + (((3:R:C * z) + 1:R:C) * (sin(((3.141592653589793:C * z) / 2:R:C)) ^ 2:R:C)))
                                    draw line from z:R^2 to prevZ:R^2
                                  set `[internal] fresh #20` := ([internal] fresh #20 + 1)
                            else:
