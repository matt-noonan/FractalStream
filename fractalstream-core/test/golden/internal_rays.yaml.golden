--- tool Trace
  -- on click
let `[internal] vanishing radius` = minRadius in:
  let `[internal] escape radius` = maxRadius in:
    let `[internal] iteration limit` = maxIters in:
      let `[internal] stuck` = False in:
        let `[internal] iteration count` = 0 in:
          let `z` = ([internal] x:C + (0.0 :+ 1.0 * [internal] y:C)) in:
            let `pixel_size` = [internal] px in:
              block:
                set `start` := z
                block:
                  let `[internal] trace.initial_last #0` = z in:
                    block:
                      block:
                        let `w` = z in:
                          block:
                            let `lastZ` = [internal] trace.initial_last #0 in:
                              block:
                                erase
                                let `[internal] fresh #24` = 0 in:
                                  let `[internal] fresh #25` = [internal] iteration limit in:
                                    block:
                                      do-while (!((||(z - w)|| < [internal] vanishing radius) or ([internal] escape radius < |z|)) and ([internal] fresh #24 < [internal] fresh #25)):
                                        block:
                                          block:
                                            set `z` := let [internal] f.z #0 = z in (([internal] f.z #0 ^ 2:R:C) + c)
                                            set `w` := let [internal] f2.w #0 = w in (((([internal] f2.w #0 ^ 2:R:C) + c) ^ 2:R:C) + c)
                                          set `[internal] fresh #24` := ([internal] fresh #24 + 1)
                                      set `[internal] iteration count` := [internal] fresh #24
                                      set `[internal] stuck` := ([internal] fresh #24 = [internal] fresh #25)
                                if (||(z - w)|| < [internal] vanishing radius) then:
                                  block:
                                    set `z` := lastZ
                                    let `[internal] fresh #24` = 0 in:
                                      let `[internal] fresh #25` = [internal] iteration limit in:
                                        block:
                                          if (!(||(z - w)|| < [internal] vanishing radius) and ([internal] fresh #24 < [internal] fresh #25)) then:
                                            do-while (!(||(z - w)|| < [internal] vanishing radius) and ([internal] fresh #24 < [internal] fresh #25)):
                                              block:
                                                block:
                                                  set `lastZ` := z
                                                  set `z` := let [internal] f.z #0 = z in (([internal] f.z #0 ^ 2:R:C) + c)
                                                  draw point at lastZ:R^2
                                                  draw line from lastZ:R^2 to z:R^2
                                                set `[internal] fresh #24` := ([internal] fresh #24 + 1)
                                          else:
                                            no-op
                                          set `[internal] iteration count` := [internal] fresh #24
                                          set `[internal] stuck` := ([internal] fresh #24 = [internal] fresh #25)
                                else:
                                  no-op
                                use Color 0 180 0 for line
                                draw circle at w:R^2 with radius minRadius

  -- on drag
let `[internal] vanishing radius` = minRadius in:
  let `[internal] escape radius` = maxRadius in:
    let `[internal] iteration limit` = maxIters in:
      let `[internal] stuck` = False in:
        let `[internal] iteration count` = 0 in:
          let `z` = ([internal] x:C + (0.0 :+ 1.0 * [internal] y:C)) in:
            let `[unused] start` = ([internal] oldx:C + (0.0 :+ 1.0 * [internal] oldy:C)) in:
              let `pixel_size` = [internal] px in:
                block:
                  set `start` := z
                  block:
                    let `[internal] trace.initial_last #0` = z in:
                      block:
                        block:
                          let `w` = z in:
                            block:
                              let `lastZ` = [internal] trace.initial_last #0 in:
                                block:
                                  erase
                                  let `[internal] fresh #27` = 0 in:
                                    let `[internal] fresh #28` = [internal] iteration limit in:
                                      block:
                                        do-while (!((||(z - w)|| < [internal] vanishing radius) or ([internal] escape radius < |z|)) and ([internal] fresh #27 < [internal] fresh #28)):
                                          block:
                                            block:
                                              set `z` := let [internal] f.z #0 = z in (([internal] f.z #0 ^ 2:R:C) + c)
                                              set `w` := let [internal] f2.w #0 = w in (((([internal] f2.w #0 ^ 2:R:C) + c) ^ 2:R:C) + c)
                                            set `[internal] fresh #27` := ([internal] fresh #27 + 1)
                                        set `[internal] iteration count` := [internal] fresh #27
                                        set `[internal] stuck` := ([internal] fresh #27 = [internal] fresh #28)
                                  if (||(z - w)|| < [internal] vanishing radius) then:
                                    block:
                                      set `z` := lastZ
                                      let `[internal] fresh #27` = 0 in:
                                        let `[internal] fresh #28` = [internal] iteration limit in:
                                          block:
                                            if (!(||(z - w)|| < [internal] vanishing radius) and ([internal] fresh #27 < [internal] fresh #28)) then:
                                              do-while (!(||(z - w)|| < [internal] vanishing radius) and ([internal] fresh #27 < [internal] fresh #28)):
                                                block:
                                                  block:
                                                    set `lastZ` := z
                                                    set `z` := let [internal] f.z #0 = z in (([internal] f.z #0 ^ 2:R:C) + c)
                                                    draw point at lastZ:R^2
                                                    draw line from lastZ:R^2 to z:R^2
                                                  set `[internal] fresh #27` := ([internal] fresh #27 + 1)
                                            else:
                                              no-op
                                            set `[internal] iteration count` := [internal] fresh #27
                                            set `[internal] stuck` := ([internal] fresh #27 = [internal] fresh #28)
                                  else:
                                    no-op
                                  use Color 0 180 0 for line
                                  draw circle at w:R^2 with radius minRadius

  -- on refresh
let `[internal] vanishing radius` = minRadius in:
  let `[internal] escape radius` = maxRadius in:
    let `[internal] iteration limit` = maxIters in:
      let `[internal] stuck` = False in:
        let `[internal] iteration count` = 0 in:
          let `pixel_size` = [internal] px in:
            block:
              let `z` = start in:
                block:
                  block:
                    let `[internal] trace.initial_last #0` = 0 in:
                      block:
                        block:
                          let `w` = z in:
                            block:
                              let `lastZ` = [internal] trace.initial_last #0:R:C in:
                                block:
                                  erase
                                  let `[internal] fresh #22` = 0 in:
                                    let `[internal] fresh #23` = [internal] iteration limit in:
                                      block:
                                        do-while (!((||(z - w)|| < [internal] vanishing radius) or ([internal] escape radius < |z|)) and ([internal] fresh #22 < [internal] fresh #23)):
                                          block:
                                            block:
                                              set `z` := let [internal] f.z #0 = z in (([internal] f.z #0 ^ 2:R:C) + c)
                                              set `w` := let [internal] f2.w #0 = w in (((([internal] f2.w #0 ^ 2:R:C) + c) ^ 2:R:C) + c)
                                            set `[internal] fresh #22` := ([internal] fresh #22 + 1)
                                        set `[internal] iteration count` := [internal] fresh #22
                                        set `[internal] stuck` := ([internal] fresh #22 = [internal] fresh #23)
                                  if (||(z - w)|| < [internal] vanishing radius) then:
                                    block:
                                      set `z` := lastZ
                                      let `[internal] fresh #22` = 0 in:
                                        let `[internal] fresh #23` = [internal] iteration limit in:
                                          block:
                                            if (!(||(z - w)|| < [internal] vanishing radius) and ([internal] fresh #22 < [internal] fresh #23)) then:
                                              do-while (!(||(z - w)|| < [internal] vanishing radius) and ([internal] fresh #22 < [internal] fresh #23)):
                                                block:
                                                  block:
                                                    set `lastZ` := z
                                                    set `z` := let [internal] f.z #0 = z in (([internal] f.z #0 ^ 2:R:C) + c)
                                                    draw point at lastZ:R^2
                                                    draw line from lastZ:R^2 to z:R^2
                                                  set `[internal] fresh #22` := ([internal] fresh #22 + 1)
                                            else:
                                              no-op
                                            set `[internal] iteration count` := [internal] fresh #22
                                            set `[internal] stuck` := ([internal] fresh #22 = [internal] fresh #23)
                                  else:
                                    no-op
                                  use Color 0 180 0 for line
                                  draw circle at w:R^2 with radius minRadius


