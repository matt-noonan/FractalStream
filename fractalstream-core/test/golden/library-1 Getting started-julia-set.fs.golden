=== viewer 0: Julia set
--- body
let `[internal] vanishing radius` = vanishing_radius in:
  let `[internal] escape radius` = escape_radius in:
    let `[internal] iteration limit` = max_iters in:
      let `[internal] stuck` = False in:
        let `[internal] iteration count` = 0 in:
          let `z` = ([internal] x:C + (0.0 :+ 1.0 * [internal] y:C)) in:
            let `pixel_size` = [internal] dx in:
              block:
                let `[internal] fresh #23` = 0 in:
                  let `[internal] fresh #24` = [internal] iteration limit in:
                    block:
                      if (!([internal] escape radius < |z|) and ([internal] fresh #23 < [internal] fresh #24)) then:
                        do-while (!([internal] escape radius < |z|) and ([internal] fresh #23 < [internal] fresh #24)):
                          block:
                            set `z` := let [internal] f.z #0 = z in (([internal] f.z #0 ^ 2:R:C) + C)
                            set `[internal] fresh #23` := ([internal] fresh #23 + 1)
                      else:
                        no-op
                      set `[internal] iteration count` := [internal] fresh #23
                      set `[internal] stuck` := ([internal] fresh #23 = [internal] fresh #24)
                block:
                  block:
                    if [internal] stuck then:
                      block:
                        set `color` := [colorizer] Julia set: gives_up
                    else:
                      block:
                        set `color` := blend((([internal] iteration count:R / max_iters:R) ^ [colorizer] Julia set: brightness), [colorizer] Julia set: far, [colorizer] Julia set: near)


--- tool Trace
  -- on click
let `[internal] vanishing radius` = vanishing_radius in:
  let `[internal] escape radius` = escape_radius in:
    let `[internal] iteration limit` = max_iters in:
      let `[internal] stuck` = False in:
        let `[internal] iteration count` = 0 in:
          let `[internal] click` = [internal] point a in:
            let `pixel_size` = [internal] px in:
              block:
                let `z` = [internal] click in:
                  block:
                    erase
                    block:
                      let `[internal] previous.z #0` = z in:
                        block:
                          let `[internal] fresh #21` = 0 in:
                            let `[internal] fresh #22` = [internal] iteration limit in:
                              block:
                                if (!([internal] escape radius < |z|) and ([internal] fresh #21 < [internal] fresh #22)) then:
                                  do-while (!([internal] escape radius < |z|) and ([internal] fresh #21 < [internal] fresh #22)):
                                    block:
                                      block:
                                        set `[internal] previous.z #0` := z
                                        block:
                                          draw point at (z, 1.0 :+ 0.0)
                                          set `z` := let [internal] f.z #0 = z in (([internal] f.z #0 ^ 2:R:C) + C)
                                          draw line from (z, 1.0 :+ 0.0) to ([internal] previous.z #0, 1.0 :+ 0.0)
                                      set `[internal] fresh #21` := ([internal] fresh #21 + 1)
                                else:
                                  no-op
                                set `[internal] iteration count` := [internal] fresh #21
                                set `[internal] stuck` := ([internal] fresh #21 = [internal] fresh #22)

  -- on drag
let `[internal] vanishing radius` = vanishing_radius in:
  let `[internal] escape radius` = escape_radius in:
    let `[internal] iteration limit` = max_iters in:
      let `[internal] stuck` = False in:
        let `[internal] iteration count` = 0 in:
          let `[internal] click` = [internal] point a in:
            let `[unused] drag start` = [internal] old point a in:
              let `pixel_size` = [internal] px in:
                block:
                  let `z` = [internal] click in:
                    block:
                      erase
                      block:
                        let `[internal] previous.z #0` = z in:
                          block:
                            let `[internal] fresh #24` = 0 in:
                              let `[internal] fresh #25` = [internal] iteration limit in:
                                block:
                                  if (!([internal] escape radius < |z|) and ([internal] fresh #24 < [internal] fresh #25)) then:
                                    do-while (!([internal] escape radius < |z|) and ([internal] fresh #24 < [internal] fresh #25)):
                                      block:
                                        block:
                                          set `[internal] previous.z #0` := z
                                          block:
                                            draw point at (z, 1.0 :+ 0.0)
                                            set `z` := let [internal] f.z #0 = z in (([internal] f.z #0 ^ 2:R:C) + C)
                                            draw line from (z, 1.0 :+ 0.0) to ([internal] previous.z #0, 1.0 :+ 0.0)
                                        set `[internal] fresh #24` := ([internal] fresh #24 + 1)
                                  else:
                                    no-op
                                  set `[internal] iteration count` := [internal] fresh #24
                                  set `[internal] stuck` := ([internal] fresh #24 = [internal] fresh #25)


