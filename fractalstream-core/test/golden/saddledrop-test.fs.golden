                                              let `[internal] fresh #30` = [internal] iteration limit in:
                                                block:
                                                  do-while (!([internal] escape radius < |x|) and ([internal] fresh #29 < [internal] fresh #30)):
                                                    block:
                                                      block:
                                                        let `t` = x in:
                                                          block:
                                                            set `x` := (((x ^ 2:R:C) + c) - (a * y))
                                                            set `y` := t
