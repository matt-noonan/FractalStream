=== viewer 2: Hénon dynamics
--- body
let `[internal] vanishing radius` = vanishing_radius in:
  let `[internal] escape radius` = escape_radius in:
    let `[internal] iteration limit` = max_iters in:
      let `[internal] stuck` = False in:
        let `[internal] iteration count` = 0 in:
          let `z` = ([internal] x:C + (0.0 :+ 1.0 * [internal] y:C)) in:
            let `pixel_size` = [internal] dx in:
              block:
                block:
                  let `[internal] draw_henon.start #0` = z in:
                    block:
                      let `[internal] draw_henon.use_rainbow #0` = True in:
                        block:
                          block:
                            let `aa` = ((a + 1:R:C) / 2:R:C) in:
                              block:
                                let `p` = (sqrt(((aa ^ 2:R:C) - c)) + aa) in:
                                  block:
                                    let `lambda` = (sqrt(((p ^ 2:R:C) - a)) + p) in:
                                      block:
                                        let `save` = ([internal] draw_henon.start #0 * zoom:C) in:
                                          block:
                                            let `x` = (p + (lambda * save)) in:
                                              block:
                                                let `y` = (p + save) in:
                                                  block:
                                                    let `[internal] fresh #26` = 0 in:
                                                      let `[internal] fresh #27` = [internal] iteration limit in:
                                                        block:
                                                          do-while (!([internal] escape radius < |x|) and ([internal] fresh #26 < [internal] fresh #27)):
                                                            block:
                                                              block:
                                                                let `t` = x in:
                                                                  block:
                                                                    set `x` := (((x ^ 2:R:C) + c) - (a * y))
                                                                    set `y` := t
                                                              set `[internal] fresh #26` := ([internal] fresh #26 + 1)
                                                          set `[internal] iteration count` := [internal] fresh #26
