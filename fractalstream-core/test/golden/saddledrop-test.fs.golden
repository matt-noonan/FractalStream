                                                              set `[internal] iteration count` := [internal] fresh #36
                                                              set `[internal] stuck` := ([internal] fresh #36 = [internal] fresh #37)
                                                        if !([internal] escape radius < |x|) then:
                                                          block:
                                                            set `color` := Color 0 0 0
