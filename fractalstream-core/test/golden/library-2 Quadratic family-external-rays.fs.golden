=== viewer 0: Dynamical plane
--- body
let `[internal] vanishing radius` = vanishing_radius in:
  let `[internal] escape radius` = escape_radius in:
    let `[internal] iteration limit` = max_iters in:
      let `[internal] stuck` = False in:
        let `[internal] iteration count` = 0 in:
          let `z` = ([internal] x:C + (0.0 :+ 1.0 * [internal] y:C)) in:
            let `pixel_size` = [internal] dx in:
              block:
                let `[internal] fresh #32` = 0 in:
                  let `[internal] fresh #33` = [internal] iteration limit in:
                    block:
                      if (!([internal] escape radius < |z|) and ([internal] fresh #32 < [internal] fresh #33)) then:
                        do-while (!([internal] escape radius < |z|) and ([internal] fresh #32 < [internal] fresh #33)):
                          block:
                            set `z` := ((z ^ 2:R:C) + C)
                            set `[internal] fresh #32` := ([internal] fresh #32 + 1)
                      else:
                        no-op
                      set `[internal] iteration count` := [internal] fresh #32
                      set `[internal] stuck` := ([internal] fresh #32 = [internal] fresh #33)
                block:
                  let `[colorizer] Dynamical plane: z` = z in:
                    block:
                      block:
                        if [internal] stuck then:
                          block:
                            set `color` := [colorizer] Dynamical plane: gives_up
                        else:
                          block:
                            let `[colorizer] Dynamical plane: s` = [internal] iteration count:R in:
                              block:
                                if ([colorizer] Dynamical plane: smooth and ([internal] escape radius < |[colorizer] Dynamical plane: z|)) then:
                                  block:
                                    set `[colorizer] Dynamical plane: s` := (([internal] iteration count + 1):R - (log((log(|[colorizer] Dynamical plane: z|) / log(escape_radius))) / log([colorizer] Dynamical plane: degree)))
                                else:
                                  no-op
                                set `color` := if (0:R < im([colorizer] Dynamical plane: z)) then let #cycle-arg = (([colorizer] Dynamical plane: s / [colorizer] Dynamical plane: period) mod 1.0) in blend(if (#cycle-arg < (1.0 / 2.0)) then (2.0 * #cycle-arg) else (2.0 - (2.0 * #cycle-arg)), [colorizer] Dynamical plane: upper1, [colorizer] Dynamical plane: upper2) else let #cycle-arg = (([colorizer] Dynamical plane: s / [colorizer] Dynamical plane: period) mod 1.0) in blend(if (#cycle-arg < (1.0 / 2.0)) then (2.0 * #cycle-arg) else (2.0 - (2.0 * #cycle-arg)), [colorizer] Dynamical plane: lower1, [colorizer] Dynamical plane: lower2)


