=== viewer 0: Parameter plane
--- once per render
let `color` = Color 128 128 128 in:
  let `[internal] dy` = 0.0 in:
    let `[internal] dx` = 0.0 in:
      let `[internal] y` = 0.0 in:
        let `[internal] x` = 0.0 in:
          let `[internal] vanishing radius` = vanishing_radius in:
            let `[internal] escape radius` = escape_radius in:
              let `[internal] iteration limit` = max_iters in:
                let `[internal] stuck` = False in:
                  let `[internal] iteration count` = 0 in:
                    block:
                      let `[internal] stops.started #0` = False in:
                        block:
                          set `[hoisted] [internal] stops.started #0` := [internal] stops.started #0

--- body
let `[internal] vanishing radius` = vanishing_radius in:
  let `[internal] escape radius` = escape_radius in:
    let `[internal] iteration limit` = max_iters in:
      let `[internal] stuck` = False in:
        let `[internal] iteration count` = 0 in:
          block:
            set `a` := ([internal] x:C + (0.0 :+ 1.0 * [internal] y:C))
            let `pixel_size` = [internal] dx in:
              block:
                let `[internal] stops.started #0` = [hoisted] [internal] stops.started #0 in:
                  block:
                    let `z` = (a / 3:R:C) in:
                      block:
                        let `[internal] stops.prev #1` = z in:
                          block:
                            let `[internal] fresh #32` = 0 in:
                              let `[internal] fresh #33` = [internal] iteration limit in:
                                block:
                                  if (!([internal] stops.started #0 and (|(z - [internal] stops.prev #1)| < [internal] vanishing radius)) and ([internal] fresh #32 < [internal] fresh #33)) then:
                                    do-while (!([internal] stops.started #0 and (|(z - [internal] stops.prev #1)| < [internal] vanishing radius)) and ([internal] fresh #32 < [internal] fresh #33)):
                                      block:
                                        block:
                                          set `[internal] stops.prev #1` := z
                                          set `[internal] stops.started #0` := True
                                          set `z` := let [internal] newton.z #0 = z in ([internal] newton.z #0 - (let [internal] f.z #1 = [internal] newton.z #0 in ((([internal] f.z #1 - 1:R:C) * ([internal] f.z #1 + 1:R:C)) * ([internal] f.z #1 - a)) / let [internal] f'.z #2 = [internal] newton.z #0 in ((([internal] f'.z #2 - a) * (([internal] f'.z #2 + 1:R:C) + ([internal] f'.z #2 - 1:R:C))) + (([internal] f'.z #2 - 1:R:C) * ([internal] f'.z #2 + 1:R:C)))))
                                        set `[internal] fresh #32` := ([internal] fresh #32 + 1)
                                  else:
                                    no-op
                                  set `[internal] iteration count` := [internal] fresh #32
                                  set `[internal] stuck` := ([internal] fresh #32 = [internal] fresh #33)
                            let `[colorizer] Parameter plane: z` = z in:
                              block:
                                if [internal] stuck then:
                                  block:
                                    set `color` := [colorizer] Parameter plane: gives_up
                                else:
                                  block:
                                    if [colorizer] Parameter plane: allow_new then:
                                      block:
                                        set `color` := autocolor(0, [colorizer] Parameter plane: z)
                                    else:
                                      if [colorizer] Parameter plane: blend_misses then:
                                        block:
                                          set `color` := get_autocolor(0, [colorizer] Parameter plane: z)
                                      else:
                                        block:
                                          set `color` := nearest_autocolor(0, [colorizer] Parameter plane: z)
                                    if [colorizer] Parameter plane: shade then:
                                      block:
                                        set `color` := let [internal] [std] cycle.t #2 = ([internal] iteration count:R / [colorizer] Parameter plane: period) in let [internal] [std] cycle.c1 #2 = let [internal] [std] light.c #0 = color in blend(0.333, [internal] [std] light.c #0, Color 255 255 255) in let [internal] [std] cycle.c2 #2 = let [internal] [std] dark.c #1 = color in blend(0.333, [internal] [std] dark.c #1, Color 0 0 0) in let [internal] [std] cycle_at.s #3 = ([internal] [std] cycle.t #2 mod 1.0) in let [internal] [std] cycle_at.c1 #3 = [internal] [std] cycle.c1 #2 in let [internal] [std] cycle_at.c2 #3 = [internal] [std] cycle.c2 #2 in blend(if ([internal] [std] cycle_at.s #3 < 0.5) then (2:R * [internal] [std] cycle_at.s #3) else (2:R - (2:R * [internal] [std] cycle_at.s #3)), [internal] [std] cycle_at.c1 #3, [internal] [std] cycle_at.c2 #3)
                                    else:
                                      no-op


=== viewer 1: Dynamical plane
--- once per render
let `color` = Color 128 128 128 in:
  let `[internal] dy` = 0.0 in:
    let `[internal] dx` = 0.0 in:
      let `[internal] y` = 0.0 in:
        let `[internal] x` = 0.0 in:
          let `[internal] vanishing radius` = vanishing_radius in:
            let `[internal] escape radius` = escape_radius in:
              let `[internal] iteration limit` = max_iters in:
                let `[internal] stuck` = False in:
                  let `[internal] iteration count` = 0 in:
                    block:
                      let `[internal] stops.started #0` = False in:
                        block:
                          set `[hoisted] [internal] stops.started #0` := [internal] stops.started #0

--- body
let `[internal] vanishing radius` = vanishing_radius in:
  let `[internal] escape radius` = escape_radius in:
    let `[internal] iteration limit` = max_iters in:
      let `[internal] stuck` = False in:
        let `[internal] iteration count` = 0 in:
          let `z` = ([internal] x:C + (0.0 :+ 1.0 * [internal] y:C)) in:
            let `pixel_size` = [internal] dx in:
              block:
                let `[internal] stops.started #0` = [hoisted] [internal] stops.started #0 in:
                  block:
                    let `[internal] stops.prev #1` = z in:
                      block:
                        let `[internal] fresh #32` = 0 in:
                          let `[internal] fresh #33` = [internal] iteration limit in:
                            block:
                              if (!([internal] stops.started #0 and (|(z - [internal] stops.prev #1)| < [internal] vanishing radius)) and ([internal] fresh #32 < [internal] fresh #33)) then:
                                do-while (!([internal] stops.started #0 and (|(z - [internal] stops.prev #1)| < [internal] vanishing radius)) and ([internal] fresh #32 < [internal] fresh #33)):
                                  block:
                                    block:
                                      set `[internal] stops.prev #1` := z
                                      set `[internal] stops.started #0` := True
                                      set `z` := let [internal] newton.z #0 = z in ([internal] newton.z #0 - (let [internal] f.z #1 = [internal] newton.z #0 in ((([internal] f.z #1 - 1:R:C) * ([internal] f.z #1 + 1:R:C)) * ([internal] f.z #1 - a)) / let [internal] f'.z #2 = [internal] newton.z #0 in ((([internal] f'.z #2 - a) * (([internal] f'.z #2 + 1:R:C) + ([internal] f'.z #2 - 1:R:C))) + (([internal] f'.z #2 - 1:R:C) * ([internal] f'.z #2 + 1:R:C)))))
                                    set `[internal] fresh #32` := ([internal] fresh #32 + 1)
                              else:
                                no-op
                              set `[internal] iteration count` := [internal] fresh #32
                              set `[internal] stuck` := ([internal] fresh #32 = [internal] fresh #33)
                        let `[colorizer] Dynamical plane: z` = z in:
                          block:
                            if [internal] stuck then:
                              block:
                                set `color` := [colorizer] Dynamical plane: gives_up
                            else:
                              block:
                                if [colorizer] Dynamical plane: allow_new then:
                                  block:
                                    set `color` := autocolor(0, [colorizer] Dynamical plane: z)
                                else:
                                  if [colorizer] Dynamical plane: blend_misses then:
                                    block:
                                      set `color` := get_autocolor(0, [colorizer] Dynamical plane: z)
                                  else:
                                    block:
                                      set `color` := nearest_autocolor(0, [colorizer] Dynamical plane: z)
                                if [colorizer] Dynamical plane: shade then:
                                  block:
                                    set `color` := let [internal] [std] cycle.t #2 = ([internal] iteration count:R / [colorizer] Dynamical plane: period) in let [internal] [std] cycle.c1 #2 = let [internal] [std] light.c #0 = color in blend(0.333, [internal] [std] light.c #0, Color 255 255 255) in let [internal] [std] cycle.c2 #2 = let [internal] [std] dark.c #1 = color in blend(0.333, [internal] [std] dark.c #1, Color 0 0 0) in let [internal] [std] cycle_at.s #3 = ([internal] [std] cycle.t #2 mod 1.0) in let [internal] [std] cycle_at.c1 #3 = [internal] [std] cycle.c1 #2 in let [internal] [std] cycle_at.c2 #3 = [internal] [std] cycle.c2 #2 in blend(if ([internal] [std] cycle_at.s #3 < 0.5) then (2:R * [internal] [std] cycle_at.s #3) else (2:R - (2:R * [internal] [std] cycle_at.s #3)), [internal] [std] cycle_at.c1 #3, [internal] [std] cycle_at.c2 #3)
                                else:
                                  no-op


--- tool Trace
  -- on click
let `[internal] vanishing radius` = vanishing_radius in:
  let `[internal] escape radius` = escape_radius in:
    let `[internal] iteration limit` = max_iters in:
      let `[internal] stuck` = False in:
        let `[internal] iteration count` = 0 in:
          let `[internal] click` = [internal] point a in:
            let `pixel_size` = [internal] px in:
              block:
                let `z` = [internal] click in:
                  block:
                    erase
                    use Color 255 255 255 for line
                    block:
                      let `[internal] previous.z #0` = z in:
                        block:
                          block:
                            let `[internal] stops.prev #1` = z in:
                              block:
                                let `[internal] fresh #28` = 0 in:
                                  let `[internal] fresh #29` = [internal] iteration limit in:
                                    block:
                                      do-while (!(|(z - [internal] stops.prev #1)| < [internal] vanishing radius) and ([internal] fresh #28 < [internal] fresh #29)):
                                        block:
                                          block:
                                            set `[internal] stops.prev #1` := z
                                            block:
                                              set `[internal] previous.z #0` := z
                                              block:
                                                set `z` := let [internal] newton.z #0 = z in ([internal] newton.z #0 - (let [internal] f.z #1 = [internal] newton.z #0 in ((([internal] f.z #1 - 1:R:C) * ([internal] f.z #1 + 1:R:C)) * ([internal] f.z #1 - a)) / let [internal] f'.z #2 = [internal] newton.z #0 in ((([internal] f'.z #2 - a) * (([internal] f'.z #2 + 1:R:C) + ([internal] f'.z #2 - 1:R:C))) + (([internal] f'.z #2 - 1:R:C) * ([internal] f'.z #2 + 1:R:C)))))
                                                draw point at ([internal] previous.z #0, 1.0 :+ 0.0)
                                                draw line from ([internal] previous.z #0, 1.0 :+ 0.0) to (z, 1.0 :+ 0.0)
                                          set `[internal] fresh #28` := ([internal] fresh #28 + 1)
                                      set `[internal] iteration count` := [internal] fresh #28
                                      set `[internal] stuck` := ([internal] fresh #28 = [internal] fresh #29)
                    draw point at (z, 1.0 :+ 0.0)

  -- on drag
let `[internal] vanishing radius` = vanishing_radius in:
  let `[internal] escape radius` = escape_radius in:
    let `[internal] iteration limit` = max_iters in:
      let `[internal] stuck` = False in:
        let `[internal] iteration count` = 0 in:
          let `[internal] click` = [internal] point a in:
            let `[unused] drag start` = [internal] old point a in:
              let `pixel_size` = [internal] px in:
                block:
                  let `z` = [internal] click in:
                    block:
                      erase
                      use Color 255 255 255 for line
                      block:
                        let `[internal] previous.z #0` = z in:
                          block:
                            block:
                              let `[internal] stops.prev #1` = z in:
                                block:
                                  let `[internal] fresh #31` = 0 in:
                                    let `[internal] fresh #32` = [internal] iteration limit in:
                                      block:
                                        do-while (!(|(z - [internal] stops.prev #1)| < [internal] vanishing radius) and ([internal] fresh #31 < [internal] fresh #32)):
                                          block:
                                            block:
                                              set `[internal] stops.prev #1` := z
                                              block:
                                                set `[internal] previous.z #0` := z
                                                block:
                                                  set `z` := let [internal] newton.z #0 = z in ([internal] newton.z #0 - (let [internal] f.z #1 = [internal] newton.z #0 in ((([internal] f.z #1 - 1:R:C) * ([internal] f.z #1 + 1:R:C)) * ([internal] f.z #1 - a)) / let [internal] f'.z #2 = [internal] newton.z #0 in ((([internal] f'.z #2 - a) * (([internal] f'.z #2 + 1:R:C) + ([internal] f'.z #2 - 1:R:C))) + (([internal] f'.z #2 - 1:R:C) * ([internal] f'.z #2 + 1:R:C)))))
                                                  draw point at ([internal] previous.z #0, 1.0 :+ 0.0)
                                                  draw line from ([internal] previous.z #0, 1.0 :+ 0.0) to (z, 1.0 :+ 0.0)
                                            set `[internal] fresh #31` := ([internal] fresh #31 + 1)
                                        set `[internal] iteration count` := [internal] fresh #31
                                        set `[internal] stuck` := ([internal] fresh #31 = [internal] fresh #32)
                      draw point at (z, 1.0 :+ 0.0)

  -- on deactivated
let `[internal] vanishing radius` = vanishing_radius in:
  let `[internal] escape radius` = escape_radius in:
    let `[internal] iteration limit` = max_iters in:
      let `[internal] stuck` = False in:
        let `[internal] iteration count` = 0 in:
          let `pixel_size` = [internal] px in:
            block:
              erase


