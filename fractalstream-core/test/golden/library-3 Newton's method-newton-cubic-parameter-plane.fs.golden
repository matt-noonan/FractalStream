=== viewer 0: Parameter plane
--- body
let `[internal] vanishing radius` = vanishing_radius in:
  let `[internal] escape radius` = escape_radius in:
    let `[internal] iteration limit` = max_iters in:
      let `[internal] stuck` = False in:
        let `[internal] iteration count` = 0 in:
          block:
            set `a` := ([internal] x:C + (0.0 :+ 1.0 * [internal] y:C))
            let `pixel_size` = [internal] dx in:
              block:
                let `z` = (a / 3:R:C) in:
                  block:
                    block:
                      block:
                        let `lastZ` = 0:R:C in:
                          block:
                            let `[internal] fresh #27` = 0 in:
                              let `[internal] fresh #28` = [internal] iteration limit in:
                                block:
                                  do-while (!(|(z - lastZ)| < [internal] vanishing radius) and ([internal] fresh #27 < [internal] fresh #28)):
                                    block:
                                      block:
                                        set `lastZ` := z
                                        set `z` := let [internal] newton.z #0 = z in ([internal] newton.z #0 - (let [internal] f.z #1 = [internal] newton.z #0 in ((([internal] f.z #1 - 1:R:C) * ([internal] f.z #1 + 1:R:C)) * ([internal] f.z #1 - a)) / let [internal] f'.z #2 = [internal] newton.z #0 in ((([internal] f'.z #2 - a) * (([internal] f'.z #2 + 1:R:C) + ([internal] f'.z #2 - 1:R:C))) + (([internal] f'.z #2 - 1:R:C) * ([internal] f'.z #2 + 1:R:C)))))
                                      set `[internal] fresh #27` := ([internal] fresh #27 + 1)
                                  set `[internal] iteration count` := [internal] fresh #27
                                  set `[internal] stuck` := ([internal] fresh #27 = [internal] fresh #28)
                    block:
                      let `[colorizer] Parameter plane: z` = z in:
                        block:
                          block:
                            if [internal] stuck then:
                              block:
                                set `color` := [colorizer] Parameter plane: gives_up
                            else:
                              block:
                                if [colorizer] Parameter plane: allow_new then:
                                  block:
                                    set `color` := autocolor(0, [colorizer] Parameter plane: z)
                                else:
                                  if [colorizer] Parameter plane: blend_misses then:
                                    block:
                                      set `color` := get_autocolor(0, [colorizer] Parameter plane: z)
                                  else:
                                    block:
                                      set `color` := nearest_autocolor(0, [colorizer] Parameter plane: z)
                                if [colorizer] Parameter plane: shade then:
                                  block:
                                    set `color` := let #cycle-arg = (([internal] iteration count:R / [colorizer] Parameter plane: period) mod 1.0) in blend(if (#cycle-arg < (1.0 / 2.0)) then (2.0 * #cycle-arg) else (2.0 - (2.0 * #cycle-arg)), blend(0.333, Color 0 0 0, color), blend(0.333, Color 255 255 255, color))
                                else:
                                  no-op


--- tool Pick a
  -- on click
let `[internal] vanishing radius` = vanishing_radius in:
  let `[internal] escape radius` = escape_radius in:
    let `[internal] iteration limit` = max_iters in:
      let `[internal] stuck` = False in:
        let `[internal] iteration count` = 0 in:
          block:
            set `a` := ([internal] x:C + (0.0 :+ 1.0 * [internal] y:C))
            let `pixel_size` = [internal] px in:
              block:
                no-op

  -- on drag
let `[internal] vanishing radius` = vanishing_radius in:
  let `[internal] escape radius` = escape_radius in:
    let `[internal] iteration limit` = max_iters in:
      let `[internal] stuck` = False in:
        let `[internal] iteration count` = 0 in:
          block:
            set `a` := ([internal] x:C + (0.0 :+ 1.0 * [internal] y:C))
            let `[unused] start` = ([internal] oldx:C + (0.0 :+ 1.0 * [internal] oldy:C)) in:
              let `pixel_size` = [internal] px in:
                block:
                  no-op


=== viewer 1: Dynamical plane
--- body
let `[internal] vanishing radius` = vanishing_radius in:
  let `[internal] escape radius` = escape_radius in:
    let `[internal] iteration limit` = max_iters in:
      let `[internal] stuck` = False in:
        let `[internal] iteration count` = 0 in:
          let `z` = ([internal] x:C + (0.0 :+ 1.0 * [internal] y:C)) in:
            let `pixel_size` = [internal] dx in:
              block:
                block:
                  block:
                    let `lastZ` = 0:R:C in:
                      block:
                        let `[internal] fresh #27` = 0 in:
                          let `[internal] fresh #28` = [internal] iteration limit in:
                            block:
                              do-while (!(|(z - lastZ)| < [internal] vanishing radius) and ([internal] fresh #27 < [internal] fresh #28)):
                                block:
                                  block:
                                    set `lastZ` := z
                                    set `z` := let [internal] newton.z #0 = z in ([internal] newton.z #0 - (let [internal] f.z #1 = [internal] newton.z #0 in ((([internal] f.z #1 - 1:R:C) * ([internal] f.z #1 + 1:R:C)) * ([internal] f.z #1 - a)) / let [internal] f'.z #2 = [internal] newton.z #0 in ((([internal] f'.z #2 - a) * (([internal] f'.z #2 + 1:R:C) + ([internal] f'.z #2 - 1:R:C))) + (([internal] f'.z #2 - 1:R:C) * ([internal] f'.z #2 + 1:R:C)))))
                                  set `[internal] fresh #27` := ([internal] fresh #27 + 1)
                              set `[internal] iteration count` := [internal] fresh #27
                              set `[internal] stuck` := ([internal] fresh #27 = [internal] fresh #28)
                block:
                  let `[colorizer] Dynamical plane: z` = z in:
                    block:
                      block:
                        if [internal] stuck then:
                          block:
                            set `color` := [colorizer] Dynamical plane: gives_up
                        else:
                          block:
                            if [colorizer] Dynamical plane: allow_new then:
                              block:
                                set `color` := autocolor(0, [colorizer] Dynamical plane: z)
                            else:
                              if [colorizer] Dynamical plane: blend_misses then:
                                block:
                                  set `color` := get_autocolor(0, [colorizer] Dynamical plane: z)
                              else:
                                block:
                                  set `color` := nearest_autocolor(0, [colorizer] Dynamical plane: z)
                            if [colorizer] Dynamical plane: shade then:
                              block:
                                set `color` := let #cycle-arg = (([internal] iteration count:R / [colorizer] Dynamical plane: period) mod 1.0) in blend(if (#cycle-arg < (1.0 / 2.0)) then (2.0 * #cycle-arg) else (2.0 - (2.0 * #cycle-arg)), blend(0.333, Color 0 0 0, color), blend(0.333, Color 255 255 255, color))
                            else:
                              no-op


--- tool Trace
  -- on click
let `[internal] vanishing radius` = vanishing_radius in:
  let `[internal] escape radius` = escape_radius in:
    let `[internal] iteration limit` = max_iters in:
      let `[internal] stuck` = False in:
        let `[internal] iteration count` = 0 in:
          let `z` = ([internal] x:C + (0.0 :+ 1.0 * [internal] y:C)) in:
            let `pixel_size` = [internal] px in:
              block:
                let `lastZ` = 0:R:C in:
                  block:
                    erase
                    use Color 255 255 255 for line
                    let `[internal] fresh #25` = 0 in:
                      let `[internal] fresh #26` = [internal] iteration limit in:
                        block:
                          do-while (!(|(z - lastZ)| < [internal] vanishing radius) and ([internal] fresh #25 < [internal] fresh #26)):
                            block:
                              block:
                                set `lastZ` := z
                                set `z` := let [internal] newton.z #0 = z in ([internal] newton.z #0 - (let [internal] f.z #1 = [internal] newton.z #0 in ((([internal] f.z #1 - 1:R:C) * ([internal] f.z #1 + 1:R:C)) * ([internal] f.z #1 - a)) / let [internal] f'.z #2 = [internal] newton.z #0 in ((([internal] f'.z #2 - a) * (([internal] f'.z #2 + 1:R:C) + ([internal] f'.z #2 - 1:R:C))) + (([internal] f'.z #2 - 1:R:C) * ([internal] f'.z #2 + 1:R:C)))))
                                draw point at lastZ:R^2
                                draw line from lastZ:R^2 to z:R^2
                              set `[internal] fresh #25` := ([internal] fresh #25 + 1)
                          set `[internal] iteration count` := [internal] fresh #25
                          set `[internal] stuck` := ([internal] fresh #25 = [internal] fresh #26)
                    draw point at z:R^2

  -- on drag
let `[internal] vanishing radius` = vanishing_radius in:
  let `[internal] escape radius` = escape_radius in:
    let `[internal] iteration limit` = max_iters in:
      let `[internal] stuck` = False in:
        let `[internal] iteration count` = 0 in:
          let `z` = ([internal] x:C + (0.0 :+ 1.0 * [internal] y:C)) in:
            let `[unused] start` = ([internal] oldx:C + (0.0 :+ 1.0 * [internal] oldy:C)) in:
              let `pixel_size` = [internal] px in:
                block:
                  let `lastZ` = 0:R:C in:
                    block:
                      erase
                      use Color 255 255 255 for line
                      let `[internal] fresh #28` = 0 in:
                        let `[internal] fresh #29` = [internal] iteration limit in:
                          block:
                            do-while (!(|(z - lastZ)| < [internal] vanishing radius) and ([internal] fresh #28 < [internal] fresh #29)):
                              block:
                                block:
                                  set `lastZ` := z
                                  set `z` := let [internal] newton.z #0 = z in ([internal] newton.z #0 - (let [internal] f.z #1 = [internal] newton.z #0 in ((([internal] f.z #1 - 1:R:C) * ([internal] f.z #1 + 1:R:C)) * ([internal] f.z #1 - a)) / let [internal] f'.z #2 = [internal] newton.z #0 in ((([internal] f'.z #2 - a) * (([internal] f'.z #2 + 1:R:C) + ([internal] f'.z #2 - 1:R:C))) + (([internal] f'.z #2 - 1:R:C) * ([internal] f'.z #2 + 1:R:C)))))
                                  draw point at lastZ:R^2
                                  draw line from lastZ:R^2 to z:R^2
                                set `[internal] fresh #28` := ([internal] fresh #28 + 1)
                            set `[internal] iteration count` := [internal] fresh #28
                            set `[internal] stuck` := ([internal] fresh #28 = [internal] fresh #29)
                      draw point at z:R^2

