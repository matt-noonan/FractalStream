--- tool Trace
  -- on click
let `[internal] vanishing radius` = tol in:
  let `[internal] escape radius` = escape_radius in:
    let `[internal] iteration limit` = max_iters in:
      let `[internal] stuck` = False in:
        let `[internal] iteration count` = 0 in:
          let `z` = ([internal] x:C + (0.0 :+ 1.0 * [internal] y:C)) in:
            let `pixel_size` = [internal] px in:
              block:
                let `r1` = 1 in:
                  block:
                    let `r2` = (-0.5:C + a) in:
                      block:
                        let `r3` = (-0.5:C - a) in:
                          block:
                            erase
                            block:
                              let `[internal] previous.z #0` = z in:
                                block:
                                  block:
                                    let `[internal] stops.prev #1` = z in:
                                      block:
                                        let `[internal] stops.started #0` = False in:
                                          block:
                                            let `[internal] fresh #22` = 0 in:
                                              let `[internal] fresh #23` = [internal] iteration limit in:
                                                block:
                                                  if (!([internal] stops.started #0 and (|(z - [internal] stops.prev #1)| < [internal] vanishing radius)) and ([internal] fresh #22 < [internal] fresh #23)) then:
                                                    do-while (!([internal] stops.started #0 and (|(z - [internal] stops.prev #1)| < [internal] vanishing radius)) and ([internal] fresh #22 < [internal] fresh #23)):
                                                      block:
                                                        block:
                                                          set `[internal] stops.prev #1` := z
                                                          set `[internal] stops.started #0` := True
                                                          block:
                                                            set `[internal] previous.z #0` := z
                                                            block:
                                                              set `z` := let [internal] newton.z #0 = z in ([internal] newton.z #0 - (let [internal] p.z #1 = [internal] newton.z #0 in ((([internal] p.z #1 - r1:R:C) * ([internal] p.z #1 - r2)) * ([internal] p.z #1 - r3)) / let [internal] p'.z #2 = [internal] newton.z #0 in ((([internal] p'.z #2 - r3) * (([internal] p'.z #2 - r2) + ([internal] p'.z #2 - r1:R:C))) + (([internal] p'.z #2 - r1:R:C) * ([internal] p'.z #2 - r2)))))
                                                              draw point at [internal] previous.z #0:R^2
                                                              draw line from [internal] previous.z #0:R^2 to z:R^2
                                                        set `[internal] fresh #22` := ([internal] fresh #22 + 1)
                                                  else:
                                                    no-op
                                                  set `[internal] iteration count` := [internal] fresh #22
                                                  set `[internal] stuck` := ([internal] fresh #22 = [internal] fresh #23)
                            draw point at z:R^2

  -- on drag
let `[internal] vanishing radius` = tol in:
  let `[internal] escape radius` = escape_radius in:
    let `[internal] iteration limit` = max_iters in:
      let `[internal] stuck` = False in:
        let `[internal] iteration count` = 0 in:
          let `z` = ([internal] x:C + (0.0 :+ 1.0 * [internal] y:C)) in:
            let `[unused] start` = ([internal] oldx:C + (0.0 :+ 1.0 * [internal] oldy:C)) in:
              let `pixel_size` = [internal] px in:
                block:
                  let `r1` = 1 in:
                    block:
                      let `r2` = (-0.5:C + a) in:
                        block:
                          let `r3` = (-0.5:C - a) in:
                            block:
                              erase
                              block:
                                let `[internal] previous.z #0` = z in:
                                  block:
                                    block:
                                      let `[internal] stops.prev #1` = z in:
                                        block:
                                          let `[internal] stops.started #0` = False in:
                                            block:
                                              let `[internal] fresh #25` = 0 in:
                                                let `[internal] fresh #26` = [internal] iteration limit in:
                                                  block:
                                                    if (!([internal] stops.started #0 and (|(z - [internal] stops.prev #1)| < [internal] vanishing radius)) and ([internal] fresh #25 < [internal] fresh #26)) then:
                                                      do-while (!([internal] stops.started #0 and (|(z - [internal] stops.prev #1)| < [internal] vanishing radius)) and ([internal] fresh #25 < [internal] fresh #26)):
                                                        block:
                                                          block:
                                                            set `[internal] stops.prev #1` := z
                                                            set `[internal] stops.started #0` := True
                                                            block:
                                                              set `[internal] previous.z #0` := z
                                                              block:
                                                                set `z` := let [internal] newton.z #0 = z in ([internal] newton.z #0 - (let [internal] p.z #1 = [internal] newton.z #0 in ((([internal] p.z #1 - r1:R:C) * ([internal] p.z #1 - r2)) * ([internal] p.z #1 - r3)) / let [internal] p'.z #2 = [internal] newton.z #0 in ((([internal] p'.z #2 - r3) * (([internal] p'.z #2 - r2) + ([internal] p'.z #2 - r1:R:C))) + (([internal] p'.z #2 - r1:R:C) * ([internal] p'.z #2 - r2)))))
                                                                draw point at [internal] previous.z #0:R^2
                                                                draw line from [internal] previous.z #0:R^2 to z:R^2
                                                          set `[internal] fresh #25` := ([internal] fresh #25 + 1)
                                                    else:
                                                      no-op
                                                    set `[internal] iteration count` := [internal] fresh #25
                                                    set `[internal] stuck` := ([internal] fresh #25 = [internal] fresh #26)
                              draw point at z:R^2

  -- on deactivated
let `[internal] vanishing radius` = tol in:
  let `[internal] escape radius` = escape_radius in:
    let `[internal] iteration limit` = max_iters in:
      let `[internal] stuck` = False in:
        let `[internal] iteration count` = 0 in:
          let `pixel_size` = [internal] px in:
            block:
              erase


