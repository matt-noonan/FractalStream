=== viewer 0: Parameter plane
--- once per render
let `color` = Color 128 128 128 in:
  let `[internal] dy` = 0.0 in:
    let `[internal] dx` = 0.0 in:
      let `[internal] y` = 0.0 in:
        let `[internal] x` = 0.0 in:
          let `[internal] vanishing radius` = tol in:
            let `[internal] escape radius` = escape_radius in:
              let `[internal] iteration limit` = max_iters in:
                let `[internal] stuck` = False in:
                  let `[internal] iteration count` = 0 in:
                    block:
                      let `r1` = 1 in:
                        block:
                          let `[internal] stops.started #0` = False in:
                            block:
                              let `[internal] shade.c #0` = Color 128 128 128 in:
                                block:
                                  set `[hoisted] r1` := r1
                                  set `[hoisted] [internal] stops.started #0` := [internal] stops.started #0
                                  set `[hoisted] [internal] shade.c #0` := [internal] shade.c #0

--- body
let `[internal] vanishing radius` = tol in:
  let `[internal] escape radius` = escape_radius in:
    let `[internal] iteration limit` = max_iters in:
      let `[internal] stuck` = False in:
        let `[internal] iteration count` = 0 in:
          block:
            set `a` := ([internal] x:C + (0.0 :+ 1.0 * [internal] y:C))
            let `pixel_size` = [internal] dx in:
              block:
                let `r1` = [hoisted] r1 in:
                  block:
                    let `[internal] stops.started #0` = [hoisted] [internal] stops.started #0 in:
                      block:
                        let `[internal] shade.c #0` = [hoisted] [internal] shade.c #0 in:
                          block:
                            let `r2` = (-0.5:C + a) in:
                              block:
                                let `r3` = (-0.5:C - a) in:
                                  block:
                                    let `z` = 0:R:C in:
                                      block:
                                        let `[internal] stops.prev #1` = z in:
                                          block:
                                            let `[internal] fresh #29` = 0 in:
                                              let `[internal] fresh #30` = [internal] iteration limit in:
                                                block:
                                                  if (!([internal] stops.started #0 and (|(z - [internal] stops.prev #1)| < [internal] vanishing radius)) and ([internal] fresh #29 < [internal] fresh #30)) then:
                                                    do-while (!([internal] stops.started #0 and (|(z - [internal] stops.prev #1)| < [internal] vanishing radius)) and ([internal] fresh #29 < [internal] fresh #30)):
                                                      block:
                                                        block:
                                                          set `[internal] stops.prev #1` := z
                                                          set `[internal] stops.started #0` := True
                                                          set `z` := let [internal] newton.z #0 = z in ([internal] newton.z #0 - (let [internal] p.z #1 = [internal] newton.z #0 in ((([internal] p.z #1 - r1:R:C) * ([internal] p.z #1 - r2)) * ([internal] p.z #1 - r3)) / let [internal] p'.z #2 = [internal] newton.z #0 in ((([internal] p'.z #2 - r3) * (([internal] p'.z #2 - r2) + ([internal] p'.z #2 - r1:R:C))) + (([internal] p'.z #2 - r1:R:C) * ([internal] p'.z #2 - r2)))))
                                                        set `[internal] fresh #29` := ([internal] fresh #29 + 1)
                                                  else:
                                                    no-op
                                                  set `[internal] iteration count` := [internal] fresh #29
                                                  set `[internal] stuck` := ([internal] fresh #29 = [internal] fresh #30)
                                            if (|(z - r1:R:C)| < [internal] vanishing radius) then:
                                              block:
                                                set `[internal] shade.c #0` := Color 255 0 0
                                            else:
                                              if (|(z - r2)| < [internal] vanishing radius) then:
                                                block:
                                                  set `[internal] shade.c #0` := Color 0 180 0
                                              else:
                                                if (|(z - r3)| < [internal] vanishing radius) then:
                                                  block:
                                                    set `[internal] shade.c #0` := Color 0 0 255
                                                else:
                                                  no-op
                                            let `[internal] shade.s #0` = (cos((([internal] iteration count:R * 3.141592653589793) / 10:R)) ^ 2:R) in:
                                              block:
                                                set `color` := if ![internal] stuck then blend([internal] shade.s #0, let [internal] [std] light.c #1 = [internal] shade.c #0 in blend(0.333, [internal] [std] light.c #1, Color 255 255 255), let [internal] [std] dark.c #0 = [internal] shade.c #0 in blend(0.333, [internal] [std] dark.c #0, Color 0 0 0)) else Color 0 0 0


=== viewer 1: Newton's method dynamics
--- once per render
let `color` = Color 128 128 128 in:
  let `[internal] dy` = 0.0 in:
    let `[internal] dx` = 0.0 in:
      let `[internal] y` = 0.0 in:
        let `[internal] x` = 0.0 in:
          let `[internal] vanishing radius` = tol in:
            let `[internal] escape radius` = escape_radius in:
              let `[internal] iteration limit` = max_iters in:
                let `[internal] stuck` = False in:
                  let `[internal] iteration count` = 0 in:
                    block:
                      let `r1` = 1 in:
                        block:
                          let `r2` = (-0.5:C + a) in:
                            block:
                              let `r3` = (-0.5:C - a) in:
                                block:
                                  let `[internal] stops.started #0` = False in:
                                    block:
                                      let `[internal] shade.c #0` = Color 128 128 128 in:
                                        block:
                                          set `[hoisted] r1` := r1
                                          set `[hoisted] r2` := r2
                                          set `[hoisted] r3` := r3
                                          set `[hoisted] [internal] stops.started #0` := [internal] stops.started #0
                                          set `[hoisted] [internal] shade.c #0` := [internal] shade.c #0

--- body
let `[internal] vanishing radius` = tol in:
  let `[internal] escape radius` = escape_radius in:
    let `[internal] iteration limit` = max_iters in:
      let `[internal] stuck` = False in:
        let `[internal] iteration count` = 0 in:
          let `z` = ([internal] x:C + (0.0 :+ 1.0 * [internal] y:C)) in:
            let `pixel_size` = [internal] dx in:
              block:
                let `r1` = [hoisted] r1 in:
                  block:
                    let `r2` = [hoisted] r2 in:
                      block:
                        let `r3` = [hoisted] r3 in:
                          block:
                            let `[internal] stops.started #0` = [hoisted] [internal] stops.started #0 in:
                              block:
                                let `[internal] shade.c #0` = [hoisted] [internal] shade.c #0 in:
                                  block:
                                    let `[internal] stops.prev #1` = z in:
                                      block:
                                        let `[internal] fresh #31` = 0 in:
                                          let `[internal] fresh #32` = [internal] iteration limit in:
                                            block:
                                              if (!([internal] stops.started #0 and (|(z - [internal] stops.prev #1)| < [internal] vanishing radius)) and ([internal] fresh #31 < [internal] fresh #32)) then:
                                                do-while (!([internal] stops.started #0 and (|(z - [internal] stops.prev #1)| < [internal] vanishing radius)) and ([internal] fresh #31 < [internal] fresh #32)):
                                                  block:
                                                    block:
                                                      set `[internal] stops.prev #1` := z
                                                      set `[internal] stops.started #0` := True
                                                      set `z` := let [internal] newton.z #0 = z in ([internal] newton.z #0 - (let [internal] p.z #1 = [internal] newton.z #0 in ((([internal] p.z #1 - r1:R:C) * ([internal] p.z #1 - r2)) * ([internal] p.z #1 - r3)) / let [internal] p'.z #2 = [internal] newton.z #0 in ((([internal] p'.z #2 - r3) * (([internal] p'.z #2 - r2) + ([internal] p'.z #2 - r1:R:C))) + (([internal] p'.z #2 - r1:R:C) * ([internal] p'.z #2 - r2)))))
                                                    set `[internal] fresh #31` := ([internal] fresh #31 + 1)
                                              else:
                                                no-op
                                              set `[internal] iteration count` := [internal] fresh #31
                                              set `[internal] stuck` := ([internal] fresh #31 = [internal] fresh #32)
                                        if (|(z - r1:R:C)| < [internal] vanishing radius) then:
                                          block:
                                            set `[internal] shade.c #0` := Color 255 0 0
                                        else:
                                          if (|(z - r2)| < [internal] vanishing radius) then:
                                            block:
                                              set `[internal] shade.c #0` := Color 0 180 0
                                          else:
                                            if (|(z - r3)| < [internal] vanishing radius) then:
                                              block:
                                                set `[internal] shade.c #0` := Color 0 0 255
                                            else:
                                              no-op
                                        let `[internal] shade.s #0` = (cos((([internal] iteration count:R * 3.141592653589793) / 10:R)) ^ 2:R) in:
                                          block:
                                            set `color` := if ![internal] stuck then blend([internal] shade.s #0, let [internal] [std] light.c #1 = [internal] shade.c #0 in blend(0.333, [internal] [std] light.c #1, Color 255 255 255), let [internal] [std] dark.c #0 = [internal] shade.c #0 in blend(0.333, [internal] [std] dark.c #0, Color 0 0 0)) else Color 0 0 0


--- tool Trace
  -- on click
let `[internal] vanishing radius` = tol in:
  let `[internal] escape radius` = escape_radius in:
    let `[internal] iteration limit` = max_iters in:
      let `[internal] stuck` = False in:
        let `[internal] iteration count` = 0 in:
          let `[internal] click` = [internal] point a in:
            let `pixel_size` = [internal] px in:
              block:
                let `r1` = 1 in:
                  block:
                    let `r2` = (-0.5:C + a) in:
                      block:
                        let `r3` = (-0.5:C - a) in:
                          block:
                            let `z` = [internal] click in:
                              block:
                                erase
                                block:
                                  let `[internal] previous.z #0` = z in:
                                    block:
                                      block:
                                        let `[internal] stops.prev #1` = z in:
                                          block:
                                            let `[internal] stops.started #0` = False in:
                                              block:
                                                let `[internal] fresh #23` = 0 in:
                                                  let `[internal] fresh #24` = [internal] iteration limit in:
                                                    block:
                                                      if (!([internal] stops.started #0 and (|(z - [internal] stops.prev #1)| < [internal] vanishing radius)) and ([internal] fresh #23 < [internal] fresh #24)) then:
                                                        do-while (!([internal] stops.started #0 and (|(z - [internal] stops.prev #1)| < [internal] vanishing radius)) and ([internal] fresh #23 < [internal] fresh #24)):
                                                          block:
                                                            block:
                                                              set `[internal] stops.prev #1` := z
                                                              set `[internal] stops.started #0` := True
                                                              block:
                                                                set `[internal] previous.z #0` := z
                                                                block:
                                                                  set `z` := let [internal] newton.z #0 = z in ([internal] newton.z #0 - (let [internal] p.z #1 = [internal] newton.z #0 in ((([internal] p.z #1 - r1:R:C) * ([internal] p.z #1 - r2)) * ([internal] p.z #1 - r3)) / let [internal] p'.z #2 = [internal] newton.z #0 in ((([internal] p'.z #2 - r3) * (([internal] p'.z #2 - r2) + ([internal] p'.z #2 - r1:R:C))) + (([internal] p'.z #2 - r1:R:C) * ([internal] p'.z #2 - r2)))))
                                                                  draw point at ([internal] previous.z #0, 1.0 :+ 0.0)
                                                                  draw line from ([internal] previous.z #0, 1.0 :+ 0.0) to (z, 1.0 :+ 0.0)
                                                            set `[internal] fresh #23` := ([internal] fresh #23 + 1)
                                                      else:
                                                        no-op
                                                      set `[internal] iteration count` := [internal] fresh #23
                                                      set `[internal] stuck` := ([internal] fresh #23 = [internal] fresh #24)
                                draw point at (z, 1.0 :+ 0.0)

  -- on drag
let `[internal] vanishing radius` = tol in:
  let `[internal] escape radius` = escape_radius in:
    let `[internal] iteration limit` = max_iters in:
      let `[internal] stuck` = False in:
        let `[internal] iteration count` = 0 in:
          let `[internal] click` = [internal] point a in:
            let `[unused] drag start` = [internal] old point a in:
              let `pixel_size` = [internal] px in:
                block:
                  let `r1` = 1 in:
                    block:
                      let `r2` = (-0.5:C + a) in:
                        block:
                          let `r3` = (-0.5:C - a) in:
                            block:
                              let `z` = [internal] click in:
                                block:
                                  erase
                                  block:
                                    let `[internal] previous.z #0` = z in:
                                      block:
                                        block:
                                          let `[internal] stops.prev #1` = z in:
                                            block:
                                              let `[internal] stops.started #0` = False in:
                                                block:
                                                  let `[internal] fresh #26` = 0 in:
                                                    let `[internal] fresh #27` = [internal] iteration limit in:
                                                      block:
                                                        if (!([internal] stops.started #0 and (|(z - [internal] stops.prev #1)| < [internal] vanishing radius)) and ([internal] fresh #26 < [internal] fresh #27)) then:
                                                          do-while (!([internal] stops.started #0 and (|(z - [internal] stops.prev #1)| < [internal] vanishing radius)) and ([internal] fresh #26 < [internal] fresh #27)):
                                                            block:
                                                              block:
                                                                set `[internal] stops.prev #1` := z
                                                                set `[internal] stops.started #0` := True
                                                                block:
                                                                  set `[internal] previous.z #0` := z
                                                                  block:
                                                                    set `z` := let [internal] newton.z #0 = z in ([internal] newton.z #0 - (let [internal] p.z #1 = [internal] newton.z #0 in ((([internal] p.z #1 - r1:R:C) * ([internal] p.z #1 - r2)) * ([internal] p.z #1 - r3)) / let [internal] p'.z #2 = [internal] newton.z #0 in ((([internal] p'.z #2 - r3) * (([internal] p'.z #2 - r2) + ([internal] p'.z #2 - r1:R:C))) + (([internal] p'.z #2 - r1:R:C) * ([internal] p'.z #2 - r2)))))
                                                                    draw point at ([internal] previous.z #0, 1.0 :+ 0.0)
                                                                    draw line from ([internal] previous.z #0, 1.0 :+ 0.0) to (z, 1.0 :+ 0.0)
                                                              set `[internal] fresh #26` := ([internal] fresh #26 + 1)
                                                        else:
                                                          no-op
                                                        set `[internal] iteration count` := [internal] fresh #26
                                                        set `[internal] stuck` := ([internal] fresh #26 = [internal] fresh #27)
                                  draw point at (z, 1.0 :+ 0.0)

  -- on deactivated
let `[internal] vanishing radius` = tol in:
  let `[internal] escape radius` = escape_radius in:
    let `[internal] iteration limit` = max_iters in:
      let `[internal] stuck` = False in:
        let `[internal] iteration count` = 0 in:
          let `pixel_size` = [internal] px in:
            block:
              erase


