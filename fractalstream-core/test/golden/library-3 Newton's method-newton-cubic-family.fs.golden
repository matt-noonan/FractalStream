--- tool Trace
  -- on click
let `[internal] vanishing radius` = tol in:
  let `[internal] escape radius` = escape_radius in:
    let `[internal] iteration limit` = max_iters in:
      let `[internal] stuck` = False in:
        let `[internal] iteration count` = 0 in:
          let `z` = ([internal] x:C + (0.0 :+ 1.0 * [internal] y:C)) in:
            let `pixel_size` = [internal] px in:
              block:
                let `r1` = 1 in:
                  block:
                    let `r2` = (-0.5:C + a) in:
                      block:
                        let `r3` = (-0.5:C - a) in:
                          block:
                            let `lastZ` = 0:R:C in:
                              block:
                                erase
                                let `[internal] fresh #20` = 0 in:
                                  let `[internal] fresh #21` = [internal] iteration limit in:
                                    block:
                                      if (!(|(z - lastZ)| < [internal] vanishing radius) and ([internal] fresh #20 < [internal] fresh #21)) then:
                                        do-while (!(|(z - lastZ)| < [internal] vanishing radius) and ([internal] fresh #20 < [internal] fresh #21)):
                                          block:
                                            block:
