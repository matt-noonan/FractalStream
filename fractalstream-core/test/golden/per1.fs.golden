                        do-while (!(|z| < [internal] vanishing radius) and ([internal] fresh #21 < [internal] fresh #22)):
                          block:
                            set `z` := let [internal] f.z #0 = z in ((λ * [internal] f.z #0) / ((([internal] f.z #0 ^ 2:R:C) + (t * [internal] f.z #0)) + 1:R:C))
                            set `[internal] fresh #21` := ([internal] fresh #21 + 1)
                      else:
                        no-op
