                          block:
                            if ((|z| < (10:R * escape_radius)) and ([internal] fresh #19 < [internal] fresh #20)) then:
                              do-while ((|z| < (10:R * escape_radius)) and ([internal] fresh #19 < [internal] fresh #20)):
