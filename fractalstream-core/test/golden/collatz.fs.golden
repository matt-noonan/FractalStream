                          if (!((|(z - 1:R:C)| < [internal] vanishing radius) or ((|(z - 0:R:C)| < [internal] vanishing radius) or ((|(z - -1:R:C)| < [internal] vanishing radius) or ((|(z - -5:R:C)| < [internal] vanishing radius) or ((|(z - -17:R:C)| < [internal] vanishing radius) or ([internal] escape radius < |z|)))))) and ([internal] fresh #29 < [internal] fresh #30)) then:
                            do-while (!((|(z - 1:R:C)| < [internal] vanishing radius) or ((|(z - 0:R:C)| < [internal] vanishing radius) or ((|(z - -1:R:C)| < [internal] vanishing radius) or ((|(z - -5:R:C)| < [internal] vanishing radius) or ((|(z - -17:R:C)| < [internal] vanishing radius) or ([internal] escape radius < |z|)))))) and ([internal] fresh #29 < [internal] fresh #30)):
                              block:
                                set `z` := let [internal] step.z #0 = z in let [internal] step.c #0 = C in ((([internal] step.z #0 / 2:R:C) * (cos(((3.141592653589793:C * [internal] step.z #0) / 2:R:C)) ^ 2:R:C)) + (((3:R:C * [internal] step.z #0) + [internal] step.c #0) * (sin(((3.141592653589793:C * [internal] step.z #0) / 2:R:C)) ^ 2:R:C)))
                                set `[internal] fresh #29` := ([internal] fresh #29 + 1)
                          else:
                            no-op
                          set `[internal] iteration count` := [internal] fresh #29
                          set `[internal] stuck` := ([internal] fresh #29 = [internal] fresh #30)
                    set `color` := Color 0 0 0
                    if (|(z - 1:R:C)| < [internal] vanishing radius) then:
                      block:
                        set `color` := Color 255 0 0
                    else:
