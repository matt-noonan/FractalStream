                                      set `[internal] stuck` := ([internal] fresh #32 = [internal] fresh #33)
                                if ([internal] escape radius < |w|) then:
                                  block:
                                    let `d` = d w/d z in:
                                      block:
                                        let `dbar` = bar(bar(dbar w/d z)) in:
                                          block:
                                            let `gradient` = (|((bar(w) * d) + (w * bar(dbar)))| / (|w| ^ 2:R)) in:
                                              block:
