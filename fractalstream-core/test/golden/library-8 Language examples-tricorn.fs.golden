                                                    set `dbar w/d z` := [internal] dbar w/d z
                                              set `w` := ((bar(w) ^ 2:R:C) + c)
                                            set `[internal] fresh #32` := ([internal] fresh #32 + 1)
                                      else:
                                        no-op
