=== viewer 3: c plane
--- once per render
let `color` = Color 128 128 128 in:
  let `[internal] dy` = 0.0 in:
    let `[internal] dx` = 0.0 in:
      let `[internal] y` = 0.0 in:
        let `[internal] x` = 0.0 in:
          let `[internal] vanishing radius` = vanishing_radius in:
            let `[internal] escape radius` = escape_radius in:
              let `[internal] iteration limit` = max_iters in:
                let `[internal] stuck` = False in:
                  let `[internal] iteration count` = 0 in:
                    block:
                      let `untried` = 0 in:
                        block:
                          let `continued` = 1 in:
                            block:
                              let `lost` = 2 in:
                                block:
                                  let `here` = 0:R:C in:
                                    block:
                                      let `status` = untried in:
                                        block:
                                          set `[hoisted] untried` := untried
                                          set `[hoisted] continued` := continued
                                          set `[hoisted] lost` := lost
                                          set `[hoisted] here` := here
                                          set `[hoisted] status` := status

--- body
let `[internal] vanishing radius` = vanishing_radius in:
  let `[internal] escape radius` = escape_radius in:
    let `[internal] iteration limit` = max_iters in:
      let `[internal] stuck` = False in:
        let `[internal] iteration count` = 0 in:
          block:
            set `c` := ([internal] x:C + (0.0 :+ 1.0 * [internal] y:C))
            let `pixel_size` = [internal] dx in:
              block:
                let `untried` = [hoisted] untried in:
                  block:
                    let `continued` = [hoisted] continued in:
                      block:
                        let `lost` = [hoisted] lost in:
                          block:
                            let `here` = [hoisted] here in:
                              block:
                                let `status` = [hoisted] status in:
                                  block:
                                    let `[internal] tuple #0` = table_size(crits) in:
                                      block:
                                        let `cols` = (1st [internal] tuple #0) in:
                                          block:
                                            let `rows` = (1st (2nd [internal] tuple #0)) in:
                                              block:
                                                let `layers` = (2nd (2nd [internal] tuple #0)) in:
                                                  block:
                                                    if (!(shown < 1) and !(layers < shown)) then:
                                                      block:
                                                        let `[internal] tuple #1` = if (c in crits) then (crits @ (point c, shown)) else (0:R:C, untried) in:
                                                          block:
                                                            set `here` := (1st [internal] tuple #1)
                                                            set `status` := (2nd [internal] tuple #1)
                                                    else:
                                                      no-op
                                                    if ((layers = 0) and let [internal] crosshair.z #0 = c in ((|(|[internal] crosshair.z #0| - 1:R)| < (2:R * pixel_size)) or ((|re([internal] crosshair.z #0)| < (2:R * pixel_size)) or (|im([internal] crosshair.z #0)| < (2:R * pixel_size))))) then:
                                                      block:
                                                        set `color` := Color 0 0 0
                                                    else:
                                                      if (status = continued) then:
                                                        block:
                                                          let `[internal] tuple #2` = let [internal] γc.z #0 = here in let [internal] γc.cc #0 = c in ((let [internal] pc.cc #1 = [internal] γc.cc #0 in (((1:R:C + a) + sqrt((((1:R:C + a) ^ 2:R:C) - (4:R:C * [internal] pc.cc #1)))) / 2:R:C) + ((zoom:C * [internal] γc.z #0) * (((2:R:C * let [internal] pc.cc #2 = [internal] γc.cc #0 in (((1:R:C + a) + sqrt((((1:R:C + a) ^ 2:R:C) - (4:R:C * [internal] pc.cc #2)))) / 2:R:C)) * let [internal] λc.cc #3 = [internal] γc.cc #0 in (let [internal] pc.cc #4 = [internal] λc.cc #3 in (((1:R:C + a) + sqrt((((1:R:C + a) ^ 2:R:C) - (4:R:C * [internal] pc.cc #4)))) / 2:R:C) + sqrt(((let [internal] pc.cc #5 = [internal] λc.cc #3 in (((1:R:C + a) + sqrt((((1:R:C + a) ^ 2:R:C) - (4:R:C * [internal] pc.cc #5)))) / 2:R:C) ^ 2:R:C) - a)))) - a))), (let [internal] pc.cc #6 = [internal] γc.cc #0 in (((1:R:C + a) + sqrt((((1:R:C + a) ^ 2:R:C) - (4:R:C * [internal] pc.cc #6)))) / 2:R:C) + (zoom:C * [internal] γc.z #0))) in:
                                                            block:
                                                              let `x` = (1st [internal] tuple #2) in:
                                                                block:
                                                                  let `y` = (2nd [internal] tuple #2) in:
                                                                    block:
                                                                      let `[internal] fresh #50` = 0 in:
                                                                        let `[internal] fresh #51` = [internal] iteration limit in:
                                                                          block:
                                                                            if (!let #tuple 0 = (x, y) in (([internal] escape radius * [internal] escape radius) < ((|(1st #tuple 0)| * |(1st #tuple 0)|) + (|(2nd #tuple 0)| * |(2nd #tuple 0)|))) and ([internal] fresh #50 < [internal] fresh #51)) then:
                                                                              do-while (!let #tuple 0 = (x, y) in (([internal] escape radius * [internal] escape radius) < ((|(1st #tuple 0)| * |(1st #tuple 0)|) + (|(2nd #tuple 0)| * |(2nd #tuple 0)|))) and ([internal] fresh #50 < [internal] fresh #51)):
                                                                                block:
                                                                                  block:
                                                                                    let `[internal] tuple #3` = let [internal] Hc.x #0 = x in let [internal] Hc.y #0 = y in let [internal] Hc.cc #0 = c in (((([internal] Hc.x #0 ^ 2:R:C) + [internal] Hc.cc #0) - (a * [internal] Hc.y #0)), [internal] Hc.x #0) in:
                                                                                      block:
                                                                                        set `x` := (1st [internal] tuple #3)
                                                                                        set `y` := (2nd [internal] tuple #3)
                                                                                  set `[internal] fresh #50` := ([internal] fresh #50 + 1)
                                                                            else:
                                                                              no-op
                                                                            set `[internal] iteration count` := [internal] fresh #50
                                                                            set `[internal] stuck` := ([internal] fresh #50 = [internal] fresh #51)
                                                                      set `color` := if [internal] stuck then Color 0 0 0 else let [internal] [std] rainbow.t #0 = ([internal] iteration count:R / 20:R) in let [internal] [std] wheel8.t #2 = [internal] [std] rainbow.t #0 in let [internal] [std] wheel8.c1 #2 = Color 255 0 0 in let [internal] [std] wheel8.c2 #2 = Color 255 100 0 in let [internal] [std] wheel8.c3 #2 = Color 255 255 0 in let [internal] [std] wheel8.c4 #2 = Color 0 180 0 in let [internal] [std] wheel8.c5 #2 = let [internal] [std] rgb255.r #1 = 0 in let [internal] [std] rgb255.g #1 = 128 in let [internal] [std] rgb255.b #1 = 128 in rgb(([internal] [std] rgb255.r #1:R / 255:R), ([internal] [std] rgb255.g #1:R / 255:R), ([internal] [std] rgb255.b #1:R / 255:R)) in let [internal] [std] wheel8.c6 #2 = Color 0 0 255 in let [internal] [std] wheel8.c7 #2 = Color 128 0 128 in let [internal] [std] wheel8.c8 #2 = Color 255 0 160 in let [internal] [std] wheel8_at.u #3 = ([internal] [std] wheel8.t #2 mod 1.0) in let [internal] [std] wheel8_at.c1 #3 = [internal] [std] wheel8.c1 #2 in let [internal] [std] wheel8_at.c2 #3 = [internal] [std] wheel8.c2 #2 in let [internal] [std] wheel8_at.c3 #3 = [internal] [std] wheel8.c3 #2 in let [internal] [std] wheel8_at.c4 #3 = [internal] [std] wheel8.c4 #2 in let [internal] [std] wheel8_at.c5 #3 = [internal] [std] wheel8.c5 #2 in let [internal] [std] wheel8_at.c6 #3 = [internal] [std] wheel8.c6 #2 in let [internal] [std] wheel8_at.c7 #3 = [internal] [std] wheel8.c7 #2 in let [internal] [std] wheel8_at.c8 #3 = [internal] [std] wheel8.c8 #2 in if ([internal] [std] wheel8_at.u #3 < 0.5) then let [internal] [std] wheel4_at.u #4 = [internal] [std] wheel8_at.u #3 in let [internal] [std] wheel4_at.lo #4 = 0.0 in let [internal] [std] wheel4_at.c1 #4 = [internal] [std] wheel8_at.c1 #3 in let [internal] [std] wheel4_at.c2 #4 = [internal] [std] wheel8_at.c2 #3 in let [internal] [std] wheel4_at.c3 #4 = [internal] [std] wheel8_at.c3 #3 in let [internal] [std] wheel4_at.c4 #4 = [internal] [std] wheel8_at.c4 #3 in let [internal] [std] wheel4_at.c5 #4 = [internal] [std] wheel8_at.c5 #3 in if ([internal] [std] wheel4_at.u #4 < ([internal] [std] wheel4_at.lo #4 + 0.25)) then let [internal] [std] wheel2_at.u #5 = [internal] [std] wheel4_at.u #4 in let [internal] [std] wheel2_at.lo #5 = [internal] [std] wheel4_at.lo #4 in let [internal] [std] wheel2_at.c1 #5 = [internal] [std] wheel4_at.c1 #4 in let [internal] [std] wheel2_at.c2 #5 = [internal] [std] wheel4_at.c2 #4 in let [internal] [std] wheel2_at.c3 #5 = [internal] [std] wheel4_at.c3 #4 in if ([internal] [std] wheel2_at.u #5 < ([internal] [std] wheel2_at.lo #5 + 0.125)) then blend((8:R * ([internal] [std] wheel2_at.u #5 - [internal] [std] wheel2_at.lo #5)), [internal] [std] wheel2_at.c1 #5, [internal] [std] wheel2_at.c2 #5) else blend((8:R * ([internal] [std] wheel2_at.u #5 - ([internal] [std] wheel2_at.lo #5 + 0.125))), [internal] [std] wheel2_at.c2 #5, [internal] [std] wheel2_at.c3 #5) else let [internal] [std] wheel2_at.u #6 = [internal] [std] wheel4_at.u #4 in let [internal] [std] wheel2_at.lo #6 = ([internal] [std] wheel4_at.lo #4 + 0.25) in let [internal] [std] wheel2_at.c1 #6 = [internal] [std] wheel4_at.c3 #4 in let [internal] [std] wheel2_at.c2 #6 = [internal] [std] wheel4_at.c4 #4 in let [internal] [std] wheel2_at.c3 #6 = [internal] [std] wheel4_at.c5 #4 in if ([internal] [std] wheel2_at.u #6 < ([internal] [std] wheel2_at.lo #6 + 0.125)) then blend((8:R * ([internal] [std] wheel2_at.u #6 - [internal] [std] wheel2_at.lo #6)), [internal] [std] wheel2_at.c1 #6, [internal] [std] wheel2_at.c2 #6) else blend((8:R * ([internal] [std] wheel2_at.u #6 - ([internal] [std] wheel2_at.lo #6 + 0.125))), [internal] [std] wheel2_at.c2 #6, [internal] [std] wheel2_at.c3 #6) else let [internal] [std] wheel4_at.u #7 = [internal] [std] wheel8_at.u #3 in let [internal] [std] wheel4_at.lo #7 = 0.5 in let [internal] [std] wheel4_at.c1 #7 = [internal] [std] wheel8_at.c5 #3 in let [internal] [std] wheel4_at.c2 #7 = [internal] [std] wheel8_at.c6 #3 in let [internal] [std] wheel4_at.c3 #7 = [internal] [std] wheel8_at.c7 #3 in let [internal] [std] wheel4_at.c4 #7 = [internal] [std] wheel8_at.c8 #3 in let [internal] [std] wheel4_at.c5 #7 = [internal] [std] wheel8_at.c1 #3 in if ([internal] [std] wheel4_at.u #7 < ([internal] [std] wheel4_at.lo #7 + 0.25)) then let [internal] [std] wheel2_at.u #8 = [internal] [std] wheel4_at.u #7 in let [internal] [std] wheel2_at.lo #8 = [internal] [std] wheel4_at.lo #7 in let [internal] [std] wheel2_at.c1 #8 = [internal] [std] wheel4_at.c1 #7 in let [internal] [std] wheel2_at.c2 #8 = [internal] [std] wheel4_at.c2 #7 in let [internal] [std] wheel2_at.c3 #8 = [internal] [std] wheel4_at.c3 #7 in if ([internal] [std] wheel2_at.u #8 < ([internal] [std] wheel2_at.lo #8 + 0.125)) then blend((8:R * ([internal] [std] wheel2_at.u #8 - [internal] [std] wheel2_at.lo #8)), [internal] [std] wheel2_at.c1 #8, [internal] [std] wheel2_at.c2 #8) else blend((8:R * ([internal] [std] wheel2_at.u #8 - ([internal] [std] wheel2_at.lo #8 + 0.125))), [internal] [std] wheel2_at.c2 #8, [internal] [std] wheel2_at.c3 #8) else let [internal] [std] wheel2_at.u #9 = [internal] [std] wheel4_at.u #7 in let [internal] [std] wheel2_at.lo #9 = ([internal] [std] wheel4_at.lo #7 + 0.25) in let [internal] [std] wheel2_at.c1 #9 = [internal] [std] wheel4_at.c3 #7 in let [internal] [std] wheel2_at.c2 #9 = [internal] [std] wheel4_at.c4 #7 in let [internal] [std] wheel2_at.c3 #9 = [internal] [std] wheel4_at.c5 #7 in if ([internal] [std] wheel2_at.u #9 < ([internal] [std] wheel2_at.lo #9 + 0.125)) then blend((8:R * ([internal] [std] wheel2_at.u #9 - [internal] [std] wheel2_at.lo #9)), [internal] [std] wheel2_at.c1 #9, [internal] [std] wheel2_at.c2 #9) else blend((8:R * ([internal] [std] wheel2_at.u #9 - ([internal] [std] wheel2_at.lo #9 + 0.125))), [internal] [std] wheel2_at.c2 #9, [internal] [std] wheel2_at.c3 #9)
