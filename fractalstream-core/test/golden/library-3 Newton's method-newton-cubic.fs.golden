=== viewer 0: Roots of f
--- once per render
let `color` = Color 128 128 128 in:
  let `[internal] dy` = 0.0 in:
    let `[internal] dx` = 0.0 in:
      let `[internal] y` = 0.0 in:
        let `[internal] x` = 0.0 in:
          let `[internal] vanishing radius` = tol in:
            let `[internal] escape radius` = escape_radius in:
              let `[internal] iteration limit` = max_iters in:
                let `[internal] stuck` = False in:
                  let `[internal] iteration count` = 0 in:
                    block:
                      let `lastZ` = 0:R:C in:
                        block:
                          set `[hoisted] lastZ` := lastZ

--- body
let `[internal] vanishing radius` = tol in:
  let `[internal] escape radius` = escape_radius in:
    let `[internal] iteration limit` = max_iters in:
      let `[internal] stuck` = False in:
        let `[internal] iteration count` = 0 in:
          let `z` = ([internal] x:C + (0.0 :+ 1.0 * [internal] y:C)) in:
            let `pixel_size` = [internal] dx in:
              if ([internal] sphere view and (1.0 < (([internal] x * [internal] x) + ([internal] y * [internal] y)))) then:
                set `color` := Color 48 48 48
              else:
                block:
                  if [internal] sphere view then:
                    block:
                      let `[internal] sphere.s` = sqrt((1.0 - (([internal] x * [internal] x) + ([internal] y * [internal] y)))) in:
                        block:
                          let `[internal] sphere.X` = (([internal] sphere rotation 11 * [internal] x) + (([internal] sphere rotation 12 * [internal] y) + ([internal] sphere rotation 13 * [internal] sphere.s))) in:
                            block:
                              let `[internal] sphere.Y` = (([internal] sphere rotation 21 * [internal] x) + (([internal] sphere rotation 22 * [internal] y) + ([internal] sphere rotation 23 * [internal] sphere.s))) in:
                                block:
                                  let `[internal] sphere.Z` = (([internal] sphere rotation 31 * [internal] x) + (([internal] sphere rotation 32 * [internal] y) + ([internal] sphere rotation 33 * [internal] sphere.s))) in:
                                    block:
                                      set `z` := (([internal] sphere.X:C + ([internal] sphere.Y:C * 0.0 :+ 1.0)) / (1.0 + [internal] sphere.Z):C)
                  else:
                    no-op
                  block:
                    let `lastZ` = [hoisted] lastZ in:
                      block:
                        let `[internal] fresh #32` = 0 in:
                          let `[internal] fresh #33` = [internal] iteration limit in:
                            block:
                              if (!(|(z - lastZ)| < [internal] vanishing radius) and ([internal] fresh #32 < [internal] fresh #33)) then:
                                do-while (!(|(z - lastZ)| < [internal] vanishing radius) and ([internal] fresh #32 < [internal] fresh #33)):
                                  block:
                                    block:
                                      set `lastZ` := z
                                      set `z` := let [internal] newton.z #0 = z in ([internal] newton.z #0 - (let [internal] f.z #1 = [internal] newton.z #0 in (([internal] f.z #1 ^ 3:R:C) - 1:R:C) / let [internal] f'.z #2 = [internal] newton.z #0 in (3:R:C * ([internal] f'.z #2 ^ 2:R:C))))
                                    set `[internal] fresh #32` := ([internal] fresh #32 + 1)
                              else:
                                no-op
                              set `[internal] iteration count` := [internal] fresh #32
                              set `[internal] stuck` := ([internal] fresh #32 = [internal] fresh #33)
                        if (|(z - lastZ)| < [internal] vanishing radius) then:
                          block:
                            set `color` := let #wheel-arg = ((arg(z) / (2:R * 3.141592653589793)) mod 1.0) in blend((1st if (#wheel-arg < (1.0 / 2.0)) then if (#wheel-arg < (1.0 / 4.0)) then if (#wheel-arg < (1.0 / 8.0)) then ((8.0 * (#wheel-arg - 0.0)), (Color 255 100 0, Color 255 0 0)) else ((8.0 * (#wheel-arg - 0.125)), (Color 255 255 0, Color 255 100 0)) else if (#wheel-arg < (3.0 / 8.0)) then ((8.0 * (#wheel-arg - 0.25)), (Color 0 180 0, Color 255 255 0)) else ((8.0 * (#wheel-arg - 0.375)), (Color 0 128 128, Color 0 180 0)) else if (#wheel-arg < (3.0 / 4.0)) then if (#wheel-arg < (5.0 / 8.0)) then ((8.0 * (#wheel-arg - 0.5)), (Color 0 0 255, Color 0 128 128)) else ((8.0 * (#wheel-arg - 0.625)), (Color 128 0 128, Color 0 0 255)) else if (#wheel-arg < (7.0 / 8.0)) then ((8.0 * (#wheel-arg - 0.75)), (Color 255 0 160, Color 128 0 128)) else ((8.0 * (#wheel-arg - 0.875)), (Color 255 0 0, Color 255 0 160))), (1st (2nd if (#wheel-arg < (1.0 / 2.0)) then if (#wheel-arg < (1.0 / 4.0)) then if (#wheel-arg < (1.0 / 8.0)) then ((8.0 * (#wheel-arg - 0.0)), (Color 255 100 0, Color 255 0 0)) else ((8.0 * (#wheel-arg - 0.125)), (Color 255 255 0, Color 255 100 0)) else if (#wheel-arg < (3.0 / 8.0)) then ((8.0 * (#wheel-arg - 0.25)), (Color 0 180 0, Color 255 255 0)) else ((8.0 * (#wheel-arg - 0.375)), (Color 0 128 128, Color 0 180 0)) else if (#wheel-arg < (3.0 / 4.0)) then if (#wheel-arg < (5.0 / 8.0)) then ((8.0 * (#wheel-arg - 0.5)), (Color 0 0 255, Color 0 128 128)) else ((8.0 * (#wheel-arg - 0.625)), (Color 128 0 128, Color 0 0 255)) else if (#wheel-arg < (7.0 / 8.0)) then ((8.0 * (#wheel-arg - 0.75)), (Color 255 0 160, Color 128 0 128)) else ((8.0 * (#wheel-arg - 0.875)), (Color 255 0 0, Color 255 0 160)))), (2nd (2nd if (#wheel-arg < (1.0 / 2.0)) then if (#wheel-arg < (1.0 / 4.0)) then if (#wheel-arg < (1.0 / 8.0)) then ((8.0 * (#wheel-arg - 0.0)), (Color 255 100 0, Color 255 0 0)) else ((8.0 * (#wheel-arg - 0.125)), (Color 255 255 0, Color 255 100 0)) else if (#wheel-arg < (3.0 / 8.0)) then ((8.0 * (#wheel-arg - 0.25)), (Color 0 180 0, Color 255 255 0)) else ((8.0 * (#wheel-arg - 0.375)), (Color 0 128 128, Color 0 180 0)) else if (#wheel-arg < (3.0 / 4.0)) then if (#wheel-arg < (5.0 / 8.0)) then ((8.0 * (#wheel-arg - 0.5)), (Color 0 0 255, Color 0 128 128)) else ((8.0 * (#wheel-arg - 0.625)), (Color 128 0 128, Color 0 0 255)) else if (#wheel-arg < (7.0 / 8.0)) then ((8.0 * (#wheel-arg - 0.75)), (Color 255 0 160, Color 128 0 128)) else ((8.0 * (#wheel-arg - 0.875)), (Color 255 0 0, Color 255 0 160)))))
                            set `color` := let #cycle-arg = (([internal] iteration count:R / 20:R) mod 1.0) in blend(if (#cycle-arg < (1.0 / 2.0)) then (2.0 * #cycle-arg) else (2.0 - (2.0 * #cycle-arg)), blend(0.333, Color 0 0 0, color), blend(0.333, Color 255 255 255, color))
                        else:
                          block:
                            set `color` := Color 0 0 0
                  if [internal] sphere view then:
                    block:
                      let `[internal] sphere.light` = ((((-0.48507125007266594 * [internal] x) + ((0.48507125007266594 * [internal] y) + (0.7276068751089989 * sqrt((1.0 - (([internal] x * [internal] x) + ([internal] y * [internal] y))))))) + 1.0) / 2.0) in:
                        block:
                          set `color` := blend((1.0 - ([internal] sphere shading * (1.0 - [internal] sphere.light))), color, Color 0 0 0)
                  else:
                    no-op


--- tool Trace
  -- on click
let `[internal] vanishing radius` = tol in:
  let `[internal] escape radius` = escape_radius in:
    let `[internal] iteration limit` = max_iters in:
      let `[internal] stuck` = False in:
        let `[internal] iteration count` = 0 in:
          let `z` = ([internal] x:C + (0.0 :+ 1.0 * [internal] y:C)) in:
            let `pixel_size` = [internal] px in:
              block:
                erase
                block:
                  let `[internal] previous.z #0` = z in:
                    block:
                      block:
                        let `[internal] stops.prev #1` = z in:
                          block:
                            let `[internal] stops.started #0` = False in:
                              block:
                                let `[internal] fresh #18` = 0 in:
                                  let `[internal] fresh #19` = [internal] iteration limit in:
                                    block:
                                      if (!([internal] stops.started #0 and (|(z - [internal] stops.prev #1)| < [internal] vanishing radius)) and ([internal] fresh #18 < [internal] fresh #19)) then:
                                        do-while (!([internal] stops.started #0 and (|(z - [internal] stops.prev #1)| < [internal] vanishing radius)) and ([internal] fresh #18 < [internal] fresh #19)):
                                          block:
                                            block:
                                              set `[internal] stops.prev #1` := z
                                              set `[internal] stops.started #0` := True
                                              block:
                                                set `[internal] previous.z #0` := z
                                                block:
                                                  set `z` := let [internal] newton.z #0 = z in ([internal] newton.z #0 - (let [internal] f.z #1 = [internal] newton.z #0 in (([internal] f.z #1 ^ 3:R:C) - 1:R:C) / let [internal] f'.z #2 = [internal] newton.z #0 in (3:R:C * ([internal] f'.z #2 ^ 2:R:C))))
                                                  draw point at [internal] previous.z #0:R^2
                                                  draw line from [internal] previous.z #0:R^2 to z:R^2
                                            set `[internal] fresh #18` := ([internal] fresh #18 + 1)
                                      else:
                                        no-op
                                      set `[internal] iteration count` := [internal] fresh #18
                                      set `[internal] stuck` := ([internal] fresh #18 = [internal] fresh #19)
                draw point at z:R^2

  -- on drag
let `[internal] vanishing radius` = tol in:
  let `[internal] escape radius` = escape_radius in:
    let `[internal] iteration limit` = max_iters in:
      let `[internal] stuck` = False in:
        let `[internal] iteration count` = 0 in:
          let `z` = ([internal] x:C + (0.0 :+ 1.0 * [internal] y:C)) in:
            let `[unused] start` = ([internal] oldx:C + (0.0 :+ 1.0 * [internal] oldy:C)) in:
              let `pixel_size` = [internal] px in:
                block:
                  erase
                  block:
                    let `[internal] previous.z #0` = z in:
                      block:
                        block:
                          let `[internal] stops.prev #1` = z in:
                            block:
                              let `[internal] stops.started #0` = False in:
                                block:
                                  let `[internal] fresh #21` = 0 in:
                                    let `[internal] fresh #22` = [internal] iteration limit in:
                                      block:
                                        if (!([internal] stops.started #0 and (|(z - [internal] stops.prev #1)| < [internal] vanishing radius)) and ([internal] fresh #21 < [internal] fresh #22)) then:
                                          do-while (!([internal] stops.started #0 and (|(z - [internal] stops.prev #1)| < [internal] vanishing radius)) and ([internal] fresh #21 < [internal] fresh #22)):
                                            block:
                                              block:
                                                set `[internal] stops.prev #1` := z
                                                set `[internal] stops.started #0` := True
                                                block:
                                                  set `[internal] previous.z #0` := z
                                                  block:
                                                    set `z` := let [internal] newton.z #0 = z in ([internal] newton.z #0 - (let [internal] f.z #1 = [internal] newton.z #0 in (([internal] f.z #1 ^ 3:R:C) - 1:R:C) / let [internal] f'.z #2 = [internal] newton.z #0 in (3:R:C * ([internal] f'.z #2 ^ 2:R:C))))
                                                    draw point at [internal] previous.z #0:R^2
                                                    draw line from [internal] previous.z #0:R^2 to z:R^2
                                              set `[internal] fresh #21` := ([internal] fresh #21 + 1)
                                        else:
                                          no-op
                                        set `[internal] iteration count` := [internal] fresh #21
                                        set `[internal] stuck` := ([internal] fresh #21 = [internal] fresh #22)
                  draw point at z:R^2

  -- on deactivated
let `[internal] vanishing radius` = tol in:
  let `[internal] escape radius` = escape_radius in:
    let `[internal] iteration limit` = max_iters in:
      let `[internal] stuck` = False in:
        let `[internal] iteration count` = 0 in:
          let `pixel_size` = [internal] px in:
            block:
              erase


