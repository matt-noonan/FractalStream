--- tool Trace
  -- on click
let `[internal] vanishing radius` = tol in:
  let `[internal] escape radius` = escape_radius in:
    let `[internal] iteration limit` = max_iters in:
      let `[internal] stuck` = False in:
        let `[internal] iteration count` = 0 in:
          let `[internal] click` = [internal] point a in:
            let `pixel_size` = [internal] px in:
              block:
                let `z` = [internal] click in:
                  block:
                    erase
                    block:
                      let `[internal] previous.z #0` = z in:
                        block:
                          block:
                            let `[internal] stops.prev #1` = z in:
                              block:
                                let `[internal] stops.started #0` = False in:
                                  block:
                                    let `[internal] fresh #19` = 0 in:
                                      let `[internal] fresh #20` = [internal] iteration limit in:
                                        block:
                                          if (!([internal] stops.started #0 and (|(z - [internal] stops.prev #1)| < [internal] vanishing radius)) and ([internal] fresh #19 < [internal] fresh #20)) then:
                                            do-while (!([internal] stops.started #0 and (|(z - [internal] stops.prev #1)| < [internal] vanishing radius)) and ([internal] fresh #19 < [internal] fresh #20)):
                                              block:
                                                block:
                                                  set `[internal] stops.prev #1` := z
                                                  set `[internal] stops.started #0` := True
                                                  block:
                                                    set `[internal] previous.z #0` := z
                                                    block:
                                                      set `z` := let [internal] newton.z #0 = z in ([internal] newton.z #0 - (let [internal] f.z #1 = [internal] newton.z #0 in (([internal] f.z #1 ^ 3:R:C) - 1:R:C) / let [internal] f'.z #2 = [internal] newton.z #0 in (3:R:C * ([internal] f'.z #2 ^ 2:R:C))))
                                                      draw point at ([internal] previous.z #0, 1.0 :+ 0.0)
                                                      draw line from ([internal] previous.z #0, 1.0 :+ 0.0) to (z, 1.0 :+ 0.0)
                                                set `[internal] fresh #19` := ([internal] fresh #19 + 1)
                                          else:
                                            no-op
                                          set `[internal] iteration count` := [internal] fresh #19
                                          set `[internal] stuck` := ([internal] fresh #19 = [internal] fresh #20)
                    draw point at (z, 1.0 :+ 0.0)

  -- on drag
let `[internal] vanishing radius` = tol in:
  let `[internal] escape radius` = escape_radius in:
    let `[internal] iteration limit` = max_iters in:
      let `[internal] stuck` = False in:
        let `[internal] iteration count` = 0 in:
          let `[internal] click` = [internal] point a in:
            let `[unused] drag start` = [internal] old point a in:
              let `pixel_size` = [internal] px in:
                block:
                  let `z` = [internal] click in:
                    block:
                      erase
                      block:
                        let `[internal] previous.z #0` = z in:
                          block:
                            block:
                              let `[internal] stops.prev #1` = z in:
                                block:
                                  let `[internal] stops.started #0` = False in:
                                    block:
                                      let `[internal] fresh #22` = 0 in:
                                        let `[internal] fresh #23` = [internal] iteration limit in:
                                          block:
                                            if (!([internal] stops.started #0 and (|(z - [internal] stops.prev #1)| < [internal] vanishing radius)) and ([internal] fresh #22 < [internal] fresh #23)) then:
                                              do-while (!([internal] stops.started #0 and (|(z - [internal] stops.prev #1)| < [internal] vanishing radius)) and ([internal] fresh #22 < [internal] fresh #23)):
                                                block:
                                                  block:
                                                    set `[internal] stops.prev #1` := z
                                                    set `[internal] stops.started #0` := True
                                                    block:
                                                      set `[internal] previous.z #0` := z
                                                      block:
                                                        set `z` := let [internal] newton.z #0 = z in ([internal] newton.z #0 - (let [internal] f.z #1 = [internal] newton.z #0 in (([internal] f.z #1 ^ 3:R:C) - 1:R:C) / let [internal] f'.z #2 = [internal] newton.z #0 in (3:R:C * ([internal] f'.z #2 ^ 2:R:C))))
                                                        draw point at ([internal] previous.z #0, 1.0 :+ 0.0)
                                                        draw line from ([internal] previous.z #0, 1.0 :+ 0.0) to (z, 1.0 :+ 0.0)
                                                  set `[internal] fresh #22` := ([internal] fresh #22 + 1)
                                            else:
                                              no-op
                                            set `[internal] iteration count` := [internal] fresh #22
                                            set `[internal] stuck` := ([internal] fresh #22 = [internal] fresh #23)
                      draw point at (z, 1.0 :+ 0.0)

  -- on deactivated
let `[internal] vanishing radius` = tol in:
  let `[internal] escape radius` = escape_radius in:
    let `[internal] iteration limit` = max_iters in:
      let `[internal] stuck` = False in:
        let `[internal] iteration count` = 0 in:
          let `pixel_size` = [internal] px in:
            block:
              erase


