--- tool Trace
  -- on click
let `[internal] vanishing radius` = minRadius in:
  let `[internal] escape radius` = maxRadius in:
    let `[internal] iteration limit` = maxIters in:
      let `[internal] stuck` = False in:
        let `[internal] iteration count` = 0 in:
          let `[internal] click` = [internal] point a in:
            let `pixel_size` = [internal] px in:
              block:
                let `z` = [internal] click in:
                  block:
                    set `start` := z
                    block:
                      let `[internal] trace.initial_last #0` = z in:
                        block:
                          block:
                            let `w` = z in:
                              block:
                                erase
                                let `[internal] fresh #25` = 0 in:
                                  let `[internal] fresh #26` = [internal] iteration limit in:
                                    block:
                                      do-while (!((||(z - w)|| < [internal] vanishing radius) or ([internal] escape radius < |z|)) and ([internal] fresh #25 < [internal] fresh #26)):
                                        block:
                                          block:
                                            set `z` := let [internal] f.z #0 = z in (([internal] f.z #0 ^ 2:R:C) + c)
                                            set `w` := let [internal] f2.w #0 = w in let [internal] [internal] ∘.composition #1.[internal] f.z #2 @3:10 = [internal] f2.w #0 in let [internal] [internal] ∘.applied #4.[internal] f.z #3 @3:10 = let [internal] f.z #5 = [internal] [internal] ∘.composition #1.[internal] f.z #2 @3:10 in (([internal] f.z #5 ^ 2:R:C) + c) in let [internal] f.z #6 = [internal] [internal] ∘.applied #4.[internal] f.z #3 @3:10 in (([internal] f.z #6 ^ 2:R:C) + c)
                                          set `[internal] fresh #25` := ([internal] fresh #25 + 1)
                                      set `[internal] iteration count` := [internal] fresh #25
                                      set `[internal] stuck` := ([internal] fresh #25 = [internal] fresh #26)
                                if (||(z - w)|| < [internal] vanishing radius) then:
                                  block:
                                    set `z` := [internal] trace.initial_last #0
                                    block:
                                      let `[internal] previous.z #0` = z in:
                                        block:
                                          let `[internal] fresh #26` = 0 in:
                                            let `[internal] fresh #27` = [internal] iteration limit in:
                                              block:
                                                if (!(||(z - w)|| < [internal] vanishing radius) and ([internal] fresh #26 < [internal] fresh #27)) then:
                                                  do-while (!(||(z - w)|| < [internal] vanishing radius) and ([internal] fresh #26 < [internal] fresh #27)):
                                                    block:
