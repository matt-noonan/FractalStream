=== viewer 0: Parameter space
--- once per render
let `color` = Color 128 128 128 in:
  let `[internal] dy` = 0.0 in:
    let `[internal] dx` = 0.0 in:
      let `[internal] y` = 0.0 in:
        let `[internal] x` = 0.0 in:
          let `[internal] vanishing radius` = minRadius in:
            let `[internal] escape radius` = maxRadius in:
              let `[internal] iteration limit` = maxIters in:
                let `[internal] stuck` = False in:
                  let `[internal] iteration count` = 0 in:
                    block:
                      let `degree` = 2 in:
                        block:
                          let `[internal] draw_rays.dynamical #0` = False in:
                            block:
                              set `[hoisted] degree` := degree
                              set `[hoisted] [internal] draw_rays.dynamical #0` := [internal] draw_rays.dynamical #0

--- body
let `[internal] vanishing radius` = minRadius in:
  let `[internal] escape radius` = maxRadius in:
    let `[internal] iteration limit` = maxIters in:
      let `[internal] stuck` = False in:
        let `[internal] iteration count` = 0 in:
          block:
            set `c` := ([internal] x:C + (0.0 :+ 1.0 * [internal] y:C))
            let `pixel_size` = [internal] dx in:
              block:
                let `degree` = [hoisted] degree in:
                  block:
                    let `[internal] draw_rays.dynamical #0` = [hoisted] [internal] draw_rays.dynamical #0 in:
                      block:
                        let `z` = let [internal] critical_point.c #0 = c in 0:R:C in:
                          block:
                            let `w` = z in:
                              block:
                                let `z0` = z in:
                                  block:
                                    let `[internal] fresh #32` = 0 in:
                                      let `[internal] fresh #33` = [internal] iteration limit in:
                                        block:
                                          do-while (!((||(z - w)|| < [internal] vanishing radius) or ([internal] escape radius < |z|)) and ([internal] fresh #32 < [internal] fresh #33)):
                                            block:
                                              block:
                                                set `z` := let [internal] f.z #0 = z in (([internal] f.z #0 ^ 2:R:C) + c)
                                                set `w` := let [internal] f2.w #0 = w in (((([internal] f2.w #0 ^ 2:R:C) + c) ^ 2:R:C) + c)
                                              set `[internal] fresh #32` := ([internal] fresh #32 + 1)
                                          set `[internal] iteration count` := [internal] fresh #32
                                          set `[internal] stuck` := ([internal] fresh #32 = [internal] fresh #33)
                                    if [internal] stuck then:
                                      block:
                                        set `color` := Color 0 0 0
                                    else:
                                      if ([internal] escape radius < |z|) then:
                                        block:
                                          set `color` := if (0:R < im(z)) then Color 0 0 255 else Color 255 255 0
                                          let `s` = (([internal] iteration count + 1):R - (log(log(|z|)) / log(degree:R))) in:
                                            block:
                                              set `color` := blend((cos((s * 3.141592653589793)) ^ 2:R), let [internal] [std] light.c #0 = color in blend(0.333, Color 255 255 255, [internal] [std] light.c #0), let [internal] [std] dark.c #1 = color in blend(0.333, Color 0 0 0, [internal] [std] dark.c #1))
                                      else:
                                        block:
                                          let `λ` = 1:R:C in:
                                            block:
                                              let `[internal] fresh #33` = 0 in:
                                                let `[internal] fresh #34` = [internal] iteration limit in:
                                                  block:
                                                    do-while (!(||(z - w)|| < [internal] vanishing radius) and ([internal] fresh #33 < [internal] fresh #34)):
                                                      block:
                                                        block:
                                                          set `z` := let [internal] f.z #0 = z in (([internal] f.z #0 ^ 2:R:C) + c)
                                                          set `λ` := (let [internal] f'.z #0 = z in (2:R:C * [internal] f'.z #0) * λ)
                                                        set `[internal] fresh #33` := ([internal] fresh #33 + 1)
                                                    set `[internal] iteration count` := [internal] fresh #33
                                                    set `[internal] stuck` := ([internal] fresh #33 = [internal] fresh #34)
                                              let `period` = [internal] iteration count in:
                                                block:
                                                  let `counter` = 0 in:
                                                    block:
                                                      let `[internal] fresh #35` = 0 in:
                                                        let `[internal] fresh #36` = [internal] iteration limit in:
                                                          block:
                                                            if ((counter < (extra_iterations * period)) and ([internal] fresh #35 < [internal] fresh #36)) then:
                                                              do-while ((counter < (extra_iterations * period)) and ([internal] fresh #35 < [internal] fresh #36)):
                                                                block:
                                                                  block:
                                                                    set `w` := let [internal] f2.w #0 = w in (((([internal] f2.w #0 ^ 2:R:C) + c) ^ 2:R:C) + c)
                                                                    set `counter` := (counter + 1)
                                                                  set `[internal] fresh #35` := ([internal] fresh #35 + 1)
                                                            else:
                                                              no-op
                                                            set `[internal] iteration count` := [internal] fresh #35
                                                            set `[internal] stuck` := ([internal] fresh #35 = [internal] fresh #36)
                                                      set `z` := z0
                                                      let `[internal] fresh #35` = 0 in:
                                                        let `[internal] fresh #36` = [internal] iteration limit in:
                                                          block:
                                                            if (!(||(z - w)|| < [internal] vanishing radius) and ([internal] fresh #35 < [internal] fresh #36)) then:
                                                              do-while (!(||(z - w)|| < [internal] vanishing radius) and ([internal] fresh #35 < [internal] fresh #36)):
                                                                block:
                                                                  block:
                                                                    set `z` := let [internal] f.z #0 = z in (([internal] f.z #0 ^ 2:R:C) + c)
                                                                  set `[internal] fresh #35` := ([internal] fresh #35 + 1)
                                                            else:
