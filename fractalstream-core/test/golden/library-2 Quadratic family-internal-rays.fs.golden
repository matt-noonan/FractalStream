=== viewer 0: Parameter space
--- body
let `[internal] vanishing radius` = minRadius in:
  let `[internal] escape radius` = maxRadius in:
    let `[internal] iteration limit` = maxIters in:
      let `[internal] stuck` = False in:
        let `[internal] iteration count` = 0 in:
          block:
            set `c` := ([internal] x:C + (0.0 :+ 1.0 * [internal] y:C))
            let `pixel_size` = [internal] dx in:
              if ([internal] sphere view and (1.0 < (([internal] x * [internal] x) + ([internal] y * [internal] y)))) then:
                set `color` := Color 48 48 48
              else:
                block:
                  if [internal] sphere view then:
                    block:
                      let `[internal] sphere.s` = sqrt((1.0 - (([internal] x * [internal] x) + ([internal] y * [internal] y)))) in:
                        block:
                          let `[internal] sphere.X` = (([internal] sphere rotation 11 * [internal] x) + (([internal] sphere rotation 12 * [internal] y) + ([internal] sphere rotation 13 * [internal] sphere.s))) in:
                            block:
                              let `[internal] sphere.Y` = (([internal] sphere rotation 21 * [internal] x) + (([internal] sphere rotation 22 * [internal] y) + ([internal] sphere rotation 23 * [internal] sphere.s))) in:
                                block:
                                  let `[internal] sphere.Z` = (([internal] sphere rotation 31 * [internal] x) + (([internal] sphere rotation 32 * [internal] y) + ([internal] sphere rotation 33 * [internal] sphere.s))) in:
                                    block:
                                      set `c` := (([internal] sphere.X:C + ([internal] sphere.Y:C * 0.0 :+ 1.0)) / (1.0 + [internal] sphere.Z):C)
                  else:
                    no-op
                  block:
                    let `degree` = 2 in:
                      block:
                        let `z` = let [internal] critical_point.c #0 = c in 0:R:C in:
                          block:
                            let `w` = z in:
                              block:
                                let `z0` = z in:
                                  block:
                                    block:
                                      let `[internal] draw_rays.dynamical #0` = False in:
                                        block:
                                          block:
                                            let `[internal] fresh #41` = 0 in:
                                              let `[internal] fresh #42` = [internal] iteration limit in:
                                                block:
                                                  do-while (!((||(z - w)|| < [internal] vanishing radius) or ([internal] escape radius < |z|)) and ([internal] fresh #41 < [internal] fresh #42)):
                                                    block:
                                                      block:
                                                        set `z` := let [internal] f.z #0 = z in (([internal] f.z #0 ^ 2:R:C) + c)
                                                        set `w` := let [internal] f2.w #0 = w in (((([internal] f2.w #0 ^ 2:R:C) + c) ^ 2:R:C) + c)
                                                      set `[internal] fresh #41` := ([internal] fresh #41 + 1)
                                                  set `[internal] iteration count` := [internal] fresh #41
                                                  set `[internal] stuck` := ([internal] fresh #41 = [internal] fresh #42)
                                            if [internal] stuck then:
                                              block:
                                                set `color` := Color 0 0 0
                                            else:
                                              if ([internal] escape radius < |z|) then:
                                                block:
                                                  set `color` := if (0:R < im(z)) then Color 0 0 255 else Color 255 255 0
                                                  let `s` = (([internal] iteration count + 1):R - (log(log(|z|)) / log(degree:R))) in:
                                                    block:
                                                      set `color` := blend((cos((s * 3.141592653589793)) ^ 2:R), blend(0.333, Color 255 255 255, color), blend(0.333, Color 0 0 0, color))
                                              else:
                                                block:
                                                  let `λ` = 1:R:C in:
                                                    block:
                                                      let `[internal] fresh #42` = 0 in:
                                                        let `[internal] fresh #43` = [internal] iteration limit in:
                                                          block:
                                                            do-while (!(||(z - w)|| < [internal] vanishing radius) and ([internal] fresh #42 < [internal] fresh #43)):
                                                              block:
                                                                block:
                                                                  set `z` := let [internal] f.z #0 = z in (([internal] f.z #0 ^ 2:R:C) + c)
                                                                  set `λ` := (let [internal] f'.z #0 = z in (2:R:C * [internal] f'.z #0) * λ)
                                                                set `[internal] fresh #42` := ([internal] fresh #42 + 1)
                                                            set `[internal] iteration count` := [internal] fresh #42
                                                            set `[internal] stuck` := ([internal] fresh #42 = [internal] fresh #43)
                                                      let `period` = [internal] iteration count in:
                                                        block:
                                                          let `counter` = 0 in:
                                                            block:
                                                              let `[internal] fresh #44` = 0 in:
                                                                let `[internal] fresh #45` = [internal] iteration limit in:
                                                                  block:
                                                                    if ((counter < (extra_iterations * period)) and ([internal] fresh #44 < [internal] fresh #45)) then:
                                                                      do-while ((counter < (extra_iterations * period)) and ([internal] fresh #44 < [internal] fresh #45)):
                                                                        block:
                                                                          block:
                                                                            set `w` := let [internal] f2.w #0 = w in (((([internal] f2.w #0 ^ 2:R:C) + c) ^ 2:R:C) + c)
                                                                            set `counter` := (counter + 1)
                                                                          set `[internal] fresh #44` := ([internal] fresh #44 + 1)
                                                                    else:
                                                                      no-op
                                                                    set `[internal] iteration count` := [internal] fresh #44
                                                                    set `[internal] stuck` := ([internal] fresh #44 = [internal] fresh #45)
                                                              set `z` := z0
                                                              let `[internal] fresh #44` = 0 in:
                                                                let `[internal] fresh #45` = [internal] iteration limit in:
                                                                  block:
                                                                    if (!(||(z - w)|| < [internal] vanishing radius) and ([internal] fresh #44 < [internal] fresh #45)) then:
                                                                      do-while (!(||(z - w)|| < [internal] vanishing radius) and ([internal] fresh #44 < [internal] fresh #45)):
                                                                        block:
                                                                          block:
                                                                            set `z` := let [internal] f.z #0 = z in (([internal] f.z #0 ^ 2:R:C) + c)
                                                                          set `[internal] fresh #44` := ([internal] fresh #44 + 1)
                                                                    else:
                                                                      no-op
                                                                    set `[internal] iteration count` := [internal] fresh #44
                                                                    set `[internal] stuck` := ([internal] fresh #44 = [internal] fresh #45)
                                                              let `preperiod` = [internal] iteration count in:
                                                                block:
                                                                  let `s` = (preperiod:R / period:R) in:
                                                                    block:
                                                                      let `θ` = if [internal] draw_rays.dynamical #0 then (arg((z - w)) - (s * arg(λ))) else arg(λ) in:
                                                                        block:
                                                                          let `pθ` = ((θ / (2:R * 3.141592653589793)) mod 1:R) in:
                                                                            block:
                                                                              if continuous then:
                                                                                block:
                                                                                  set `color` := let #wheel-arg = (((pθ * den:R) mod 1:R) mod 1.0) in blend((1st if (#wheel-arg < (1.0 / 2.0)) then if (#wheel-arg < (1.0 / 4.0)) then if (#wheel-arg < (1.0 / 8.0)) then ((8.0 * (#wheel-arg - 0.0)), (Color 255 100 0, Color 255 0 0)) else ((8.0 * (#wheel-arg - 0.125)), (Color 255 255 0, Color 255 100 0)) else if (#wheel-arg < (3.0 / 8.0)) then ((8.0 * (#wheel-arg - 0.25)), (Color 0 180 0, Color 255 255 0)) else ((8.0 * (#wheel-arg - 0.375)), (Color 0 128 128, Color 0 180 0)) else if (#wheel-arg < (3.0 / 4.0)) then if (#wheel-arg < (5.0 / 8.0)) then ((8.0 * (#wheel-arg - 0.5)), (Color 0 0 255, Color 0 128 128)) else ((8.0 * (#wheel-arg - 0.625)), (Color 128 0 128, Color 0 0 255)) else if (#wheel-arg < (7.0 / 8.0)) then ((8.0 * (#wheel-arg - 0.75)), (Color 255 0 160, Color 128 0 128)) else ((8.0 * (#wheel-arg - 0.875)), (Color 255 0 0, Color 255 0 160))), (1st (2nd if (#wheel-arg < (1.0 / 2.0)) then if (#wheel-arg < (1.0 / 4.0)) then if (#wheel-arg < (1.0 / 8.0)) then ((8.0 * (#wheel-arg - 0.0)), (Color 255 100 0, Color 255 0 0)) else ((8.0 * (#wheel-arg - 0.125)), (Color 255 255 0, Color 255 100 0)) else if (#wheel-arg < (3.0 / 8.0)) then ((8.0 * (#wheel-arg - 0.25)), (Color 0 180 0, Color 255 255 0)) else ((8.0 * (#wheel-arg - 0.375)), (Color 0 128 128, Color 0 180 0)) else if (#wheel-arg < (3.0 / 4.0)) then if (#wheel-arg < (5.0 / 8.0)) then ((8.0 * (#wheel-arg - 0.5)), (Color 0 0 255, Color 0 128 128)) else ((8.0 * (#wheel-arg - 0.625)), (Color 128 0 128, Color 0 0 255)) else if (#wheel-arg < (7.0 / 8.0)) then ((8.0 * (#wheel-arg - 0.75)), (Color 255 0 160, Color 128 0 128)) else ((8.0 * (#wheel-arg - 0.875)), (Color 255 0 0, Color 255 0 160)))), (2nd (2nd if (#wheel-arg < (1.0 / 2.0)) then if (#wheel-arg < (1.0 / 4.0)) then if (#wheel-arg < (1.0 / 8.0)) then ((8.0 * (#wheel-arg - 0.0)), (Color 255 100 0, Color 255 0 0)) else ((8.0 * (#wheel-arg - 0.125)), (Color 255 255 0, Color 255 100 0)) else if (#wheel-arg < (3.0 / 8.0)) then ((8.0 * (#wheel-arg - 0.25)), (Color 0 180 0, Color 255 255 0)) else ((8.0 * (#wheel-arg - 0.375)), (Color 0 128 128, Color 0 180 0)) else if (#wheel-arg < (3.0 / 4.0)) then if (#wheel-arg < (5.0 / 8.0)) then ((8.0 * (#wheel-arg - 0.5)), (Color 0 0 255, Color 0 128 128)) else ((8.0 * (#wheel-arg - 0.625)), (Color 128 0 128, Color 0 0 255)) else if (#wheel-arg < (7.0 / 8.0)) then ((8.0 * (#wheel-arg - 0.75)), (Color 255 0 160, Color 128 0 128)) else ((8.0 * (#wheel-arg - 0.875)), (Color 255 0 0, Color 255 0 160)))))
                                                                              else:
                                                                                block:
                                                                                  set `color` := if ((0.5 / den:R) < (pθ mod (1:R / den:R))) then Color 255 0 0 else rgb(0:R, 1:R, 1:R)
                                                                              let `s_adjusted` = ((s + 1:R) - (log(|(z - w)|) / log(|λ|))) in:
                                                                                block:
                                                                                  set `color` := blend((cos((s_adjusted * 3.141592653589793)) ^ 2:R), blend(0.333, Color 255 255 255, color), blend(0.333, Color 0 0 0, color))
                  if [internal] sphere view then:
                    block:
                      let `[internal] sphere.light` = ((((-0.48507125007266594 * [internal] x) + ((0.48507125007266594 * [internal] y) + (0.7276068751089989 * sqrt((1.0 - (([internal] x * [internal] x) + ([internal] y * [internal] y))))))) + 1.0) / 2.0) in:
                        block:
                          set `color` := blend((1.0 - ([internal] sphere shading * (1.0 - [internal] sphere.light))), color, Color 0 0 0)
                  else:
                    no-op


