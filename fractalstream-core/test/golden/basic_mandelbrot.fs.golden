=== viewer 0: Mandelbrot set
--- once per render
let `color` = Color 128 128 128 in:
  let `[internal] dy` = 0.0 in:
    let `[internal] dx` = 0.0 in:
      let `[internal] y` = 0.0 in:
        let `[internal] x` = 0.0 in:
          let `[internal] vanishing radius` = vanishing_radius in:
            let `[internal] escape radius` = escape_radius in:
              let `[internal] iteration limit` = max_iters in:
                let `[internal] stuck` = False in:
                  let `[internal] iteration count` = 0 in:
                    block:
                      let `z` = 0:R:C in:
                        block:
                          set `[hoisted] z` := z

--- body
let `[internal] vanishing radius` = vanishing_radius in:
  let `[internal] escape radius` = escape_radius in:
    let `[internal] iteration limit` = max_iters in:
      let `[internal] stuck` = False in:
        let `[internal] iteration count` = 0 in:
          let `C` = ([internal] x:C + (0.0 :+ 1.0 * [internal] y:C)) in:
            let `pixel_size` = [internal] dx in:
              block:
                let `z` = [hoisted] z in:
                  block:
                    let `[internal] fresh #20` = 0 in:
                      let `[internal] fresh #21` = [internal] iteration limit in:
                        block:
                          if (!([internal] escape radius < |z|) and ([internal] fresh #20 < [internal] fresh #21)) then:
                            do-while (!([internal] escape radius < |z|) and ([internal] fresh #20 < [internal] fresh #21)):
                              block:
                                set `z` := ((z ^ 2:R:C) + C)
                                set `[internal] fresh #20` := ([internal] fresh #20 + 1)
                          else:
                            no-op
                          set `[internal] iteration count` := [internal] fresh #20
                          set `[internal] stuck` := ([internal] fresh #20 = [internal] fresh #21)
                    if ([internal] escape radius < |z|) then:
                      block:
                        set `color` := let [internal] [std] cycle.t #0 = ([internal] iteration count:R / 20:R) in let [internal] [std] cycle.c1 #0 = Color 255 0 0 in let [internal] [std] cycle.c2 #0 = Color 255 255 0 in let [internal] [std] cycle_at.s #1 = ([internal] [std] cycle.t #0 mod 1.0) in let [internal] [std] cycle_at.c1 #1 = [internal] [std] cycle.c1 #0 in let [internal] [std] cycle_at.c2 #1 = [internal] [std] cycle.c2 #0 in blend(if ([internal] [std] cycle_at.s #1 < 0.5) then (2:R * [internal] [std] cycle_at.s #1) else (2:R - (2:R * [internal] [std] cycle_at.s #1)), [internal] [std] cycle_at.c1 #1, [internal] [std] cycle_at.c2 #1)
                    else:
                      block:
                        set `color` := Color 0 0 0


