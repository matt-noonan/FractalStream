                                                    set `color` := Color 128 0 128
                                                else:
                                                  block:
                                                    set `color` := let #wheel-arg = ((iters1:R / 20:R) mod 1.0) in blend((1st if (#wheel-arg < (1.0 / 2.0)) then if (#wheel-arg < (1.0 / 4.0)) then if (#wheel-arg < (1.0 / 8.0)) then ((8.0 * (#wheel-arg - 0.0)), (Color 255 123 57, Color 255 61 61)) else ((8.0 * (#wheel-arg - 0.125)), (Color 255 171 71, Color 255 123 57)) else if (#wheel-arg < (3.0 / 8.0)) then ((8.0 * (#wheel-arg - 0.25)), (Color 255 212 103, Color 255 171 71)) else ((8.0 * (#wheel-arg - 0.375)), (Color 255 250 148, Color 255 212 103)) else if (#wheel-arg < (3.0 / 4.0)) then if (#wheel-arg < (5.0 / 8.0)) then ((8.0 * (#wheel-arg - 0.5)), (Color 255 212 103, Color 255 250 148)) else ((8.0 * (#wheel-arg - 0.625)), (Color 255 171 71, Color 255 212 103)) else if (#wheel-arg < (7.0 / 8.0)) then ((8.0 * (#wheel-arg - 0.75)), (Color 255 123 57, Color 255 171 71)) else ((8.0 * (#wheel-arg - 0.875)), (Color 255 61 61, Color 255 123 57))), (1st (2nd if (#wheel-arg < (1.0 / 2.0)) then if (#wheel-arg < (1.0 / 4.0)) then if (#wheel-arg < (1.0 / 8.0)) then ((8.0 * (#wheel-arg - 0.0)), (Color 255 123 57, Color 255 61 61)) else ((8.0 * (#wheel-arg - 0.125)), (Color 255 171 71, Color 255 123 57)) else if (#wheel-arg < (3.0 / 8.0)) then ((8.0 * (#wheel-arg - 0.25)), (Color 255 212 103, Color 255 171 71)) else ((8.0 * (#wheel-arg - 0.375)), (Color 255 250 148, Color 255 212 103)) else if (#wheel-arg < (3.0 / 4.0)) then if (#wheel-arg < (5.0 / 8.0)) then ((8.0 * (#wheel-arg - 0.5)), (Color 255 212 103, Color 255 250 148)) else ((8.0 * (#wheel-arg - 0.625)), (Color 255 171 71, Color 255 212 103)) else if (#wheel-arg < (7.0 / 8.0)) then ((8.0 * (#wheel-arg - 0.75)), (Color 255 123 57, Color 255 171 71)) else ((8.0 * (#wheel-arg - 0.875)), (Color 255 61 61, Color 255 123 57)))), (2nd (2nd if (#wheel-arg < (1.0 / 2.0)) then if (#wheel-arg < (1.0 / 4.0)) then if (#wheel-arg < (1.0 / 8.0)) then ((8.0 * (#wheel-arg - 0.0)), (Color 255 123 57, Color 255 61 61)) else ((8.0 * (#whe