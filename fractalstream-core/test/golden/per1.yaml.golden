=== viewer 2: Dynamics
--- body
let `[internal] vanishing radius` = custom_vanishing_radius in:
  let `[internal] escape radius` = escape_radius in:
    let `[internal] iteration limit` = max_iters in:
      let `[internal] stuck` = False in:
        let `[internal] iteration count` = 0 in:
          let `z` = ([internal] x:C + (0.0 :+ 1.0 * [internal] y:C)) in:
            let `pixel_size` = [internal] dx in:
              block:
                let `[internal] fresh #18` = 0 in:
                  let `[internal] fresh #19` = [internal] iteration limit in:
                    block:
                      if (!(|z| < [internal] vanishing radius) and ([internal] fresh #18 < [internal] fresh #19)) then:
                        do-while (!(|z| < [internal] vanishing radius) and ([internal] fresh #18 < [internal] fresh #19)):
                          block:
                            set `z` := ((λ * z) / (((z ^ 2:R:C) + (t * z)) + 1:R:C))
                            set `[internal] fresh #18` := ([internal] fresh #18 + 1)
                      else:
                        no-op
                      set `[internal] iteration count` := [internal] fresh #18
                      set `[internal] stuck` := ([internal] fresh #18 = [internal] fresh #19)
                set `color` := if [internal] stuck then Color 0 0 0 else let #wheel-arg = (([internal] iteration count:R / 20:R) mod 1.0) in blend((1st if (#wheel-arg < (1.0 / 2.0)) then if (#wheel-arg < (1.0 / 4.0)) then if (#wheel-arg < (1.0 / 8.0)) then ((8.0 * (#wheel-arg - 0.0)), (Color 255 100 0, Color 255 0 0)) else ((8.0 * (#wheel-arg - 0.125)), (Color 255 255 0, Color 255 100 0)) else if (#wheel-arg < (3.0 / 8.0)) then ((8.0 * (#wheel-arg - 0.25)), (Color 0 180 0, Color 255 255 0)) else ((8.0 * (#wheel-arg - 0.375)), (Color 0 128 128, Color 0 180 0)) else if (#wheel-arg < (3.0 / 4.0)) then if (#wheel-arg < (5.0 / 8.0)) then ((8.0 * (#wheel-arg - 0.5)), (Color 0 0 255, Color 0 128 128)) else ((8.0 * (#wheel-arg - 0.625)), (Color 128 0 128, Color 0 0 255)) else if (#wheel-arg < (7.0 / 8.0)) then ((8.0 * (#wheel-arg - 0.75)), (Color 255 0 160, Color 128 0 128)) else ((8.0 * (#wheel-arg - 0.875)), (Color 255 0 0, Color 255 0 160))), (1st (2nd if (#wheel-arg < (1.0 / 2.0)) then if (#wheel-arg < (1.0 / 4.0)) then if (#wheel-arg < (1.0 / 8.0)) then ((8.0 * (#wheel-arg - 0.0)), (Color 255 100 0, Color 255 0 0)) else ((8.0 * (#wheel-arg - 0.125)), (Color 255 255 0, Color 255 100 0)) else if (#wheel-arg < (3.0 / 8.0)) then ((8.0 * (#wheel-arg - 0.25)), (Color 0 180 0, Color 255 255 0)) else ((8.0 * (#wheel-arg - 0.375)), (Color 0 128 128, Color 0 180 0)) else if (#wheel-arg < (3.0 / 4.0)) then if (#wheel-arg < (5.0 / 8.0)) then ((8.0 * (#wheel-arg - 0.5)), (Color 0 0 255, Color 0 128 128)) else ((8.0 * (#wheel-arg - 0.625)), (Color 128 0 128, Color 0 0 255)) else if (#wheel-arg < (7.0 / 8.0)) then ((8.0 * (#wheel-arg - 0.75)), (Color 255 0 160, Color 128 0 128)) else ((8.0 * (#wheel-arg - 0.875)), (Color 255 0 0, Color 255 0 160)))), (2nd (2nd if (#wheel-arg < (1.0 / 2.0)) then if (#wheel-arg < (1.0 / 4.0)) then if (#wheel-arg < (1.0 / 8.0)) then ((8.0 * (#wheel-arg - 0.0)), (Color 255 100 0, Color 255 0 0)) else ((8.0 * (#wheel-arg - 0.125)), (Color 255 255 0, Color 255 100 0)) else if (#wheel-arg < (3.0 / 8.0)) then ((8.0 * (#wheel-arg - 0.25)), (Color 0 180 0, Color 255 255 0)) else ((8.0 * (#wheel-arg - 0.375)), (Color 0 128 128, Color 0 180 0)) else if (#wheel-arg < (3.0 / 4.0)) then if (#wheel-arg < (5.0 / 8.0)) then ((8.0 * (#wheel-arg - 0.5)), (Color 0 0 255, Color 0 128 128)) else ((8.0 * (#wheel-arg - 0.625)), (Color 128 0 128, Color 0 0 255)) else if (#wheel-arg < (7.0 / 8.0)) then ((8.0 * (#wheel-arg - 0.75)), (Color 255 0 160, Color 128 0 128)) else ((8.0 * (#wheel-arg - 0.875)), (Color 255 0 0, Color 255 0 160)))))


--- tool Trace
  -- on click
let `[internal] vanishing radius` = custom_vanishing_radius in:
  let `[internal] escape radius` = escape_radius in:
    let `[internal] iteration limit` = max_iters in:
      let `[internal] stuck` = False in:
        let `[internal] iteration count` = 0 in:
          let `z` = ([internal] x:C + (0.0 :+ 1.0 * [internal] y:C)) in:
            let `pixel_size` = [internal] px in:
              block:
                let `prevZ` = z in:
                  block:
                    erase
                    let `[internal] fresh #17` = 0 in:
                      let `[internal] fresh #18` = [internal] iteration limit in:
                        block:
                          if (!(|z| < [internal] vanishing radius) and ([internal] fresh #17 < [internal] fresh #18)) then:
                            do-while (!(|z| < [internal] vanishing radius) and ([internal] fresh #17 < [internal] fresh #18)):
                              block:
                                block:
                                  set `prevZ` := z
                                  draw point at z:R^2
                                  set `z` := ((λ * z) / (((z ^ 2:R:C) + (t * z)) + 1:R:C))
                                  draw line from z:R^2 to prevZ:R^2
                                set `[internal] fresh #17` := ([internal] fresh #17 + 1)
                          else:
                            no-op
                          set `[internal] iteration count` := [internal] fresh #17
                          set `[internal] stuck` := ([internal] fresh #17 = [internal] fresh #18)

  -- on drag
let `[internal] vanishing radius` = custom_vanishing_radius in:
  let `[internal] escape radius` = escape_radius in:
    let `[internal] iteration limit` = max_iters in:
      let `[internal] stuck` = False in:
        let `[internal] iteration count` = 0 in:
          let `z` = ([internal] x:C + (0.0 :+ 1.0 * [internal] y:C)) in:
            let `[unused] start` = ([internal] oldx:C + (0.0 :+ 1.0 * [internal] oldy:C)) in:
              let `pixel_size` = [internal] px in:
                block:
                  let `prevZ` = z in:
                    block:
                      erase
                      let `[internal] fresh #20` = 0 in:
                        let `[internal] fresh #21` = [internal] iteration limit in:
                          block:
                            if (!(|z| < [internal] vanishing radius) and ([internal] fresh #20 < [internal] fresh #21)) then:
                              do-while (!(|z| < [internal] vanishing radius) and ([internal] fresh #20 < [internal] fresh #21)):
                                block:
                                  block:
                                    set `prevZ` := z
                                    draw point at z:R^2
                                    set `z` := ((λ * z) / (((z ^ 2:R:C) + (t * z)) + 1:R:C))
                                    draw line from z:R^2 to prevZ:R^2
                                  set `[internal] fresh #20` := ([internal] fresh #20 + 1)
                            else:
                              no-op
                            set `[internal] iteration count` := [internal] fresh #20
                            set `[internal] stuck` := ([internal] fresh #20 = [internal] fresh #21)

  -- on refresh
let `[internal] vanishing radius` = custom_vanishing_radius in:
  let `[internal] escape radius` = escape_radius in:
    let `[internal] iteration limit` = max_iters in:
      let `[internal] stuck` = False in:
        let `[internal] iteration count` = 0 in:
          let `pixel_size` = [internal] px in:
            block:
              erase


