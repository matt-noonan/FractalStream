=== viewer 0: λ-plane
--- body
let `[internal] vanishing radius` = vanishing_radius in:
  let `[internal] escape radius` = escape_radius in:
    let `[internal] iteration limit` = max_iters in:
      let `[internal] stuck` = False in:
        let `[internal] iteration count` = 0 in:
          block:
            set `λ` := ([internal] x:C + (0.0 :+ 1.0 * [internal] y:C))
            let `pixel_size` = [internal] dx in:
              block:
                set `color` := if (|λ| < 1:R) then if (0:R < (re(λ) * im(λ))) then blend(0.333, Color 255 255 255, Color 128 128 128) else Color 255 255 255 else Color 0 0 0


=== viewer 1: t-plane
--- body
let `[internal] vanishing radius` = custom_vanishing_radius in:
  let `[internal] escape radius` = escape_radius in:
    let `[internal] iteration limit` = max_iters in:
      let `[internal] stuck` = False in:
        let `[internal] iteration count` = 0 in:
          block:
            set `t` := ([internal] x:C + (0.0 :+ 1.0 * [internal] y:C))
            let `pixel_size` = [internal] dx in:
              block:
                let `crit1` = 1:R:C in:
                  block:
                    let `crit2` = -1:R:C in:
                      block:
                        let `z` = crit1 in:
                          block:
                            let `[internal] fresh #20` = 0 in:
                              let `[internal] fresh #21` = [internal] iteration limit in:
                                block:
                                  if (!(|z| < [internal] vanishing radius) and ([internal] fresh #20 < [internal] fresh #21)) then:
                                    do-while (!(|z| < [internal] vanishing radius) and ([internal] fresh #20 < [internal] fresh #21)):
                                      block:
                                        set `z` := ((λ * z) / (((z ^ 2:R:C) + (t * z)) + 1:R:C))
                                        set `[internal] fresh #20` := ([internal] fresh #20 + 1)
                                  else:
                                    no-op
                                  set `[internal] iteration count` := [internal] fresh #20
                                  set `[internal] stuck` := ([internal] fresh #20 = [internal] fresh #21)
                            let `crit1_went_to_0` = (|z| < [internal] vanishing radius) in:
                              block:
                                let `iters1` = [internal] iteration count in:
                                  block:
                                    set `z` := crit2
                                    let `[internal] fresh #22` = 0 in:
                                      let `[internal] fresh #23` = [internal] iteration limit in:
                                        block:
                                          if (!(|z| < [internal] vanishing radius) and ([internal] fresh #22 < [internal] fresh #23)) then:
                                            do-while (!(|z| < [internal] vanishing radius) and ([internal] fresh #22 < [internal] fresh #23)):
                                              block:
                                                set `z` := ((λ * z) / (((z ^ 2:R:C) + (t * z)) + 1:R:C))
                                                set `[internal] fresh #22` := ([internal] fresh #22 + 1)
                                          else:
                                            no-op
                                          set `[internal] iteration count` := [internal] fresh #22
                                          set `[internal] stuck` := ([internal] fresh #22 = [internal] fresh #23)
                                    let `crit2_went_to_0` = (|z| < [internal] vanishing radius) in:
                                      block:
                                        let `iters2` = [internal] iteration count in:
                                          block:
                                            set `color` := Color 255 255 255
                                            if crit1_went_to_0 then:
                                              block:
                                                if crit2_went_to_0 then:
