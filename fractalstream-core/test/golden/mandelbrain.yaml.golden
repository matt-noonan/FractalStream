=== viewer 0: Parameter plane
--- body
let `[internal] vanishing radius` = tol in:
  let `[internal] escape radius` = escape_radius in:
    let `[internal] iteration limit` = max_iters in:
      let `[internal] stuck` = False in:
        let `[internal] iteration count` = 0 in:
          block:
            set `a` := ([internal] x:C + (0.0 :+ 1.0 * [internal] y:C))
            let `pixel_size` = [internal] dx in:
              block:
                let `r1` = 1:R:C in:
                  block:
                    let `r2` = (-0.5:C + a) in:
                      block:
                        let `r3` = (-0.5:C - a) in:
                          block:
                            let `z` = 0:R:C in:
                              block:
                                let `lastZ` = 0:R:C in:
                                  block:
                                    let `[internal] fresh #21` = 0 in:
                                      let `[internal] fresh #22` = [internal] iteration limit in:
                                        block:
                                          do-while (!(|(z - lastZ)| < [internal] vanishing radius) and ([internal] fresh #21 < [internal] fresh #22)):
                                            block:
                                              block:
                                                set `lastZ` := z
                                                let `f` = (((z - r1) * (z - r2)) * (z - r3)) in:
                                                  block:
                                                    let `df` = ((((z - r2) * (z - r3)) + ((z - r1) * (z - r3))) + ((z - r1) * (z - r2))) in:
                                                      block:
                                                        set `z` := (z - (f / df))
                                              set `[internal] fresh #21` := ([internal] fresh #21 + 1)
                                          set `[internal] iteration count` := [internal] fresh #21
                                          set `[internal] stuck` := ([internal] fresh #21 = [internal] fresh #22)
                                    let `c` = Color 128 128 128 in:
                                      block:
                                        if (|(z - r1)| < [internal] vanishing radius) then:
                                          block:
                                            set `c` := Color 255 0 0
                                        else:
                                          if (|(z - r2)| < [internal] vanishing radius) then:
                                            block:
                                              set `c` := Color 0 180 0
                                          else:
                                            if (|(z - r3)| < [internal] vanishing radius) then:
                                              block:
                                                set `c` := Color 0 0 255
                                            else:
                                              no-op
                                        let `s` = (cos((([internal] iteration count:R * 3.141592653589793) / 10:R)) ^ 2:R) in:
                                          block:
                                            set `color` := if (|(z - lastZ)| < [internal] vanishing radius) then blend(s, blend(0.333, Color 0 0 0, c), blend(0.333, Color 255 255 255, c)) else Color 0 0 0


=== viewer 1: Newton's method dynamics
--- body
let `[internal] vanishing radius` = tol in:
  let `[internal] escape radius` = escape_radius in:
    let `[internal] iteration limit` = max_iters in:
      let `[internal] stuck` = False in:
