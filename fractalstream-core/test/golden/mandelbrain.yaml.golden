                                    block:
                                      do-while (!(|(z - lastZ)| < [internal] vanishing radius) and ([internal] fresh #21 < [internal] fresh #22)):
                                        block:
                                          block:
                                            set `lastZ` := z
                                            let `f` = (((z - r1) * (z - r2)) * (z - r3)) in:
                                              block:
                                                let `df` = ((((z - r2) * (z - r3)) + ((z - r1) * (z - r3))) + ((z - r1) * (z - r2))) in:
                                                  block:
                                                    set `z` := (z - (f / df))
