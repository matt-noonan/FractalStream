                                              set `z` := let [internal] newton.z #0 = z in ([internal] newton.z #0 - (let [internal] f.z #1 = [internal] newton.z #0 in ((([internal] f.z #1 ^ 3:R:C) - (2:R:C * [internal] f.z #1)) + 2:R:C) / let [internal] f'.z #2 = [internal] newton.z #0 in ((3:R:C * ([internal] f'.z #2 ^ 2:R:C)) - 2:R:C)))
                                              draw point at [internal] previous.z #0:R^2
                                              draw line from [internal] previous.z #0:R^2 to z:R^2
                                        set `[internal] fresh #19` := ([internal] fresh #19 + 1)
