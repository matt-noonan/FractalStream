                                              else:
                                                block:
                                                  if (re(let [internal] sphere.point #9 = ((1st z), (2nd z)) in ((1st [internal] sphere.point #9) / (2nd [internal] sphere.point #9))) < 0:R) then:
                                                    block:
                                                      set `color` := Color 255 255 0
                                                  else:
                                                    if (0:R < im(let [internal] sphere.point #10 = ((1st z), (2nd z)) in ((1st [internal] sphere.point #10) / (2nd [internal] sphere.point #10)))) then:
                                                      block:
