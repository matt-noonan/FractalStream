                                                let `[internal] fresh #37` = [internal] iteration limit in:
                                                  block:
                                                    if (!([internal] stops.started #0 and let [internal] sphere.point #0 = ((1st z), (2nd z)) in let [internal] sphere.point #1 = ((1st [internal] stops.prev #1), (2nd [internal] stops.prev #1)) in ((2:R * sqrt((((re((((1st [internal] sphere.point #0) * (2nd [internal] sphere.point #1)) - ((2nd [internal] sphere.point #0) * (1st [internal] sphere.point #1)))) * re((((1st [internal] sphere.point #0) * (2nd [internal] sphere.point #1)) - ((2nd [internal] sphere.point #0) * (1st [internal] sphere.point #1))))) + (im((((1st [internal] sphere.point #0) * (2nd [internal] sphere.point #1)) - ((2nd [internal] sphere.point #0) * (1st [internal] sphere.point #1)))) * im((((1st [internal] sphere.point #0) * (2nd [internal] sphere.point #1)) - ((2nd [internal] sphere.point #0) * (1st [internal] sphere.point #1)))))) / ((((re((1st [internal] sphere.point #0)) * re((1st [internal] sphere.point #0))) + (im((1st [internal] sphere.point #0)) * im((1st [internal] sphere.point #0)))) + ((re((2nd [internal] sphere.point #0)) * re((2nd [internal] sphere.point #0))) + (im((2nd [internal] sphere.point #0)) * im((2nd [internal] sphere.point #0))))) * (((re((1st [internal] sphere.point #1)) * re((1st [internal] sphere.point #1))) + (im((1st [internal] sphere.point #1)) * im((1st [internal] sphere.point #1)))) + ((re((2nd [internal] sphere.point #1)) * re((2nd [internal] sphere.point #1))) + (im((2nd [internal] sphere.point #1)) * im((2nd [internal] sphere.point #1))))))))) < [internal] vanishing radius)) and ([internal] fresh #36 < [internal] fresh #37)) then:
                                                      do-while (!([internal] stops.started #0 and let [internal] sphere.point #0 = ((1st z), (2nd z)) in let [internal] sphere.point #1 = ((1st [internal] stops.prev #1), (2nd [internal] stops.prev #1)) in ((2:R * sqrt((((re((((1st [internal] sphere.point #0) * (2nd [internal] sphere.point #1)) - ((2nd [internal] sphere.point #0) * (1st [internal] sphere.point #1)))) * re((((1st [internal] sphere.point #0) * (2nd [internal] sphere.point #1)) - ((2nd [internal] sphere.point #0) * (1st [internal] sphere.point #1))))) + (im((((1st [internal] sphere.point #0) * (2nd [internal] sphere.point #1)) - ((2nd [internal] sphere.point #0) * (1st [internal] sphere.point #1)))) * im((((1st [internal] sphere.point #0) * (2nd [internal] sphere.point #1)) - ((2nd [internal] sphere.point #0) * (1st [internal] sphere.point #1)))))) / ((((re((1st [internal] sphere.point #0)) * re((1st [internal] sphere.point #0))) + (im((1st [internal] sphere.point #0)) * im((1st [internal] sphere.point #0)))) + ((re((2nd [internal] sphere.point #0)) * re((2nd [internal] sphere.point #0))) + (im((2nd [internal] sphere.point #0)) * im((2nd [internal] sphere.point #0))))) * (((re((1st [internal] sphere.point #1)) * re((1st [internal] sphere.point #1))) + (im((1st [internal] sphere.point #1)) * im((1st [internal] sphere.point #1)))) + ((re((2nd [internal] sphere.point #1)) * re((2nd [internal] sphere.point #1))) + (im((2nd [internal] sphere.point #1)) * im((2nd [internal] sphere.point #1))))))))) < [internal] vanishing radius)) and ([internal] fresh #36 < [internal] fresh #37)):
                                                        block:
