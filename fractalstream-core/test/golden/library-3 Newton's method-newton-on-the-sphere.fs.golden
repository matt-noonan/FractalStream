                                                            set `z` := let [internal] sphere.scaled #8 = let [internal] sphere.numerator #2 = (1st z) in let [internal] sphere.denominator #3 = 1.0 :+ 0.0 in let [internal] sphere.numerator #4 = [internal] sphere.numerator #2 in let [internal] sphere.denominator #5 = [internal] sphere.denominator #3 in let [internal] sphere.numerator #6 = [internal] sphere.numerator #2 in let [internal] sphere.denominator #7 = [internal] sphere.denominator #3 in ((([internal] sphere.numerator #2 * ((([internal] sphere.denominator #5 ^ 3:R:C) * [internal] sphere.denominator #5) * ((3:R:C * ([internal] sphere.numerator #6 ^ 2:R:C)) - ((2:R:C * ([internal] sphere.denominator #7 ^ 2:R:C)) * ((2nd z) ^ 2:R:C))))) - (((((([internal] sphere.numerator #4 ^ 3:R:C) * [internal] sphere.denominator #5) - (((2:R:C * [internal] sphere.numerator #4) * ([internal] sphere.denominator #5 ^ 3:R:C)) * ((2nd z) ^ 2:R:C))) + ((2:R:C * (([internal] sphere.denominator #5 ^ 3:R:C) * [internal] sphere.denominator #5)) * ((2nd z) ^ 3:R:C))) * ([internal] sphere.denominator #7 ^ 2:R:C)) * [internal] sphere.denominator #3)), (([internal] sphere.denominator #3 * ((([internal] sphere.denominator #5 ^ 3:R:C) * [internal] sphere.denominator #5) * ((3:R:C * ([internal] sphere.numerator #6 ^ 2:R:C)) - ((2:R:C * ([internal] sphere.denominator #7 ^ 2:R:C)) * ((2nd z) ^ 2:R:C))))) * (2nd z))) in if (((re((2nd [internal] sphere.scaled #8)) * re((2nd [internal] sphere.scaled #8))) + (im((2nd [internal] sphere.scaled #8)) * im((2nd [internal] sphere.scaled #8)))) < ((re((1st [internal] sphere.scaled #8)) * re((1st [internal] sphere.scaled #8))) + (im((1st [internal] sphere.scaled #8)) * im((1st [internal] sphere.scaled #8))))) then (1.0 :+ 0.0, ((2nd [internal] sphere.scaled #8) / (1st [internal] sphere.scaled #8))) else (((1st [internal] sphere.scaled #8) / (2nd [internal] sphere.scaled #8)), 1.0 :+ 0.0)
                                                          set `[internal] fresh #36` := ([internal] fresh #36 + 1)
                                                    else:
