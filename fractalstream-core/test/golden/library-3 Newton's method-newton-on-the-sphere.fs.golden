--- tool Trace
  -- on click
let `[internal] vanishing radius` = vanishing_radius in:
  let `[internal] escape radius` = escape_radius in:
    let `[internal] iteration limit` = max_iters in:
      let `[internal] stuck` = False in:
        let `[internal] iteration count` = 0 in:
          let `z` = ([internal] x:C + (0.0 :+ 1.0 * [internal] y:C)) in:
            let `pixel_size` = [internal] px in:
              block:
                erase
                block:
                  let `[internal] previous.z #0` = z in:
                    block:
                      block:
                        let `[internal] stops.prev #1` = z in:
                          block:
                            let `[internal] fresh #16` = 0 in:
                              let `[internal] fresh #17` = 60 in:
                                block:
                                  do-while (!(|(z - [internal] stops.prev #1)| < [internal] vanishing radius) and ([internal] fresh #16 < [internal] fresh #17)):
                                    block:
                                      block:
                                        set `[internal] stops.prev #1` := z
                                        block:
                                          set `[internal] previous.z #0` := z
                                          block:
                                            set `z` := let [internal] newton.z #0 = z in ([internal] newton.z #0 - (let [internal] f.z #1 = [internal] newton.z #0 in ((([internal] f.z #1 ^ 3:R:C) - (2:R:C * [internal] f.z #1)) + 2:R:C) / let [internal] f'.z #2 = [internal] newton.z #0 in ((3:R:C * ([internal] f'.z #2 ^ 2:R:C)) - 2:R:C)))
                                            draw point at [internal] previous.z #0:R^2
                                            draw line from [internal] previous.z #0:R^2 to z:R^2
                                      set `[internal] fresh #16` := ([internal] fresh #16 + 1)
                                  set `[internal] iteration count` := [internal] fresh #16
                                  set `[internal] stuck` := ([internal] fresh #16 = [internal] fresh #17)
                draw point at z:R^2

  -- on drag
let `[internal] vanishing radius` = vanishing_radius in:
  let `[internal] escape radius` = escape_radius in:
    let `[internal] iteration limit` = max_iters in:
      let `[internal] stuck` = False in:
