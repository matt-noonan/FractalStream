=== viewer 0: Monsieur Mathieu
--- body
let `[internal] vanishing radius` = tol in:
  let `[internal] escape radius` = escape_radius in:
    let `[internal] iteration limit` = max_iters in:
      let `[internal] stuck` = False in:
        let `[internal] iteration count` = 0 in:
          let `z` = ([internal] x:C + (0.0 :+ 1.0 * [internal] y:C)) in:
            let `pixel_size` = [internal] dx in:
              block:
                let `a` = ((107:R:C + ((7:R * sqrt(11:R)):C * 0.0 :+ 1.0)) / 486:R:C) in:
                  block:
                    let `b` = (((-13:R:C * a) / 567:R:C) + (5:R / 1701:R):C) in:
                      block:
                        let `d` = (((23:R:C * a) / 7:R:C) + (256:R / 567:R):C) in:
                          block:
                            let `ee` = (((-1573:R:C * a) / 567:R:C) + (605:R / 1701:R):C) in:
                              block:
                                let `f` = (-17:R / 9:R):C in:
                                  block:
                                    let `k` = (((-16192:R:C * a) / 301327047:R:C) + (10880:R / 903981141:R):C) in:
                                      block:
                                        set `z` := (((((((z ^ 3:R:C) - (z ^ 2:R:C)) + (a * z)) + b) ^ 3:R:C) * ((((z ^ 3:R:C) + (f * (z ^ 2:R:C))) + (d * z)) + ee)) / (k * z))
                                        if (||(z - tol:C)|:C| < [internal] vanishing radius) then:
                                          block:
                                            set `color` := Color 0 0 255
                                        else:
                                          if (||(z - 1:R:C)|:C| < [internal] vanishing radius) then:
                                            block:
                                              set `color` := Color 255 0 0
                                          else:
                                            if ((|im(z):C| < [internal] vanishing radius) and ((0:R < re(z)) and (re(z) < 1:R))) then:
                                              block:
                                                set `color` := Color 0 180 0
                                            else:
                                              if (0:R < im(z)) then:
                                                block:
                                                  set `color` := Color 255 255 255
                                              else:
                                                block:
                                                  set `color` := Color 0 0 0


