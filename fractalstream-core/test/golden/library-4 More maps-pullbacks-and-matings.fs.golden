--- tool Preimages
  -- on click
let `[internal] vanishing radius` = vanishing_radius in:
  let `[internal] escape radius` = escape_radius in:
    let `[internal] iteration limit` = max_iters in:
      let `[internal] stuck` = False in:
        let `[internal] iteration count` = 0 in:
          let `z` = [internal] point a in:
            let `pixel_size` = [internal] px in:
              block:
                erase
                use color1 for line
                draw point at (z, 1.0 :+ 0.0)
                set `pre1` := let [internal] preimage.z #0 = z in sqrt(((-C + [internal] preimage.z #0) / ([internal] preimage.z #0 - 1:R:C)))
                set `pre2` := -let [internal] preimage.z #0 = z in sqrt(((-C + [internal] preimage.z #0) / ([internal] preimage.z #0 - 1:R:C)))
                use color2 for line
                draw point at (pre1, 1.0 :+ 0.0)
                use color3 for line
                draw point at (pre2, 1.0 :+ 0.0)

  -- on drag
let `[internal] vanishing radius` = vanishing_radius in:
  let `[internal] escape radius` = escape_radius in:
    let `[internal] iteration limit` = max_iters in:
      let `[internal] stuck` = False in:
        let `[internal] iteration count` = 0 in:
          let `z` = [internal] point a in:
            let `[unused] start` = [internal] old point a in:
              let `pixel_size` = [internal] px in:
                block:
                  erase
                  use color1 for line
                  draw point at (z, 1.0 :+ 0.0)
                  set `pre1` := let [internal] preimage.z #0 = z in sqrt(((-C + [internal] preimage.z #0) / ([internal] preimage.z #0 - 1:R:C)))
                  set `pre2` := -let [internal] preimage.z #0 = z in sqrt(((-C + [internal] preimage.z #0) / ([internal] preimage.z #0 - 1:R:C)))
                  use color2 for line
                  draw point at (pre1, 1.0 :+ 0.0)
                  use color3 for line
                  draw point at (pre2, 1.0 :+ 0.0)

  -- on deactivated
let `[internal] vanishing radius` = vanishing_radius in:
  let `[internal] escape radius` = escape_radius in:
    let `[internal] iteration limit` = max_iters in:
      let `[internal] stuck` = False in:
        let `[internal] iteration count` = 0 in:
          let `pixel_size` = [internal] px in:
            block:
              erase


--- tool Mark orbit of critical point
  -- on button Erase postcritical points
let `[internal] vanishing radius` = vanishing_radius in:
  let `[internal] escape radius` = escape_radius in:
    let `[internal] iteration limit` = max_iters in:
      let `[internal] stuck` = False in:
        let `[internal] iteration count` = 0 in:
          let `pixel_size` = [internal] px in:
            block:
              erase

  -- on refresh
let `[internal] vanishing radius` = vanishing_radius in:
  let `[internal] escape radius` = escape_radius in:
    let `[internal] iteration limit` = max_iters in:
      let `[internal] stuck` = False in:
        let `[internal] iteration count` = 0 in:
          let `pixel_size` = [internal] px in:
            block:
              erase
              use one_color for line
              draw point at (1:R:C, 1.0 :+ 0.0)
              use zero_orbit_color for line
              let `z` = 0:R:C in:
                block:
                  let `last_z` = z in:
                    block:
                      let `[internal] fresh #22` = 0 in:
                        let `[internal] fresh #23` = [internal] iteration limit in:
                          block:
                            do-while (!(|(z - 0:R:C)| < [internal] vanishing radius) and ([internal] fresh #22 < [internal] fresh #23)):
                              block:
                                block:
                                  draw point at (z, 1.0 :+ 0.0)
                                  if follow then:
                                    block:
                                      draw line from (last_z, 1.0 :+ 0.0) to (z, 1.0 :+ 0.0)
                                      set `last_z` := z
                                  else:
                                    no-op
                                  set `z` := let [internal] f.z #0 = z in ((([internal] f.z #0 ^ 2:R:C) - C) / (([internal] f.z #0 ^ 2:R:C) - 1:R:C))
                                set `[internal] fresh #22` := ([internal] fresh #22 + 1)
                            set `[internal] iteration count` := [internal] fresh #22
                            set `[internal] stuck` := ([internal] fresh #22 = [internal] fresh #23)


--- tool Pullback
  -- on drag
let `[internal] vanishing radius` = vanishing_radius in:
  let `[internal] escape radius` = escape_radius in:
    let `[internal] iteration limit` = max_iters in:
      let `[internal] stuck` = False in:
        let `[internal] iteration count` = 0 in:
          let `z` = [internal] point a in:
            let `[unused] start` = [internal] old point a in:
              let `pixel_size` = [internal] px in:
                block:
                  let `pre1` = let [internal] preimage.z #0 = z in sqrt(((-C + [internal] preimage.z #0) / ([internal] preimage.z #0 - 1:R:C))) in:
                    block:
                      let `pre2` = -let [internal] preimage.z #0 = z in sqrt(((-C + [internal] preimage.z #0) / ([internal] preimage.z #0 - 1:R:C))) in:
                        block:
                          if follow then:
                            block:
                              use color1 for line
                              draw line from (last_z, 1.0 :+ 0.0) to (z, 1.0 :+ 0.0)
                              set `last_z` := z
                              if (|(last_pre1 - pre2)| < |(last_pre1 - pre1)|) then:
                                block:
                                  let `tmp` = pre1 in:
                                    block:
                                      set `pre1` := pre2
                                      set `pre2` := tmp
                              else:
                                no-op
                              use color2 for line
                              draw line from (last_pre1, 1.0 :+ 0.0) to (pre1, 1.0 :+ 0.0)
                              set `last_pre1` := pre1
                              use color3 for line
                              draw line from (last_pre2, 1.0 :+ 0.0) to (pre2, 1.0 :+ 0.0)
                              set `last_pre2` := pre2
                          else:
                            block:
                              use color1 for line
                              draw point at (z, 1.0 :+ 0.0)
                              set `last_z` := z
                              use color2 for line
                              draw point at (pre1, 1.0 :+ 0.0)
                              set `last_pre1` := pre1
                              use color3 for line
                              draw point at (pre2, 1.0 :+ 0.0)
                              set `last_pre2` := pre2
                              set `follow` := True

  -- on drag-done
let `[internal] vanishing radius` = vanishing_radius in:
  let `[internal] escape radius` = escape_radius in:
    let `[internal] iteration limit` = max_iters in:
      let `[internal] stuck` = False in:
        let `[internal] iteration count` = 0 in:
          let `z` = [internal] point a in:
            let `[unused] start` = [internal] old point a in:
              let `pixel_size` = [internal] px in:
                block:
                  set `follow` := False

  -- on button Erase
let `[internal] vanishing radius` = vanishing_radius in:
  let `[internal] escape radius` = escape_radius in:
    let `[internal] iteration limit` = max_iters in:
      let `[internal] stuck` = False in:
        let `[internal] iteration count` = 0 in:
          let `pixel_size` = [internal] px in:
            block:
              erase
              set `follow` := False


