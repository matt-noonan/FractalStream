                                                                              draw point at (-2:R:C, 1.0 :+ 0.0)
                                                                              write "-2" at (-2.2:C, 1.0 :+ 0.0)
                                                                              write "\947" at ((first_pt - (0.15:C * 0.0 :+ 1.0)), 1.0 :+ 0.0)
