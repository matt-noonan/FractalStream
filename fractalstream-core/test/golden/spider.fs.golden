                                                                block:
                                                                  set `contour` := join(contour, [(10:R:C + (0.0 :+ 1.0 * im(last_pt):C)); (10:R:C + (0.0 :+ 1.0 * im(first_pt):C)); first_pt])
                                                                  use let [internal] [std] light.c #0 = Color 128 128 128 in blend(0.333, [internal] [std] light.c #0, Color 255 255 255) for line
                                                                  set `t` := 0:R
