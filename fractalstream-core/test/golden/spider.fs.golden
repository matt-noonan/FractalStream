                                                            use let [internal] [std] dark.c #0 = c in blend(0.333, [internal] [std] dark.c #0, Color 0 0 0) for line
                                                            use let [internal] [std] light.c #0 = c in blend(0.333, [internal] [std] light.c #0, Color 255 255 255) for line
                                                            let `t` = 0:R in:
                                                              block:
                                                                let `N` = 100 in:
                                                                  block:
                                                                    let `dt` = (1:R / N:R) in:
                                                                      block:
                                                                        let `last_gamma` = (R:C * omega) in:
                                                                          block:
                                                                            draw line from ((20:R:C * omega), 1.0 :+ 0.0) to (last_gamma, 1.0 :+ 0.0)
                                                                            set `leg` := []
                                                                            let `[internal] fresh #37` = 0 in:
                                                                              let `[internal] fresh #38` = N in:
                                                                                block:
                                                                                  if (True and ([internal] fresh #37 < [internal] fresh #38)) then:
                                                                                    do-while (True and ([internal] fresh #37 < [internal] fresh #38)):
                                                                                      block:
                                                                                        block:
                                                                                          set `t` := (t + dt)
                                                                                          let `gamma` = (((R ^ (1:R - t)):C * omega) + (b * t:C)) in:
                                                                                            block:
                                                                                              set `leg` := join([last_gamma], leg)
                                                                                              draw line from (last_gamma, 1.0 :+ 0.0) to (gamma, 1.0 :+ 0.0)
                                                                                              set `last_gamma` := gamma
                                                                                        set `[internal] fresh #37` := ([internal] fresh #37 + 1)
                                                                                  else:
                                                                                    no-op
                                                                                  set `[internal] iteration count` := [internal] fresh #37
                                                                                  set `[internal] stuck` := ([internal] fresh #37 = [internal] fresh #38)
                                                                            draw filled circle at (zi, 1.0 :+ 0.0) with radius foot
                                                                            set `omega` := (omega ^ 2:R:C)
                                                                            set `spider` := join(spider, [leg])
                                                  set `[internal] fresh #29` := ([internal] fresh #29 + 1)
                                            else:
                                              no-op
                                            set `[internal] iteration count` := [internal] fresh #29
                                            set `[internal] stuck` := ([internal] fresh #29 = [internal] fresh #30)
                                      set `omega` := (2.718281828459045:C ^ ((((2:R * 3.141592653589793):C * 0.0 :+ 1.0) * p:R:C) / q:R:C))
                                      let `z2` = ((omega ^ 2:R:C) + b) in:
                                        block:
                                          let `leg1` = (spider@1) in:
                                            block:
                                              let `last_gamma` = (leg1@1) in:
                                                block:
                                                  use let [internal] [std] light.c #0 = Color 128 128 128 in blend(0.333, [internal] [std] light.c #0, Color 255 255 255) for line
                                                  set `contour` := []
