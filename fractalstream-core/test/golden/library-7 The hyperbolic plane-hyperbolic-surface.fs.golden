=== viewer 0: Surface
--- body
let `[internal] vanishing radius` = vanishing_radius in:
  let `[internal] escape radius` = escape_radius in:
    let `[internal] iteration limit` = max_iters in:
      let `[internal] stuck` = False in:
        let `[internal] iteration count` = 0 in:
          let `z` = ([internal] x:C + (0.0 :+ 1.0 * [internal] y:C)) in:
            let `pixel_size` = [internal] dx in:
              if (([internal] half-plane display and !(0.0 < [internal] y)) or (![internal] half-plane display and !((([internal] x * [internal] x) + ([internal] y * [internal] y)) < 1.0))) then:
                set `color` := Color 48 48 48
              else:
                block:
                  let `[internal] disk.s` = ([internal] x:C + ([internal] y:C * 0.0 :+ 1.0)) in:
                    block:
                      let `[internal] disk.num` = ((([internal] hyperbolic a.re:C + ([internal] hyperbolic a.im:C * 0.0 :+ 1.0)) * [internal] disk.s) + ([internal] hyperbolic b.re:C + ([internal] hyperbolic b.im:C * 0.0 :+ 1.0))) in:
                        block:
                          let `[internal] disk.den` = ((([internal] hyperbolic c.re:C + ([internal] hyperbolic c.im:C * 0.0 :+ 1.0)) * [internal] disk.s) + ([internal] hyperbolic d.re:C + ([internal] hyperbolic d.im:C * 0.0 :+ 1.0))) in:
                            block:
                              let `[internal] group.gz` = ([internal] disk.num / [internal] disk.den) in:
                                block:
                                  set `pixel_size` := (pixel_size / (|[internal] disk.den| ^ 2:R))
                                  let `[internal] group.gdz` = 1.0 in:
                                    block:
                                      let `[internal] group.gsteps` = 0 in:
                                        block:
                                          let `[internal] group.gnw` = |[internal] group angles| in:
                                            block:
                                              let `[internal] group.gwedge` = [internal] group.gnw in:
                                                block:
                                                  let `[internal] group.gaon` = True in:
                                                    block:
                                                      let `[internal] fresh #51` = 0 in:
                                                        let `[internal] fresh #52` = 1000 in:
                                                          block:
                                                            if ([internal] group.gaon and ([internal] fresh #51 < [internal] fresh #52)) then:
                                                              do-while ([internal] group.gaon and ([internal] fresh #51 < [internal] fresh #52)):
                                                                block:
                                                                  block:
                                                                    let `[internal] group.gkz` = ((2:R:C * [internal] group.gz) / (1:R + (|[internal] group.gz| ^ 2:R)):C) in:
                                                                      block:
                                                                        let `[internal] group.gph` = arg([internal] group.gkz) in:
                                                                          block:
                                                                            set `[internal] group.gwedge` := [internal] group.gnw
                                                                            if !([internal] group.gph < ([internal] group angles@1)) then:
                                                                              block:
                                                                                let `[internal] group.glo` = 1 in:
                                                                                  block:
                                                                                    let `[internal] group.ghi` = [internal] group.gnw in:
                                                                                      block:
                                                                                        let `[internal] fresh #57` = 0 in:
                                                                                          let `[internal] fresh #58` = 64 in:
                                                                                            block:
                                                                                              if (([internal] group.glo < [internal] group.ghi) and ([internal] fresh #57 < [internal] fresh #58)) then:
                                                                                                do-while (([internal] group.glo < [internal] group.ghi) and ([internal] fresh #57 < [internal] fresh #58)):
                                                                                                  block:
                                                                                                    block:
                                                                                                      let `[internal] group.gmid` = ((([internal] group.glo + [internal] group.ghi) + 1) / 2) in:
                                                                                                        block:
                                                                                                          if !([internal] group.gph < ([internal] group angles@[internal] group.gmid)) then:
                                                                                                            block:
                                                                                                              set `[internal] group.glo` := [internal] group.gmid
                                                                                                          else:
                                                                                                            block:
                                                                                                              set `[internal] group.ghi` := ([internal] group.gmid - 1)
                                                                                                    set `[internal] fresh #57` := ([internal] fresh #57 + 1)
                                                                                              else:
                                                                                                no-op
                                                                                              set `[internal] iteration count` := [internal] fresh #57
                                                                                              set `[internal] stuck` := ([internal] fresh #57 = [internal] fresh #58)
                                                                                        set `[internal] group.gwedge` := [internal] group.glo
                                                                            else:
                                                                              no-op
                                                                            let `[internal] group.gside` = ([internal] group wedge sides@[internal] group.gwedge) in:
                                                                              block:
                                                                                set `[internal] group.gaon` := False
                                                                                if (0 < [internal] group.gside) then:
                                                                                  block:
                                                                                    let `[internal] group.gnk` = ([internal] group normals@[internal] group.gside) in:
                                                                                      block:
                                                                                        if (([internal] group reach@[internal] group.gside) < ((re([internal] group.gkz) * re([internal] group.gnk)) + (im([internal] group.gkz) * im([internal] group.gnk)))) then:
                                                                                          block:
                                                                                            let `[internal] group.gden2` = ((([internal] group c@[internal] group.gside) * [internal] group.gz) + ([internal] group d@[internal] group.gside)) in:
                                                                                              block:
                                                                                                set `[internal] group.gz` := (((([internal] group a@[internal] group.gside) * [internal] group.gz) + ([internal] group b@[internal] group.gside)) / [internal] group.gden2)
                                                                                                set `[internal] group.gdz` := ([internal] group.gdz / (|[internal] group.gden2| ^ 2:R))
                                                                                                set `[internal] group.gsteps` := ([internal] group.gsteps + 1)
                                                                                                set `[internal] group.gaon` := True
                                                                                        else:
                                                                                          no-op
                                                                                else:
                                                                                  no-op
                                                                  set `[internal] fresh #51` := ([internal] fresh #51 + 1)
                                                            else:
                                                              no-op
                                                            set `[internal] iteration count` := [internal] fresh #51
                                                            set `[internal] stuck` := ([internal] fresh #51 = [internal] fresh #52)
                                                      let `[internal] group.gbest` = -1.0 in:
                                                        block:
                                                          let `[internal] group.gbk` = 0 in:
                                                            block:
                                                              let `[internal] group.gcand` = 0 in:
                                                                block:
                                                                  set `[internal] group.gcand` := ([internal] group wedge sides@if ([internal] group.gwedge = 1) then [internal] group.gnw else ([internal] group.gwedge - 1))
                                                                  if (0 < [internal] group.gcand) then:
