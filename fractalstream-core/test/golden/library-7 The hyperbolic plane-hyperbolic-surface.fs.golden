                                                                            block:
                                                                              let `[internal] group.gq` = ((|([internal] group.gz - [internal] group.gcc)| ^ 2:R) - ([internal] group.grr ^ 2:R)) in:
                                                                                block:
                                                                                  let `[internal] group.gsd` = (|[internal] group.gq| / ([internal] group.grr * (1:R - (|[internal] group.gz| ^ 2:R)))) in:
                                                                                    block:
                                                                                      if (([internal] group.gbest < 0:R) or ([internal] group.gsd < [internal] group.gbest)) then:
                                                                                        block:
                                                                                          set `[internal] group.gbest` := [internal] group.gsd
                                                                                          set `[internal] group.gbk` := [internal] group.gcand
                                                                                      else:
                                                                                        no-op
                                                                  else:
                                                                    no-op
                                                                  set `[internal] group.gcand` := ([internal] group wedge sides@if ([internal] group.gwedge = [internal] group.gnw) then 1 else ([internal] group.gwedge + 1))
                                                                  if (0 < [internal] group.gcand) then:
                                                                    block:
                                                                      let `[internal] group.gcc` = ([internal] group circles@[internal] group.gcand) in:
                                                                        block:
                                                                          let `[internal] group.grr` = ([internal] group radii@[internal] group.gcand) in:
                                                                            block:
                                                                              let `[internal] group.gq` = ((|([internal] group.gz - [internal] group.gcc)| ^ 2:R) - ([internal] group.grr ^ 2:R)) in:
                                                                                block:
                                                                                  let `[internal] group.gsd` = (|[internal] group.gq| / ([internal] group.grr * (1:R - (|[internal] group.gz| ^ 2:R)))) in:
                                                                                    block:
                                                                                      if (([internal] group.gbest < 0:R) or ([internal] group.gsd < [internal] group.gbest)) then:
                                                                                        block:
                                                                                          set `[internal] group.gbest` := [internal] group.gsd
                                                                                          set `[internal] group.gbk` := [internal] group.gcand
                                                                                      else:
                                                                                        no-op
                                                                  else:
                                                                    no-op
                                                                  let `side_distance` = if ([internal] group.gbest < 0:R) then 1000000.0 else asinh([internal] group.gbest) in:
                                                                    block:
                                                                      let `side_index` = [internal] group.gbk in:
                                                                        block:
                                                                          let `fold_count` = [internal] group.gsteps in:
                                                                            block:
                                                                              let `[internal] group.gfk` = ((([internal] group from fold@3) * [internal] group.gz) + ([internal] group from fold@4)) in:
                                                                                block:
                                                                                  set `z` := (((([internal] group from fold@1) * [internal] group.gz) + ([internal] group from fold@2)) / [internal] group.gfk)
                                                                                  set `pixel_size` := ((pixel_size * [internal] group.gdz) / (|[internal] group.gfk| ^ 2:R))
                                                                                  block:
                                                                                    let `[internal] tuple #0` = table_size(sides) in:
                                                                                      block:
                                                                                        let `rows` = (1st [internal] tuple #0) in:
                                                                                          block:
                                                                                            let `n` = (2nd [internal] tuple #0) in:
                                                                                              block:
                                                                                                if (n = 0) then:
                                                                                                  block:
                                                                                                    set `color` := Color 128 128 128
                                                                                                else:
                                                                                                  block:
                                                                                                    let `dist` = (2:R * atanh(|z|)) in:
                                                                                                      block:
                                                                                                        set `color` := let #wheel-arg = ((arg(z) / (2:R * 3.141592653589793)) mod 1.0) in blend((1st if (#wheel-arg < (1.0 / 2.0)) then if (#wheel-arg < (1.0 / 4.0)) then if (#wheel-arg < (1.0 / 8.0)) then ((8.0 * (#wheel-arg - 0.0)), (Color 255 100 0, Color 255 0 0)) else ((8.0 * (#wheel-arg - 0.125)), (Color 255 255 0, Color 255 100 0)) else if (#wheel-arg < (3.0 / 8.0)) then ((8.0 * (#wheel-arg - 0.25)), (Color 0 180 0, Color 255 255 0)) else ((8.0 * (#wheel-arg - 0.375)), (Color 0 128 128, Color 0 180 0)) else if (#wheel-arg < (3.0 / 4.0)) then if (#wheel-arg < (5.0 / 8.0)) then ((8.0 * (#wheel-arg - 0.5)), (Color 0 0 255, Color 0 128 128)) else ((8.0 * (#wheel-arg - 0.625)), (Color 128 0 128, Color 0 0 255)) else if (#wheel-arg < (7.0 / 8.0)) then ((8.0 * (#wheel-arg - 0.75)), (Color 255 0 160, Color 128 0 128)) else ((8.0 * (#wheel-arg - 0.875)), (Color 255 0 0, Color 255 0 160))), (1st (2nd if (#wheel-arg < (1.0 / 2.0)) then if (#wheel-arg < (1.0 / 4.0)) then if (#wheel-arg < (1.0 / 8.0)) then ((8.0 * (#wheel-arg - 0.0)), (Color 255 100 0, Color 255 0 0)) else ((8.0 * (#wheel-arg - 0.125)), (Color 255 255 0, Color 255 100 0)) else if (#wheel-arg < (3.0 / 8.0)) then ((8.0 * (#wheel-arg - 0.25)), (Color 0 180 0, Color 255 255 0)) else ((8.0 * (#wheel-arg - 0.375)), (Color 0 128 128, Color 0 180 0)) else if (#wheel-arg < (3.0 / 4.0)) then if (#wheel-arg < (5.0 / 8.0)) then ((8.0 * (#wheel-arg - 0.5)), (Color 0 0 255, Color 0 128 128)) else ((8.0 * (#wheel-arg - 0.625)), (Color 128 0 128, Color 0 0 255)) else if (#wheel-arg < (7.0 / 8.0)) then ((8.0 * (#wheel-arg - 0.75)), (Color 255 0 160, Color 128 0 128)) else ((8.0 * (#wheel-arg - 0.875)), (Color 255 0 0, Color 255 0 160)))), (2nd (2nd if (#wheel-arg < (1.0 / 2.0)) then if (#wheel-arg < (1.0 / 4.0)) then if (#wheel-arg < (1.0 / 8.0)) then ((8.0 * (#wheel-arg - 0.0)), (Color 255 100 0, Color 255 0 0)) else ((8.0 * (#wheel-arg - 0.125)), (Color 255 255 0, Color 255 100 0)) else if (#wheel-arg < (3.0 / 8.0)) then ((8.0 * (#wheel-arg - 0.25)), (Color 0 180 0, Color 255 255 0)) else ((8.0 * (#wheel-arg - 0.375)), (Color 0 128 128, Color 0 180 0)) else if (#wheel-arg < (3.0 / 4.0)) then if (#wheel-arg < (5.0 / 8.0)) then ((8.0 * (#wheel-arg - 0.5)), (Color 0 0 255, Color 0 128 128)) else ((8.0 * (#wheel-arg - 0.625)), (Color 128 0 128, Color 0 0 255)) else if (#wheel-arg < (7.0 / 8.0)) then ((8.0 * (#wheel-arg - 0.75)), (Color 255 0 160, Color 128 0 128)) else ((8.0 * (#wheel-arg - 0.875)), (Color 255 0 0, Color 255 0 160)))))
                                                                                                        set `color` := blend((0.25 + (0.25 * cos((6:R * dist)))), Color 255 255 255, color)
                                                                                                        if show_edges then:
                                                                                                          block:
                                                                                                            let `w` = ((2:R * pixel_size) / (1:R - (|z| ^ 2:R))) in:
                                                                                                              block:
                                                                                                                let `pair` = ((side_index - 1) mod (n / 2)) in:
                                                                                                                  block:
                                                                                                                    let `edge` = let #wheel-arg = ((pair:R / (n / 2):R) mod 1.0) in blend((1st if (#wheel-arg < (1.0 / 2.0)) then if (#wheel-arg < (1.0 / 4.0)) then if (#wheel-arg < (1.0 / 8.0)) then ((8.0 * (#wheel-arg - 0.0)), (Color 255 100 0, Color 255 0 0)) else ((8.0 * (#wheel-arg - 0.125)), (Color 255 255 0, Color 255 100 0)) else if (#wheel-arg < (3.0 / 8.0)) then ((8.0 * (#wheel-arg - 0.25)), (Color 0 180 0, Color 255 255 0)) else ((8.0 * (#wheel-arg - 0.375)), (Color 0 128 128, Color 0 180 0)) else if (#wheel-arg < (3.0 / 4.0)) then if (#wheel-arg < (5.0 / 8.0)) then ((8.0 * (#wheel-arg - 0.5)), (Color 0 0 255, Color 0 128 128)) else ((8.0 * (#wheel-arg - 0.625)), (Color 128 0 128, Color 0 0 255)) else if (#wheel-arg < (7.0 / 8.0)) then ((8.0 * (#wheel-arg - 0.75)), (Color 255 0 160, Color 128 0 128)) else ((8.0 * (#wheel-arg - 0.875)), (Color 255 0 0, Color 255 0 160))), (1st (2nd if (#wheel-arg < (1.0 / 2.0)) then if (#wheel-arg < (1.0 / 4.0)) then if (#wheel-arg < (1.0 / 8.0)) then ((8.0 * (#wheel-arg - 0.0)), (Color 255 100 0, Color 255 0 0)) else ((8.0 * (#wheel-arg - 0.125)), (Color 255 255 0, Color 255 100 0)) else if (#wheel-arg < (3.0 / 8.0)) then ((8.0 * (#wheel-arg - 0.25)), (Color 0 180 0, Color 255 255 0)) else ((8.0 * (#wheel-arg - 0.375)), (Color 0 128 128, Color 0 180 0)) else if (#wheel-arg < (3.0 / 4.0)) then if (#wheel-arg < (5.0 / 8.0)) then ((8.0 * (#wheel-arg - 0.5)), (Color 0 0 255, Color 0 128 128)) else ((8.0 * (#wheel-arg - 0.625)), (Color 128 0 128, Color 0 0 255)) else if (#wheel-arg < (7.0 / 8.0)) then ((8.0 * (#wheel-arg - 0.75)), (Color 255 0 160, Color 128 0 128)) else ((8.0 * (#wheel-arg - 0.875)), (Color 255 0 0, Color 255 0 160)))), (2nd (2nd if (#wheel-arg < (1.0 / 2.0)) then if (#wheel-arg < (1.0 / 4.0)) then if (#wheel-arg < (1.0 / 8.0)) then ((8.0 * (#wheel-arg - 0.0)), (Color 255 100 0, Color 255 0 0)) else ((8.0 * (#wheel-arg - 0.125)), (Color 255 255 0, Color 255 100 0)) else if (#wheel-arg < (3.0 / 8.0)) then ((8.0 * (#wheel-arg - 0.25)), (Color 0 180 0, Color 255 255 0)) else ((8.0 * (#wheel-arg - 0.375)), (Color 0 128 128, Color 0 180 0)) else if (#wheel-arg < (3.0 / 4.0)) then if (#wheel-arg < (5.0 / 8.0)) then ((8.0 * (#wheel-arg - 0.5)), (Color 0 0 255, Color 0 128 128)) else ((8.0 * (#wheel-arg - 0.625)), (Color 128 0 128, Color 0 0 255)) else if (#wheel-arg < (7.0 / 8.0)) then ((8.0 * (#wheel-arg - 0.75)), (Color 255 0 160, Color 128 0 128)) else ((8.0 * (#wheel-arg - 0.875)), (Color 255 0 0, Color 255 0 160))))) in:
                                                                                                                      block:
