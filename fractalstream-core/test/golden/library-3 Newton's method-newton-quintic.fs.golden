=== viewer 0: Roots of f
--- once per render
let `color` = Color 128 128 128 in:
  let `[internal] dy` = 0.0 in:
    let `[internal] dx` = 0.0 in:
      let `[internal] y` = 0.0 in:
        let `[internal] x` = 0.0 in:
          let `[internal] vanishing radius` = vanishing_radius in:
            let `[internal] escape radius` = escape_radius in:
              let `[internal] iteration limit` = max_iters in:
                let `[internal] stuck` = False in:
                  let `[internal] iteration count` = 0 in:
                    block:
                      let `lastZ` = 0:R:C in:
                        block:
                          set `[hoisted] lastZ` := lastZ

--- body
let `[internal] vanishing radius` = vanishing_radius in:
  let `[internal] escape radius` = escape_radius in:
    let `[internal] iteration limit` = max_iters in:
      let `[internal] stuck` = False in:
        let `[internal] iteration count` = 0 in:
          let `z` = ([internal] x:C + (0.0 :+ 1.0 * [internal] y:C)) in:
            let `pixel_size` = [internal] dx in:
              if ([internal] sphere view and (1.0 < (([internal] x * [internal] x) + ([internal] y * [internal] y)))) then:
                set `color` := Color 48 48 48
              else:
                block:
                  if [internal] sphere view then:
                    block:
                      let `[internal] sphere.s` = sqrt((1.0 - (([internal] x * [internal] x) + ([internal] y * [internal] y)))) in:
                        block:
                          let `[internal] sphere.X` = (([internal] sphere rotation 11 * [internal] x) + (([internal] sphere rotation 12 * [internal] y) + ([internal] sphere rotation 13 * [internal] sphere.s))) in:
                            block:
                              let `[internal] sphere.Y` = (([internal] sphere rotation 21 * [internal] x) + (([internal] sphere rotation 22 * [internal] y) + ([internal] sphere rotation 23 * [internal] sphere.s))) in:
                                block:
                                  let `[internal] sphere.Z` = (([internal] sphere rotation 31 * [internal] x) + (([internal] sphere rotation 32 * [internal] y) + ([internal] sphere rotation 33 * [internal] sphere.s))) in:
                                    block:
                                      set `z` := (([internal] sphere.X:C + ([internal] sphere.Y:C * 0.0 :+ 1.0)) / (1.0 + [internal] sphere.Z):C)
                  else:
                    no-op
                  block:
                    let `lastZ` = [hoisted] lastZ in:
                      block:
                        let `[internal] fresh #36` = 0 in:
                          let `[internal] fresh #37` = [internal] iteration limit in:
                            block:
                              do-while (!(|(z - lastZ)| < [internal] vanishing radius) and ([internal] fresh #36 < [internal] fresh #37)):
                                block:
                                  block:
                                    set `lastZ` := z
                                    set `z` := let [internal] newton.z #0 = z in ([internal] newton.z #0 - (let [internal] f.z #1 = [internal] newton.z #0 in ((([internal] f.z #1 ^ 5:R:C) - [internal] f.z #1) - 1:R:C) / let [internal] f'.z #2 = [internal] newton.z #0 in ((5:R:C * ([internal] f'.z #2 ^ 4:R:C)) - 1:R:C)))
                                  set `[internal] fresh #36` := ([internal] fresh #36 + 1)
                              set `[internal] iteration count` := [internal] fresh #36
                              set `[internal] stuck` := ([internal] fresh #36 = [internal] fresh #37)
                        let `[colorizer] Roots of f: z` = z in:
                          block:
                            if [internal] stuck then:
                              block:
                                set `color` := [colorizer] Roots of f: gives_up
                            else:
                              block:
                                if [colorizer] Roots of f: allow_new then:
                                  block:
                                    set `color` := autocolor(0, [colorizer] Roots of f: z)
                                else:
                                  if [colorizer] Roots of f: blend_misses then:
                                    block:
                                      set `color` := get_autocolor(0, [colorizer] Roots of f: z)
                                  else:
                                    block:
                                      set `color` := nearest_autocolor(0, [colorizer] Roots of f: z)
                                if [colorizer] Roots of f: shade then:
                                  block:
                                    set `color` := let #cycle-arg = (([internal] iteration count:R / [colorizer] Roots of f: period) mod 1.0) in blend(if (#cycle-arg < (1.0 / 2.0)) then (2.0 * #cycle-arg) else (2.0 - (2.0 * #cycle-arg)), blend(0.333, Color 0 0 0, color), blend(0.333, Color 255 255 255, color))
                                else:
                                  no-op
                  if [internal] sphere view then:
                    block:
                      let `[internal] sphere.light` = ((((-0.48507125007266594 * [internal] x) + ((0.48507125007266594 * [internal] y) + (0.7276068751089989 * sqrt((1.0 - (([internal] x * [internal] x) + ([internal] y * [internal] y))))))) + 1.0) / 2.0) in:
                        block:
                          set `color` := blend((1.0 - ([internal] sphere shading * (1.0 - [internal] sphere.light))), color, Color 0 0 0)
                  else:
                    no-op


--- tool Trace
  -- on click
let `[internal] vanishing radius` = vanishing_radius in:
  let `[internal] escape radius` = escape_radius in:
    let `[internal] iteration limit` = max_iters in:
      let `[internal] stuck` = False in:
        let `[internal] iteration count` = 0 in:
          let `z` = ([internal] x:C + (0.0 :+ 1.0 * [internal] y:C)) in:
            let `pixel_size` = [internal] px in:
              block:
                erase
                use Color 255 255 255 for line
                block:
                  let `[internal] previous.z #0` = z in:
                    block:
                      block:
                        let `[internal] stops.prev #1` = z in:
                          block:
                            let `[internal] fresh #21` = 0 in:
                              let `[internal] fresh #22` = [internal] iteration limit in:
                                block:
                                  do-while (!(|(z - [internal] stops.prev #1)| < [internal] vanishing radius) and ([internal] fresh #21 < [internal] fresh #22)):
                                    block:
                                      block:
                                        set `[internal] stops.prev #1` := z
                                        block:
                                          set `[internal] previous.z #0` := z
                                          block:
                                            set `z` := let [internal] newton.z #0 = z in ([internal] newton.z #0 - (let [internal] f.z #1 = [internal] newton.z #0 in ((([internal] f.z #1 ^ 5:R:C) - [internal] f.z #1) - 1:R:C) / let [internal] f'.z #2 = [internal] newton.z #0 in ((5:R:C * ([internal] f'.z #2 ^ 4:R:C)) - 1:R:C)))
                                            draw point at [internal] previous.z #0:R^2
                                            draw line from [internal] previous.z #0:R^2 to z:R^2
                                      set `[internal] fresh #21` := ([internal] fresh #21 + 1)
                                  set `[internal] iteration count` := [internal] fresh #21
                                  set `[internal] stuck` := ([internal] fresh #21 = [internal] fresh #22)
                draw point at z:R^2

  -- on drag
let `[internal] vanishing radius` = vanishing_radius in:
  let `[internal] escape radius` = escape_radius in:
    let `[internal] iteration limit` = max_iters in:
      let `[internal] stuck` = False in:
        let `[internal] iteration count` = 0 in:
          let `z` = ([internal] x:C + (0.0 :+ 1.0 * [internal] y:C)) in:
            let `[unused] start` = ([internal] oldx:C + (0.0 :+ 1.0 * [internal] oldy:C)) in:
              let `pixel_size` = [internal] px in:
                block:
                  erase
                  use Color 255 255 255 for line
                  block:
                    let `[internal] previous.z #0` = z in:
                      block:
                        block:
                          let `[internal] stops.prev #1` = z in:
                            block:
                              let `[internal] fresh #24` = 0 in:
                                let `[internal] fresh #25` = [internal] iteration limit in:
                                  block:
                                    do-while (!(|(z - [internal] stops.prev #1)| < [internal] vanishing radius) and ([internal] fresh #24 < [internal] fresh #25)):
                                      block:
                                        block:
                                          set `[internal] stops.prev #1` := z
                                          block:
                                            set `[internal] previous.z #0` := z
                                            block:
                                              set `z` := let [internal] newton.z #0 = z in ([internal] newton.z #0 - (let [internal] f.z #1 = [internal] newton.z #0 in ((([internal] f.z #1 ^ 5:R:C) - [internal] f.z #1) - 1:R:C) / let [internal] f'.z #2 = [internal] newton.z #0 in ((5:R:C * ([internal] f'.z #2 ^ 4:R:C)) - 1:R:C)))
                                              draw point at [internal] previous.z #0:R^2
                                              draw line from [internal] previous.z #0:R^2 to z:R^2
                                        set `[internal] fresh #24` := ([internal] fresh #24 + 1)
                                    set `[internal] iteration count` := [internal] fresh #24
                                    set `[internal] stuck` := ([internal] fresh #24 = [internal] fresh #25)
                  draw point at z:R^2

  -- on deactivated
let `[internal] vanishing radius` = vanishing_radius in:
  let `[internal] escape radius` = escape_radius in:
    let `[internal] iteration limit` = max_iters in:
      let `[internal] stuck` = False in:
        let `[internal] iteration count` = 0 in:
          let `pixel_size` = [internal] px in:
            block:
              erase


