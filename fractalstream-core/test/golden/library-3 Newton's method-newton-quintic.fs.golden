                      block:
                        let `[internal] fresh #35` = 0 in:
                          let `[internal] fresh #36` = [internal] iteration limit in:
                            block:
                              do-while (!(|(z - lastZ)| < [internal] vanishing radius) and ([internal] fresh #35 < [internal] fresh #36)):
                                block:
