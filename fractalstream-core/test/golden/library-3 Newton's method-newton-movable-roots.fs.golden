--- tool Move roots
  -- on drag
let `[internal] vanishing radius` = tol in:
  let `[internal] escape radius` = escape_radius in:
    let `[internal] iteration limit` = max_iters in:
      let `[internal] stuck` = False in:
        let `[internal] iteration count` = 0 in:
          let `[internal] drag end` = [internal] point a in:
            let `[internal] drag start` = [internal] old point a in:
              let `pixel_size` = [internal] px in:
                block:
                  let `z` = [internal] drag end in:
                    block:
                      let `z0` = [internal] drag start in:
                        block:
                          if (drag_target = 0) then:
                            block:
                              if (|(z0 - a)| < (rad * pixel_size)) then:
                                block:
                                  set `drag_target` := 1
                              else:
                                if (|(z0 - b)| < (rad * pixel_size)) then:
                                  block:
                                    set `drag_target` := 2
                                else:
                                  if (|(z0 - c)| < (rad * pixel_size)) then:
                                    block:
                                      set `drag_target` := 3
                                  else:
                                    no-op
                          else:
                            if (drag_target = 1) then:
                              block:
                                set `a` := z
                            else:
                              if (drag_target = 2) then:
                                block:
                                  set `b` := z
                              else:
                                if (drag_target = 3) then:
                                  block:
                                    set `c` := z
                                else:
                                  no-op
                          erase
                          draw point at (a, 1.0 :+ 0.0)
                          draw point at (b, 1.0 :+ 0.0)
                          draw point at (c, 1.0 :+ 0.0)

  -- on drag-done
let `[internal] vanishing radius` = tol in:
  let `[internal] escape radius` = escape_radius in:
