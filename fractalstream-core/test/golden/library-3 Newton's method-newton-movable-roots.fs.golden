=== viewer 0: Roots of f
--- once per render
let `color` = Color 128 128 128 in:
  let `[internal] dy` = 0.0 in:
    let `[internal] dx` = 0.0 in:
      let `[internal] y` = 0.0 in:
        let `[internal] x` = 0.0 in:
          let `[internal] vanishing radius` = tol in:
            let `[internal] escape radius` = escape_radius in:
              let `[internal] iteration limit` = max_iters in:
                let `[internal] stuck` = False in:
                  let `[internal] iteration count` = 0 in:
                    block:
                      let `lastZ` = 0:R:C in:
                        block:
                          let `col` = Color 255 255 0 in:
                            block:
                              set `[hoisted] lastZ` := lastZ
                              set `[hoisted] col` := col

--- body
let `[internal] vanishing radius` = tol in:
  let `[internal] escape radius` = escape_radius in:
    let `[internal] iteration limit` = max_iters in:
      let `[internal] stuck` = False in:
        let `[internal] iteration count` = 0 in:
          let `z` = ([internal] x:C + (0.0 :+ 1.0 * [internal] y:C)) in:
            let `pixel_size` = [internal] dx in:
              if ([internal] sphere view and (1.0 < (([internal] x * [internal] x) + ([internal] y * [internal] y)))) then:
                set `color` := Color 48 48 48
              else:
                block:
                  if [internal] sphere view then:
                    block:
                      let `[internal] sphere.s` = sqrt((1.0 - (([internal] x * [internal] x) + ([internal] y * [internal] y)))) in:
                        block:
                          let `[internal] sphere.X` = (([internal] sphere rotation 11 * [internal] x) + (([internal] sphere rotation 12 * [internal] y) + ([internal] sphere rotation 13 * [internal] sphere.s))) in:
                            block:
                              let `[internal] sphere.Y` = (([internal] sphere rotation 21 * [internal] x) + (([internal] sphere rotation 22 * [internal] y) + ([internal] sphere rotation 23 * [internal] sphere.s))) in:
                                block:
                                  let `[internal] sphere.Z` = (([internal] sphere rotation 31 * [internal] x) + (([internal] sphere rotation 32 * [internal] y) + ([internal] sphere rotation 33 * [internal] sphere.s))) in:
                                    block:
                                      set `z` := (([internal] sphere.X:C + ([internal] sphere.Y:C * 0.0 :+ 1.0)) / (1.0 + [internal] sphere.Z):C)
                  else:
                    no-op
                  block:
                    let `lastZ` = [hoisted] lastZ in:
                      block:
                        let `col` = [hoisted] col in:
                          block:
                            let `[internal] fresh #39` = 0 in:
                              let `[internal] fresh #40` = [internal] iteration limit in:
                                block:
                                  do-while (!(|(z - lastZ)| < [internal] vanishing radius) and ([internal] fresh #39 < [internal] fresh #40)):
                                    block:
                                      block:
                                        set `lastZ` := z
                                        set `z` := let [internal] newton.z #0 = z in ([internal] newton.z #0 - (let [internal] f.z #1 = [internal] newton.z #0 in ((([internal] f.z #1 - a) * ([internal] f.z #1 - b)) * ([internal] f.z #1 - c)) / let [internal] f'.z #2 = [internal] newton.z #0 in ((([internal] f'.z #2 - c) * (([internal] f'.z #2 - b) + ([internal] f'.z #2 - a))) + (([internal] f'.z #2 - a) * ([internal] f'.z #2 - b)))))
                                      set `[internal] fresh #39` := ([internal] fresh #39 + 1)
                                  set `[internal] iteration count` := [internal] fresh #39
                                  set `[internal] stuck` := ([internal] fresh #39 = [internal] fresh #40)
                            if (|(z - a)| < [internal] vanishing radius) then:
                              block:
                                set `col` := Color 255 0 0
                            else:
                              if (|(z - b)| < [internal] vanishing radius) then:
                                block:
                                  set `col` := Color 0 180 0
                              else:
                                if (|(z - c)| < [internal] vanishing radius) then:
                                  block:
                                    set `col` := Color 0 0 255
                                else:
                                  no-op
                            if (|(z - lastZ)| < [internal] vanishing radius) then:
                              block:
                                set `color` := blend((cos((([internal] iteration count:R * 3.141592653589793) / 10:R)) ^ 2:R), blend(0.333, Color 0 0 0, col), blend(0.333, Color 255 255 255, col))
                            else:
                              block:
                                set `color` := Color 0 0 0
                  if [internal] sphere view then:
                    block:
                      let `[internal] sphere.light` = ((((-0.48507125007266594 * [internal] x) + ((0.48507125007266594 * [internal] y) + (0.7276068751089989 * sqrt((1.0 - (([internal] x * [internal] x) + ([internal] y * [internal] y))))))) + 1.0) / 2.0) in:
                        block:
                          set `color` := blend((1.0 - ([internal] sphere shading * (1.0 - [internal] sphere.light))), color, Color 0 0 0)
                  else:
                    no-op


--- tool Trace
  -- on click
let `[internal] vanishing radius` = tol in:
  let `[internal] escape radius` = escape_radius in:
    let `[internal] iteration limit` = max_iters in:
      let `[internal] stuck` = False in:
        let `[internal] iteration count` = 0 in:
          let `z` = ([internal] x:C + (0.0 :+ 1.0 * [internal] y:C)) in:
            let `pixel_size` = [internal] px in:
              block:
                let `lastZ` = 0:R:C in:
                  block:
                    erase
                    let `[internal] fresh #21` = 0 in:
                      let `[internal] fresh #22` = [internal] iteration limit in:
                        block:
                          do-while (!(|(z - lastZ)| < [internal] vanishing radius) and ([internal] fresh #21 < [internal] fresh #22)):
                            block:
                              block:
                                set `lastZ` := z
                                set `z` := let [internal] newton.z #0 = z in ([internal] newton.z #0 - (let [internal] f.z #1 = [internal] newton.z #0 in ((([internal] f.z #1 - a) * ([internal] f.z #1 - b)) * ([internal] f.z #1 - c)) / let [internal] f'.z #2 = [internal] newton.z #0 in ((([internal] f'.z #2 - c) * (([internal] f'.z #2 - b) + ([internal] f'.z #2 - a))) + (([internal] f'.z #2 - a) * ([internal] f'.z #2 - b)))))
                                draw point at lastZ:R^2
                                draw line from lastZ:R^2 to z:R^2
                              set `[internal] fresh #21` := ([internal] fresh #21 + 1)
                          set `[internal] iteration count` := [internal] fresh #21
                          set `[internal] stuck` := ([internal] fresh #21 = [internal] fresh #22)
                    draw point at z:R^2

  -- on drag
let `[internal] vanishing radius` = tol in:
  let `[internal] escape radius` = escape_radius in:
    let `[internal] iteration limit` = max_iters in:
      let `[internal] stuck` = False in:
        let `[internal] iteration count` = 0 in:
          let `z` = ([internal] x:C + (0.0 :+ 1.0 * [internal] y:C)) in:
            let `[unused] start` = ([internal] oldx:C + (0.0 :+ 1.0 * [internal] oldy:C)) in:
              let `pixel_size` = [internal] px in:
                block:
                  let `lastZ` = 0:R:C in:
                    block:
                      erase
                      let `[internal] fresh #24` = 0 in:
                        let `[internal] fresh #25` = [internal] iteration limit in:
                          block:
                            do-while (!(|(z - lastZ)| < [internal] vanishing radius) and ([internal] fresh #24 < [internal] fresh #25)):
                              block:
