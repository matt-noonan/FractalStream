--- tool Move roots
  -- on drag
let `[internal] vanishing radius` = tol in:
  let `[internal] escape radius` = escape_radius in:
    let `[internal] iteration limit` = max_iters in:
      let `[internal] stuck` = False in:
        let `[internal] iteration count` = 0 in:
          let `z` = ([internal] x:C + (0.0 :+ 1.0 * [internal] y:C)) in:
            let `z0` = ([internal] oldx:C + (0.0 :+ 1.0 * [internal] oldy:C)) in:
              let `pixel_size` = [internal] px in:
                block:
                  if (drag_target = 0) then:
                    block:
                      if (|(z0 - a)| < (rad * pixel_size)) then:
                        block:
                          set `drag_target` := 1
                      else:
                        if (|(z0 - b)| < (rad * pixel_size)) then:
                          block:
                            set `drag_target` := 2
                        else:
                          if (|(z0 - c)| < (rad * pixel_size)) then:
                            block:
                              set `drag_target` := 3
                          else:
                            no-op
                  else:
                    if (drag_target = 1) then:
                      block:
                        set `a` := z
                    else:
                      if (drag_target = 2) then:
                        block:
                          set `b` := z
                      else:
                        if (drag_target = 3) then:
                          block:
                            set `c` := z
                        else:
                          no-op
                  erase
                  draw point at a:R^2
                  draw point at b:R^2
                  draw point at c:R^2

  -- on drag-done
let `[internal] vanishing radius` = tol in:
  let `[internal] escape radius` = escape_radius in:
    let `[internal] iteration limit` = max_iters in:
      let `[internal] stuck` = False in:
        let `[internal] iteration count` = 0 in:
          let `z` = ([internal] x:C + (0.0 :+ 1.0 * [internal] y:C)) in:
            let `[unused] start` = ([internal] oldx:C + (0.0 :+ 1.0 * [internal] oldy:C)) in:
              let `pixel_size` = [internal] px in:
                block:
                  set `drag_target` := 0

  -- on refresh
let `[internal] vanishing radius` = tol in:
  let `[internal] escape radius` = escape_radius in:
    let `[internal] iteration limit` = max_iters in:
      let `[internal] stuck` = False in:
        let `[internal] iteration count` = 0 in:
          let `pixel_size` = [internal] px in:
            block:
              erase
              draw point at a:R^2
              draw point at b:R^2
              draw point at c:R^2

  -- on activated
let `[internal] vanishing radius` = tol in:
  let `[internal] escape radius` = escape_radius in:
    let `[internal] iteration limit` = max_iters in:
      let `[internal] stuck` = False in:
        let `[internal] iteration count` = 0 in:
          let `pixel_size` = [internal] px in:
            block:
              draw point at a:R^2
              draw point at b:R^2
              draw point at c:R^2

  -- on deactivated
let `[internal] vanishing radius` = tol in:
  let `[internal] escape radius` = escape_radius in:
    let `[internal] iteration limit` = max_iters in:
      let `[internal] stuck` = False in:
        let `[internal] iteration count` = 0 in:
          let `pixel_size` = [internal] px in:
            block:
              erase


