=== viewer 0: Roots of f
--- once per render
let `color` = Color 128 128 128 in:
  let `[internal] dy` = 0.0 in:
    let `[internal] dx` = 0.0 in:
      let `[internal] y` = 0.0 in:
        let `[internal] x` = 0.0 in:
          let `[internal] vanishing radius` = tol in:
            let `[internal] escape radius` = escape_radius in:
              let `[internal] iteration limit` = max_iters in:
                let `[internal] stuck` = False in:
                  let `[internal] iteration count` = 0 in:
                    block:
                      let `lastZ` = 0:R:C in:
                        block:
                          let `col` = Color 255 255 0 in:
                            block:
                              set `[hoisted] lastZ` := lastZ
                              set `[hoisted] col` := col

--- body
let `[internal] vanishing radius` = tol in:
  let `[internal] escape radius` = escape_radius in:
    let `[internal] iteration limit` = max_iters in:
      let `[internal] stuck` = False in:
        let `[internal] iteration count` = 0 in:
          let `z` = ([internal] x:C + (0.0 :+ 1.0 * [internal] y:C)) in:
            let `pixel_size` = [internal] dx in:
              block:
                let `lastZ` = [hoisted] lastZ in:
                  block:
                    let `col` = [hoisted] col in:
                      block:
                        let `[internal] fresh #28` = 0 in:
                          let `[internal] fresh #29` = [internal] iteration limit in:
                            block:
                              do-while (!(|(z - lastZ)| < [internal] vanishing radius) and ([internal] fresh #28 < [internal] fresh #29)):
                                block:
                                  block:
                                    set `lastZ` := z
                                    set `z` := let [internal] newton.z #0 = z in ([internal] newton.z #0 - (let [internal] f.z #1 = [internal] newton.z #0 in ((([internal] f.z #1 - a) * ([internal] f.z #1 - b)) * ([internal] f.z #1 - c)) / let [internal] f'.z #2 = [internal] newton.z #0 in ((([internal] f'.z #2 - c) * (([internal] f'.z #2 - b) + ([internal] f'.z #2 - a))) + (([internal] f'.z #2 - a) * ([internal] f'.z #2 - b)))))
                                  set `[internal] fresh #28` := ([internal] fresh #28 + 1)
                              set `[internal] iteration count` := [internal] fresh #28
                              set `[internal] stuck` := ([internal] fresh #28 = [internal] fresh #29)
                        if (|(z - a)| < [internal] vanishing radius) then:
                          block:
                            set `col` := Color 255 0 0
                        else:
                          if (|(z - b)| < [internal] vanishing radius) then:
                            block:
                              set `col` := Color 0 180 0
                          else:
                            if (|(z - c)| < [internal] vanishing radius) then:
                              block:
                                set `col` := Color 0 0 255
                            else:
                              no-op
                        if (|(z - lastZ)| < [internal] vanishing radius) then:
                          block:
                            set `color` := blend((cos((([internal] iteration count:R * 3.141592653589793) / 10:R)) ^ 2:R), blend(0.333, Color 0 0 0, col), blend(0.333, Color 255 255 255, col))
                        else:
                          block:
                            set `color` := Color 0 0 0


--- tool Trace
  -- on click
let `[internal] vanishing radius` = tol in:
  let `[internal] escape radius` = escape_radius in:
    let `[internal] iteration limit` = max_iters in:
      let `[internal] stuck` = False in:
        let `[internal] iteration count` = 0 in:
          let `z` = [internal] point a in:
            let `pixel_size` = [internal] px in:
              block:
                erase
                block:
                  let `[internal] previous.z #0` = z in:
                    block:
                      block:
                        let `[internal] stops.prev #1` = z in:
                          block:
                            let `[internal] fresh #22` = 0 in:
                              let `[internal] fresh #23` = [internal] iteration limit in:
                                block:
                                  do-while (!(|(z - [internal] stops.prev #1)| < [internal] vanishing radius) and ([internal] fresh #22 < [internal] fresh #23)):
                                    block:
                                      block:
                                        set `[internal] stops.prev #1` := z
                                        block:
                                          set `[internal] previous.z #0` := z
                                          block:
                                            set `z` := let [internal] newton.z #0 = z in ([internal] newton.z #0 - (let [internal] f.z #1 = [internal] newton.z #0 in ((([internal] f.z #1 - a) * ([internal] f.z #1 - b)) * ([internal] f.z #1 - c)) / let [internal] f'.z #2 = [internal] newton.z #0 in ((([internal] f'.z #2 - c) * (([internal] f'.z #2 - b) + ([internal] f'.z #2 - a))) + (([internal] f'.z #2 - a) * ([internal] f'.z #2 - b)))))
                                            draw point at ([internal] previous.z #0, 1.0 :+ 0.0)
                                            draw line from ([internal] previous.z #0, 1.0 :+ 0.0) to (z, 1.0 :+ 0.0)
                                      set `[internal] fresh #22` := ([internal] fresh #22 + 1)
                                  set `[internal] iteration count` := [internal] fresh #22
                                  set `[internal] stuck` := ([internal] fresh #22 = [internal] fresh #23)
                draw point at (z, 1.0 :+ 0.0)

  -- on drag
let `[internal] vanishing radius` = tol in:
  let `[internal] escape radius` = escape_radius in:
    let `[internal] iteration limit` = max_iters in:
      let `[internal] stuck` = False in:
        let `[internal] iteration count` = 0 in:
          let `z` = [internal] point a in:
            let `[unused] start` = [internal] old point a in:
              let `pixel_size` = [internal] px in:
                block:
                  erase
                  block:
                    let `[internal] previous.z #0` = z in:
                      block:
                        block:
                          let `[internal] stops.prev #1` = z in:
                            block:
                              let `[internal] fresh #25` = 0 in:
                                let `[internal] fresh #26` = [internal] iteration limit in:
                                  block:
                                    do-while (!(|(z - [internal] stops.prev #1)| < [internal] vanishing radius) and ([internal] fresh #25 < [internal] fresh #26)):
                                      block:
                                        block:
                                          set `[internal] stops.prev #1` := z
                                          block:
                                            set `[internal] previous.z #0` := z
                                            block:
                                              set `z` := let [internal] newton.z #0 = z in ([internal] newton.z #0 - (let [internal] f.z #1 = [internal] newton.z #0 in ((([internal] f.z #1 - a) * ([internal] f.z #1 - b)) * ([internal] f.z #1 - c)) / let [internal] f'.z #2 = [internal] newton.z #0 in ((([internal] f'.z #2 - c) * (([internal] f'.z #2 - b) + ([internal] f'.z #2 - a))) + (([internal] f'.z #2 - a) * ([internal] f'.z #2 - b)))))
                                              draw point at ([internal] previous.z #0, 1.0 :+ 0.0)
                                              draw line from ([internal] previous.z #0, 1.0 :+ 0.0) to (z, 1.0 :+ 0.0)
                                        set `[internal] fresh #25` := ([internal] fresh #25 + 1)
                                    set `[internal] iteration count` := [internal] fresh #25
                                    set `[internal] stuck` := ([internal] fresh #25 = [internal] fresh #26)
