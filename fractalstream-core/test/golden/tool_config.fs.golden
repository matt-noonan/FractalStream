=== viewer 0: Julia set
--- body
let `[internal] vanishing radius` = vanishing_radius in:
  let `[internal] escape radius` = escape_radius in:
    let `[internal] iteration limit` = max_iters in:
      let `[internal] stuck` = False in:
        let `[internal] iteration count` = 0 in:
          let `z` = ([internal] x:C + (0.0 :+ 1.0 * [internal] y:C)) in:
            let `pixel_size` = [internal] dx in:
              block:
                let `[internal] fresh #20` = 0 in:
                  let `[internal] fresh #21` = [internal] iteration limit in:
                    block:
                      if (!([internal] escape radius < |z|) and ([internal] fresh #20 < [internal] fresh #21)) then:
                        do-while (!([internal] escape radius < |z|) and ([internal] fresh #20 < [internal] fresh #21)):
                          block:
                            set `z` := let [internal] f.z #0 = z in (([internal] f.z #0 ^ 2:R:C) + C)
                            set `[internal] fresh #20` := ([internal] fresh #20 + 1)
                      else:
                        no-op
                      set `[internal] iteration count` := [internal] fresh #20
                      set `[internal] stuck` := ([internal] fresh #20 = [internal] fresh #21)
                if [internal] stuck then:
                  block:
                    set `color` := Color 0 0 0
                else:
                  block:
                    set `color` := blend((([internal] iteration count:R / max_iters:R) ^ p), Color 255 255 255, let [internal] [std] dark.c #0 = Color 0 0 255 in blend(0.333, [internal] [std] dark.c #0, Color 0 0 0))


--- tool Demo
  -- on refresh
let `[internal] vanishing radius` = vanishing_radius in:
  let `[internal] escape radius` = escape_radius in:
    let `[internal] iteration limit` = max_iters in:
      let `[internal] stuck` = False in:
        let `[internal] iteration count` = 0 in:
          let `pixel_size` = [internal] px in:
            block:
              erase
              draw circle at (0:R:C, 1.0 :+ 0.0) with radius R
              draw line from (0:R:C, 1.0 :+ 0.0) to ((R:C * (2.718281828459045:C ^ (0.0 :+ 1.0 * theta:C))), 1.0 :+ 0.0)
              set `R` := (R + 1.0e-3)

  -- on deactivated
let `[internal] vanishing radius` = vanishing_radius in:
  let `[internal] escape radius` = escape_radius in:
    let `[internal] iteration limit` = max_iters in:
      let `[internal] stuck` = False in:
        let `[internal] iteration count` = 0 in:
          let `pixel_size` = [internal] px in:
            block:
              erase


--- tool Trace
  -- on click
let `[internal] vanishing radius` = vanishing_radius in:
  let `[internal] escape radius` = escape_radius in:
    let `[internal] iteration limit` = max_iters in:
      let `[internal] stuck` = False in:
        let `[internal] iteration count` = 0 in:
          let `[internal] click` = [internal] point a in:
            let `pixel_size` = [internal] px in:
              block:
                let `z` = [internal] click in:
                  block:
                    let `prevZ` = z in:
                      block:
                        erase
                        let `[internal] fresh #18` = 0 in:
                          let `[internal] fresh #19` = 100 in:
                            block:
                              if ((|z| < (10:R * escape_radius)) and ([internal] fresh #18 < [internal] fresh #19)) then:
                                do-while ((|z| < (10:R * escape_radius)) and ([internal] fresh #18 < [internal] fresh #19)):
                                  block:
                                    block:
                                      set `prevZ` := z
                                      draw point at (z, 1.0 :+ 0.0)
                                      set `z` := let [internal] f.z #0 = z in (([internal] f.z #0 ^ 2:R:C) + C)
                                      draw line from (z, 1.0 :+ 0.0) to (prevZ, 1.0 :+ 0.0)
                                    set `[internal] fresh #18` := ([internal] fresh #18 + 1)
                              else:
                                no-op
                              set `[internal] iteration count` := [internal] fresh #18
                              set `[internal] stuck` := ([internal] fresh #18 = [internal] fresh #19)

  -- on drag
let `[internal] vanishing radius` = vanishing_radius in:
  let `[internal] escape radius` = escape_radius in:
    let `[internal] iteration limit` = max_iters in:
      let `[internal] stuck` = False in:
        let `[internal] iteration count` = 0 in:
          let `[internal] click` = [internal] point a in:
            let `[unused] drag start` = [internal] old point a in:
              let `pixel_size` = [internal] px in:
                block:
                  let `z` = [internal] click in:
                    block:
                      let `prevZ` = z in:
                        block:
                          erase
                          let `[internal] fresh #21` = 0 in:
                            let `[internal] fresh #22` = 100 in:
                              block:
                                if ((|z| < (10:R * escape_radius)) and ([internal] fresh #21 < [internal] fresh #22)) then:
                                  do-while ((|z| < (10:R * escape_radius)) and ([internal] fresh #21 < [internal] fresh #22)):
                                    block:
                                      block:
                                        set `prevZ` := z
                                        draw point at (z, 1.0 :+ 0.0)
                                        set `z` := let [internal] f.z #0 = z in (([internal] f.z #0 ^ 2:R:C) + C)
                                        draw line from (z, 1.0 :+ 0.0) to (prevZ, 1.0 :+ 0.0)
                                      set `[internal] fresh #21` := ([internal] fresh #21 + 1)
                                else:
                                  no-op
                                set `[internal] iteration count` := [internal] fresh #21
                                set `[internal] stuck` := ([internal] fresh #21 = [internal] fresh #22)


