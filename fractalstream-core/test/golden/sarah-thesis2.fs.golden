                                    block:
                                      if (!([internal] escape radius < |z|) and ([internal] fresh #22 < [internal] fresh #23)) then:
                                        do-while (!([internal] escape radius < |z|) and ([internal] fresh #22 < [internal] fresh #23)):
                                          block:
                                            set `z` := ((p * (z ^ 2:R:C)) + 1:R:C)
                                            set `[internal] fresh #22` := ([internal] fresh #22 + 1)
                                      else:
                                        no-op
                                      set `[internal] iteration count` := [internal] fresh #22
                                      set `[internal] stuck` := ([internal] fresh #22 = [internal] fresh #23)
                                if ([internal] escape radius < |z|) then:
                                  block:
                                    set `color` := let [internal] [std] cycle.t #2 = (saved_count:R / 20:R) in let [internal] [std] cycle.c1 #2 = let [internal] [std] light.c #0 = Color 255 0 0 in blend(0.333, [internal] [std] light.c #0, Color 255 255 255) in let [internal] [std] cycle.c2 #2 = let [internal] [std] dark.c #1 = Color 255 0 0 in blend(0.333, [internal] [std] dark.c #1, Color 0 0 0) in let [internal] [std] cycle_at.s #3 = ([internal] [std] cycle.t #2 mod 1.0) in let [internal] [std] cycle_at.c1 #3 = [internal] [std] cycle.c1 #2 in let [internal] [std] cycle_at.c2 #3 = [internal] [std] cycle.c2 #2 in blend(if ([internal] [std] cycle_at.s #3 < 0.5) then (2:R * [internal] [std] cycle_at.s #3) else (2:R - (2:R * [internal] [std] cycle_at.s #3)), [internal] [std] cycle_at.c1 #3, [internal] [std] cycle_at.c2 #3)
                                else:
                                  block:
                                    set `color` := let [internal] [std] cycle.t #2 = (saved_count:R / 20:R) in let [internal] [std] cycle.c1 #2 = let [internal] [std] light.c #0 = Color 0 180 0 in blend(0.333, [internal] [std] light.c #0, Color 255 255 255) in let [internal] [std] cycle.c2 #2 = let [internal] [std] dark.c #1 = Color 0 180 0 in blend(0.333, [internal] [std] dark.c #1, Color 0 0 0) in let [internal] [std] cycle_at.s #3 = ([internal] [std] cycle.t #2 mod 1.0) in let [internal] [std] cycle_at.c1 #3 = [internal] [std] cycle.c1 #2 in let [internal] [std] cycle_at.c2 #3 = [internal] [std] cycle.c2 #2 in blend(if ([internal] [std] cycle_at.s #3 < 0.5) then (2:R * [internal] [std] cycle_at.s #3) else (2:R - (2:R * [internal] [std] cycle_at.s #3)), [internal] [std] cycle_at.c1 #3, [internal] [std] cycle_at.c2 #3)


