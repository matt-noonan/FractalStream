=== viewer 0: Slow mating
--- body
let `[internal] vanishing radius` = vanishing_radius in:
  let `[internal] escape radius` = escape_radius in:
    let `[internal] iteration limit` = max_iters in:
      let `[internal] stuck` = False in:
        let `[internal] iteration count` = 0 in:
          let `z` = ([internal] x:C + (0.0 :+ 1.0 * [internal] y:C)) in:
            let `pixel_size` = [internal] dx in:
              if ([internal] sphere view and (1.0 < (([internal] x * [internal] x) + ([internal] y * [internal] y)))) then:
                set `color` := Color 48 48 48
              else:
                block:
                  if [internal] sphere view then:
                    block:
                      let `[internal] sphere.s` = sqrt((1.0 - (([internal] x * [internal] x) + ([internal] y * [internal] y)))) in:
                        block:
                          let `[internal] sphere.X` = (([internal] sphere rotation 11 * [internal] x) + (([internal] sphere rotation 12 * [internal] y) + ([internal] sphere rotation 13 * [internal] sphere.s))) in:
                            block:
                              let `[internal] sphere.Y` = (([internal] sphere rotation 21 * [internal] x) + (([internal] sphere rotation 22 * [internal] y) + ([internal] sphere rotation 23 * [internal] sphere.s))) in:
                                block:
                                  let `[internal] sphere.Z` = (([internal] sphere rotation 31 * [internal] x) + (([internal] sphere rotation 32 * [internal] y) + ([internal] sphere rotation 33 * [internal] sphere.s))) in:
                                    block:
                                      set `z` := (([internal] sphere.X:C + ([internal] sphere.Y:C * 0.0 :+ 1.0)) / (1.0 + [internal] sphere.Z):C)
                  else:
                    no-op
                  block:
                    block:
                      block:
                        let `tt` = if (t < 1.0e-4) then 1.0e-4 else t in:
                          block:
                            let `L` = 1 in:
                              block:
                                let `top` = (2:R * tt) in:
                                  block:
                                    let `[internal] fresh #37` = 0 in:
                                      let `[internal] fresh #38` = 64 in:
                                        block:
                                          if ((top < 30:R) and ([internal] fresh #37 < [internal] fresh #38)) then:
                                            do-while ((top < 30:R) and ([internal] fresh #37 < [internal] fresh #38)):
                                              block:
                                                block:
                                                  set `L` := (L + 1)
                                                  set `top` := (2:R * top)
                                                set `[internal] fresh #37` := ([internal] fresh #37 + 1)
                                          else:
                                            no-op
                                          set `[internal] iteration count` := [internal] fresh #37
                                          set `[internal] stuck` := ([internal] fresh #37 = [internal] fresh #38)
                                    let `xs` = [c1] in:
                                      block:
                                        let `ys` = [c2] in:
                                          block:
                                            let `x` = c1 in:
                                              block:
                                                let `y` = c2 in:
                                                  block:
                                                    block:
                                                      let `[list at 48:2]` = range(0, L) in:
                                                        block:
                                                          {TODO: ForEach}
                                                    let `a` = transform(xs, p ⟼ (p * exp(-top):C)) in:
                                                      block:
                                                        let `b` = transform(ys, p ⟼ (p * exp(-top):C)) in:
                                                          block:
                                                            let `As` = [] in:
                                                              block:
                                                                let `Bs` = [] in:
                                                                  block:
                                                                    let `s` = top in:
                                                                      block:
                                                                        let `k` = (L - 1) in:
                                                                          block:
                                                                            let `[internal] fresh #47` = 0 in:
                                                                              let `[internal] fresh #48` = 64 in:
                                                                                block:
                                                                                  if (!(k < 1) and ([internal] fresh #47 < [internal] fresh #48)) then:
                                                                                    do-while (!(k < 1) and ([internal] fresh #47 < [internal] fresh #48)):
                                                                                      block:
                                                                                        block:
                                                                                          set `s` := (s / 2:R)
                                                                                          let `A` = (a@1) in:
                                                                                            block:
                                                                                              let `B` = (b@1) in:
                                                                                                block:
                                                                                                  let `na` = [] in:
                                                                                                    block:
                                                                                                      let `nb` = [] in:
                                                                                                        block:
                                                                                                          block:
                                                                                                            let `[list at 66:4]` = range(1, (k + 2)) in:
                                                                                                              block:
                                                                                                                {TODO: ForEach}
                                                                                                          set `As` := join([A], As)
                                                                                                          set `Bs` := join([B], Bs)
                                                                                                          set `a` := na
                                                                                                          set `b` := nb
                                                                                                          set `k` := (k - 1)
                                                                                        set `[internal] fresh #47` := ([internal] fresh #47 + 1)
                                                                                  else:
                                                                                    no-op
                                                                                  set `[internal] iteration count` := [internal] fresh #47
                                                                                  set `[internal] stuck` := ([internal] fresh #47 = [internal] fresh #48)
                                                                            set `As` := join([(a@1)], As)
                                                                            set `Bs` := join([(b@1)], Bs)
                                                                            let `u` = z in:
                                                                              block:
                                                                                let `du` = 1:R:C in:
                                                                                  block:
                                                                                    block:
                                                                                      let `[list at 90:2]` = range(1, L) in:
                                                                                        block:
                                                                                          {TODO: ForEach}
                                                                                    let `first` = (|u| < 1:R) in:
                                                                                      block:
                                                                                        let `p` = if first then (u * exp(top):C) else (exp(top):C / u) in:
                                                                                          block:
                                                                                            let `dp` = if first then (du * exp(top):C) else ((-du * exp(top):C) / (u ^ 2:R:C)) in:
                                                                                              block:
                                                                                                let `cc` = if first then c1 else c2 in:
                                                                                                  block:
                                                                                                    let `[internal] fresh #53` = 0 in:
                                                                                                      let `[internal] fresh #54` = [internal] iteration limit in:
                                                                                                        block:
                                                                                                          if (!(1000:R < |p|) and ([internal] fresh #53 < [internal] fresh #54)) then:
                                                                                                            do-while (!(1000:R < |p|) and ([internal] fresh #53 < [internal] fresh #54)):
                                                                                                              block:
                                                                                                                block:
                                                                                                                  set `dp` := ((2:R:C * p) * dp)
                                                                                                                  set `p` := ((p ^ 2:R:C) + cc)
                                                                                                                set `[internal] fresh #53` := ([internal] fresh #53 + 1)
                                                                                                          else:
                                                                                                            no-op
                                                                                                          set `[internal] iteration count` := [internal] fresh #53
                                                                                                          set `[internal] stuck` := ([internal] fresh #53 = [internal] fresh #54)
                                                                                                    let `inside` = [internal] stuck in:
                                                                                                      block:
                                                                                                        let `g` = ((log(|p|) / exp(((L + [internal] iteration count):R * log(2:R)))) / tt) in:
                                                                                                          block:
                                                                                                            let `band` = floor((-log(g) / log(2:R))) in:
                                                                                                              block:
                                                                                                                if inside then:
                                                                                                                  block:
                                                                                                                    set `color` := if first then color1 else color2
                                                                                                                else:
                                                                                                                  block:
                                                                                                                    let `side` = if first then color1 else color2 in:
                                                                                                                      block:
                                                                                                                        set `color` := blend(g, blend(0.3, side, Color 255 255 255), blend(0.333, Color 0 0 0, side))
                                                                                                                        if (show_bands and ((band mod 2) = 1)) then:
                                                                                                                          block:
                                                                                                                            set `color` := blend(0.85, color, Color 0 0 0)
                                                                                                                        else:
                                                                                                                          no-op
                                                                                                                        let `dg` = (|dp| / ((tt * |p|) * exp(((L + [internal] iteration count):R * log(2:R))))) in:
                                                                                                                          block:
                                                                                                                            let `px` = ((pixel_size * (1:R + (|z| ^ 2:R))) / 2:R) in:
                                                                                                                              block:
                                                                                                                                if (show_equator and ((1:R - g) < ((1.5 * px) * dg))) then:
                                                                                                                                  block:
                                                                                                                                    set `color` := Color 255 0 0
                                                                                                                                else:
                                                                                                                                  no-op


=== viewer 1: Mandelbrot set
--- body
let `[internal] vanishing radius` = vanishing_radius in:
  let `[internal] escape radius` = escape_radius in:
    let `[internal] iteration limit` = max_iters in:
      let `[internal] stuck` = False in:
        let `[internal] iteration count` = 0 in:
          let `c` = ([internal] x:C + (0.0 :+ 1.0 * [internal] y:C)) in:
            let `pixel_size` = [internal] dx in:
              if ([internal] sphere view and (1.0 < (([internal] x * [internal] x) + ([internal] y * [internal] y)))) then:
                set `color` := Color 48 48 48
              else:
                block:
                  if [internal] sphere view then:
                    block:
                      let `[internal] sphere.s` = sqrt((1.0 - (([internal] x * [internal] x) + ([internal] y * [internal] y)))) in:
                        block:
                          let `[internal] sphere.X` = (([internal] sphere rotation 11 * [internal] x) + (([internal] sphere rotation 12 * [internal] y) + ([internal] sphere rotation 13 * [internal] sphere.s))) in:
                            block:
                              let `[internal] sphere.Y` = (([internal] sphere rotation 21 * [internal] x) + (([internal] sphere rotation 22 * [internal] y) + ([internal] sphere rotation 23 * [internal] sphere.s))) in:
                                block:
                                  let `[internal] sphere.Z` = (([internal] sphere rotation 31 * [internal] x) + (([internal] sphere rotation 32 * [internal] y) + ([internal] sphere rotation 33 * [internal] sphere.s))) in:
                                    block:
                                      set `c` := (([internal] sphere.X:C + ([internal] sphere.Y:C * 0.0 :+ 1.0)) / (1.0 + [internal] sphere.Z):C)
                  else:
                    no-op
                  block:
                    let `z` = 0:R:C in:
                      block:
                        let `[internal] fresh #35` = 0 in:
                          let `[internal] fresh #36` = [internal] iteration limit in:
                            block:
                              if (!([internal] escape radius < |z|) and ([internal] fresh #35 < [internal] fresh #36)) then:
                                do-while (!([internal] escape radius < |z|) and ([internal] fresh #35 < [internal] fresh #36)):
                                  block:
                                    set `z` := ((z ^ 2:R:C) + c)
                                    set `[internal] fresh #35` := ([internal] fresh #35 + 1)
                              else:
                                no-op
                              set `[internal] iteration count` := [internal] fresh #35
                              set `[internal] stuck` := ([internal] fresh #35 = [internal] fresh #36)
                        block:
                          let `[colorizer] Mandelbrot set: t` = ([internal] iteration count:R / [colorizer] Mandelbrot set: color_speed) in:
                            block:
                              block:
                                if [internal] stuck then:
                                  block:
                                    set `color` := Color 0 0 0
                                else:
                                  block:
                                    set `color` := if [colorizer] Mandelbrot set: use_arenberg then let #wheel-arg = ([colorizer] Mandelbrot set: t mod 1.0) in blend((1st if (#wheel-arg < (1.0 / 2.0)) then if (#wheel-arg < (1.0 / 4.0)) then if (#wheel-arg < (1.0 / 8.0)) then ((8.0 * (#wheel-arg - 0.0)), (Color 255 174 0, Color 255 80 81)) else ((8.0 * (#wheel-arg - 0.125)), (Color 152 190 0, Color 255 174 0)) else if (#wheel-arg < (3.0 / 8.0)) then ((8.0 * (#wheel-arg - 0.25)), (Color 0 183 74, Color 152 190 0)) else ((8.0 * (#wheel-arg - 0.375)), (Color 0 237 232, Color 0 183 74)) else if (#wheel-arg < (3.0 / 4.0)) then if (#wheel-arg < (5.0 / 8.0)) then ((8.0 * (#wheel-arg - 0.5)), (Color 0 172 255, Color 0 237 232)) else ((8.0 * (#wheel-arg - 0.625)), (Color 184 161 255, Color 0 172 255)) else if (#wheel-arg < (7.0 / 8.0)) then ((8.0 * (#wheel-arg - 0.75)), (Color 255 134 226, Color 184 161 255)) else ((8.0 * (#wheel-arg - 0.875)), (Color 255 80 81, Color 255 134 226))), (1st (2nd if (#wheel-arg < (1.0 / 2.0)) then if (#wheel-arg < (1.0 / 4.0)) then if (#wheel-arg < (1.0 / 8.0)) then ((8.0 * (#wheel-arg - 0.0)), (Color 255 174 0, Color 255 80 81)) else ((8.0 * (#wheel-arg - 0.125)), (Color 152 190 0, Color 255 174 0)) else if (#wheel-arg < (3.0 / 8.0)) then ((8.0 * (#wheel-arg - 0.25)), (Color 0 183 74, Color 152 190 0)) else ((8.0 * (#wheel-arg - 0.375)), (Color 0 237 232, Color 0 183 74)) else if (#wheel-arg < (3.0 / 4.0)) then if (#wheel-arg < (5.0 / 8.0)) then ((8.0 * (#wheel-arg - 0.5)), (Color 0 172 255, Color 0 237 232)) else ((8.0 * (#wheel-arg - 0.625)), (Color 184 161 255, Color 0 172 255)) else if (#wheel-arg < (7.0 / 8.0)) then ((8.0 * (#wheel-arg - 0.75)), (Color 255 134 226, Color 184 161 255)) else ((8.0 * (#wheel-arg - 0.875)), (Color 255 80 81, Color 255 134 226)))), (2nd (2nd if (#wheel-arg < (1.0 / 2.0)) then if (#wheel-arg < (1.0 / 4.0)) then if (#wheel-arg < (1.0 / 8.0)) then ((8.0 * (#wheel-arg - 0.0)), (Color 255 174 0, Color 255 80 81)) else ((8.0 * (#wheel-arg - 0.125)), (Color 152 190 0, Color 255 174 0)) else if (#wheel-arg < (3.0 / 8.0)) then ((8.0 * (#wheel-arg - 0.25)), (Color 0 183 74, Color 152 190 0)) else ((8.0 * (#wheel-arg - 0.375)), (Color 0 237 232, Color 0 183 74)) else if (#wheel-arg < (3.0 / 4.0)) then if (#wheel-arg < (5.0 / 8.0)) then ((8.0 * (#wheel-arg - 0.5)), (Color 0 172 255, Color 0 237 232)) else ((8.0 * (#wheel-arg - 0.625)), (Color 184 161 255, Color 0 172 255)) else if (#wheel-arg < (7.0 / 8.0)) then ((8.0 * (#wheel-arg - 0.75)), (Color 255 134 226, Color 184 161 255)) else ((8.0 * (#wheel-arg - 0.875)), (Color 255 80 81, Color 255 134 226))))) else let #wheel-arg = ([colorizer] Mandelbrot set: t mod 1.0) in blend((1st if (#wheel-arg < (1.0 / 2.0)) then if (#wheel-arg < (1.0 / 4.0)) then if (#wheel-arg < (1.0 / 8.0)) then ((8.0 * (#wheel-arg - 0.0)), (Color 255 100 0, Color 255 0 0)) else ((8.0 * (#wheel-arg - 0.125)), (Color 255 255 0, Color 255 100 0)) else if (#wheel-arg < (3.0 / 8.0)) then ((8.0 * (#wheel-arg - 0.25)), (Color 0 180 0, Color 255 255 0)) else ((8.0 * (#wheel-arg - 0.375)), (Color 0 128 128, Color 0 180 0)) else if (#wheel-arg < (3.0 / 4.0)) then if (#wheel-arg < (5.0 / 8.0)) then ((8.0 * (#wheel-arg - 0.5)), (Color 0 0 255, Color 0 128 128)) else ((8.0 * (#wheel-arg - 0.625)), (Color 128 0 128, Color 0 0 255)) else if (#wheel-arg < (7.0 / 8.0)) then ((8.0 * (#wheel-arg - 0.75)), (Color 255 0 160, Color 128 0 128)) else ((8.0 * (#wheel-arg - 0.875)), (Color 255 0 0, Color 255 0 160))), (1st (2nd if (#wheel-arg < (1.0 / 2.0)) then if (#wheel-arg < (1.0 / 4.0)) then if (#wheel-arg < (1.0 / 8.0)) then ((8.0 * (#wheel-arg - 0.0)), (Color 255 100 0, Color 255 0 0)) else ((8.0 * (#wheel-arg - 0.125)), (Color 255 255 0, Color 255 100 0)) else if (#wheel-arg < (3.0 / 8.0)) then ((8.0 * (#wheel-arg - 0.25)), (Color 0 180 0, Color 255 255 0)) else ((8.0 * (#wheel-arg - 0.375)), (Color 0 128 128, Color 0 180 0)) else if (#wheel-arg < (3.0 / 4.0)) then if (#wheel-arg < (5.0 / 8.0)) then ((8.0 * (#wheel-arg - 0.5)), (Color 0 0 255, Color 0 128 128)) else ((8.0 * (#wheel-arg - 0.625)), (Color 128 0 128, Color 0 0 255)) else if (#wheel-arg < (7.0 / 8.0)) then ((8.0 * (#wheel-arg - 0.75)), (Color 255 0 160, Color 128 0 128)) else ((8.0 * (#wheel-arg - 0.875)), (Color 255 0 0, Color 255 0 160)))), (2nd (2nd if (#wheel-arg < (1.0 / 2.0)) then if (#wheel-arg < (1.0 / 4.0)) then if (#wheel-arg < (1.0 / 8.0)) then ((8.0 * (#wheel-arg - 0.0)), (Color 255 100 0, Color 255 0 0)) else ((8.0 * (#wheel-arg - 0.125)), (Color 255 255 0, Color 255 100 0)) else if (#wheel-arg < (3.0 / 8.0)) then ((8.0 * (#wheel-arg - 0.25)), (Color 0 180 0, Color 255 255 0)) else ((8.0 * (#wheel-arg - 0.375)), (Color 0 128 128, Color 0 180 0)) else if (#wheel-arg < (3.0 / 4.0)) then if (#wheel-arg < (5.0 / 8.0)) then ((8.0 * (#wheel-arg - 0.5)), (Color 0 0 255, Color 0 128 128)) else ((8.0 * (#wheel-arg - 0.625)), (Color 128 0 128, Color 0 0 255)) else if (#wheel-arg < (7.0 / 8.0)) then ((8.0 * (#wheel-arg - 0.75)), (Color 255 0 160, Color 128 0 128)) else ((8.0 * (#wheel-arg - 0.875)), (Color 255 0 0, Color 255 0 160)))))


--- tool Pick c1
  -- on click
let `[internal] vanishing radius` = vanishing_radius in:
  let `[internal] escape radius` = escape_radius in:
    let `[internal] iteration limit` = max_iters in:
      let `[internal] stuck` = False in:
        let `[internal] iteration count` = 0 in:
          let `w` = ([internal] x:C + (0.0 :+ 1.0 * [internal] y:C)) in:
            let `pixel_size` = [internal] px in:
              block:
                set `c1` := w

  -- on drag
let `[internal] vanishing radius` = vanishing_radius in:
  let `[internal] escape radius` = escape_radius in:
    let `[internal] iteration limit` = max_iters in:
      let `[internal] stuck` = False in:
        let `[internal] iteration count` = 0 in:
          let `w` = ([internal] x:C + (0.0 :+ 1.0 * [internal] y:C)) in:
            let `[unused] start` = ([internal] oldx:C + (0.0 :+ 1.0 * [internal] oldy:C)) in:
              let `pixel_size` = [internal] px in:
                block:
                  set `c1` := w


--- tool Pick c2
  -- on click
let `[internal] vanishing radius` = vanishing_radius in:
  let `[internal] escape radius` = escape_radius in:
    let `[internal] iteration limit` = max_iters in:
      let `[internal] stuck` = False in:
        let `[internal] iteration count` = 0 in:
          let `w` = ([internal] x:C + (0.0 :+ 1.0 * [internal] y:C)) in:
            let `pixel_size` = [internal] px in:
              block:
                set `c2` := w

  -- on drag
let `[internal] vanishing radius` = vanishing_radius in:
  let `[internal] escape radius` = escape_radius in:
    let `[internal] iteration limit` = max_iters in:
      let `[internal] stuck` = False in:
        let `[internal] iteration count` = 0 in:
          let `w` = ([internal] x:C + (0.0 :+ 1.0 * [internal] y:C)) in:
            let `[unused] start` = ([internal] oldx:C + (0.0 :+ 1.0 * [internal] oldy:C)) in:
              let `pixel_size` = [internal] px in:
                block:
                  set `c2` := w


--- tool overlay
  -- on refresh
let `[internal] vanishing radius` = vanishing_radius in:
  let `[internal] escape radius` = escape_radius in:
    let `[internal] iteration limit` = max_iters in:
      let `[internal] stuck` = False in:
        let `[internal] iteration count` = 0 in:
          let `pixel_size` = [internal] px in:
            block:
              erase
              use Color 0 0 0 for line
              use color1 for line
              draw filled circle at c1:R^2 with radius (5:R * pixel_size)
              draw circle at c1:R^2 with radius (5:R * pixel_size)
              use color2 for line
              draw filled circle at c2:R^2 with radius (5:R * pixel_size)
              draw circle at c2:R^2 with radius (5:R * pixel_size)


