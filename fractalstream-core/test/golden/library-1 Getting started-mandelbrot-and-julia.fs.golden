--- tool Trace
  -- on click
let `[internal] vanishing radius` = vanishing_radius in:
  let `[internal] escape radius` = escape_radius in:
    let `[internal] iteration limit` = max_iters in:
      let `[internal] stuck` = False in:
        let `[internal] iteration count` = 0 in:
          let `z` = [internal] point a in:
            let `pixel_size` = [internal] px in:
              block:
                erase
                block:
                  let `[internal] previous.z #0` = z in:
                    block:
                      let `[internal] fresh #32` = 0 in:
                        let `[internal] fresh #33` = [internal] iteration limit in:
                          block:
                            if (!([internal] escape radius < |z|) and ([internal] fresh #32 < [internal] fresh #33)) then:
                              do-while (!([internal] escape radius < |z|) and ([internal] fresh #32 < [internal] fresh #33)):
                                block:
                                  block:
                                    set `[internal] previous.z #0` := z
                                    block:
                                      draw point at (z, 1.0 :+ 0.0)
                                      set `z` := let [internal] f.z #0 = z in (([internal] f.z #0 ^ 2:R:C) + C)
                                      draw line from (z, 1.0 :+ 0.0) to ([internal] previous.z #0, 1.0 :+ 0.0)
                                  set `[internal] fresh #32` := ([internal] fresh #32 + 1)
                            else:
                              no-op
                            set `[internal] iteration count` := [internal] fresh #32
                            set `[internal] stuck` := ([internal] fresh #32 = [internal] fresh #33)

  -- on drag
let `[internal] vanishing radius` = vanishing_radius in:
  let `[internal] escape radius` = escape_radius in:
    let `[internal] iteration limit` = max_iters in:
      let `[internal] stuck` = False in:
        let `[internal] iteration count` = 0 in:
          let `z` = [internal] point a in:
            let `[unused] start` = [internal] old point a in:
              let `pixel_size` = [internal] px in:
                block:
                  erase
                  block:
                    let `[internal] previous.z #0` = z in:
                      block:
                        let `[internal] fresh #35` = 0 in:
                          let `[internal] fresh #36` = [internal] iteration limit in:
                            block:
                              if (!([internal] escape radius < |z|) and ([internal] fresh #35 < [internal] fresh #36)) then:
                                do-while (!([internal] escape radius < |z|) and ([internal] fresh #35 < [internal] fresh #36)):
                                  block:
                                    block:
                                      set `[internal] previous.z #0` := z
                                      block:
                                        draw point at (z, 1.0 :+ 0.0)
                                        set `z` := let [internal] f.z #0 = z in (([internal] f.z #0 ^ 2:R:C) + C)
                                        draw line from (z, 1.0 :+ 0.0) to ([internal] previous.z #0, 1.0 :+ 0.0)
                                    set `[internal] fresh #35` := ([internal] fresh #35 + 1)
                              else:
                                no-op
                              set `[internal] iteration count` := [internal] fresh #35
                              set `[internal] stuck` := ([internal] fresh #35 = [internal] fresh #36)

  -- on deactivated
let `[internal] vanishing radius` = vanishing_radius in:
  let `[internal] escape radius` = escape_radius in:
    let `[internal] iteration limit` = max_iters in:
      let `[internal] stuck` = False in:
        let `[internal] iteration count` = 0 in:
          let `pixel_size` = [internal] px in:
            block:
              erase


