                                    set `color` := if (0:R < im([colorizer] Parameter plane: z)) then let [internal] [std] cycle.t #0 = ([colorizer] Parameter plane: s / [colorizer] Parameter plane: period) in let [internal] [std] cycle.c1 #0 = [colorizer] Parameter plane: upper1 in let [internal] [std] cycle.c2 #0 = [colorizer] Parameter plane: upper2 in let [internal] [std] cycle_at.s #1 = ([internal] [std] cycle.t #0 mod 1.0) in let [internal] [std] cycle_at.c1 #1 = [internal] [std] cycle.c1 #0 in let [internal] [std] cycle_at.c2 #1 = [internal] [std] cycle.c2 #0 in blend(if ([internal] [std] cycle_at.s #1 < 0.5) then (2:R * [internal] [std] cycle_at.s #1) else (2:R - (2:R * [internal] [std] cycle_at.s #1)), [internal] [std] cycle_at.c1 #1, [internal] [std] cycle_at.c2 #1) else let [internal] [std] cycle.t #2 = ([colorizer] Parameter plane: s / [colorizer] Parameter plane: period) in let [internal] [std] cycle.c1 #2 = [colorizer] Parameter plane: lower1 in let [internal] [std] cycle.c2 #2 = [colorizer] Parameter plane: lower2 in let [internal] [std] cycle_at.s #3 = ([internal] [std] cycle.t #2 mod 1.0) in let [internal] [std] cycle_at.c1 #3 = [internal] [std] cycle.c1 #2 in let [internal] [std] cycle_at.c2 #3 = [internal] [std] cycle.c2 #2 in blend(if ([internal] [std] cycle_at.s #3 < 0.5) then (2:R * [internal] [std] cycle_at.s #3) else (2:R - (2:R * [internal] [std] cycle_at.s #3)), [internal] [std] cycle_at.c1 #3, [internal] [std] cycle_at.c2 #3)


