                                      block:
                                        set `[colorizer] Parameter plane: s` := (([internal] iteration count + 1):R - (log((log(|[colorizer] Parameter plane: z|) / log(escape_radius))) / log([colorizer] Parameter plane: degree)))
                                    else:
