=== viewer 0: Mandelbrot set + logistic map bifurcations
--- body
let `[internal] vanishing radius` = vanishing_radius in:
  let `[internal] escape radius` = escape_radius in:
    let `[internal] iteration limit` = max_iters in:
      let `[internal] stuck` = False in:
        let `[internal] iteration count` = 0 in:
          let `C` = ([internal] x:C + (0.0 :+ 1.0 * [internal] y:C)) in:
            let `pixel_size` = [internal] dx in:
              block:
                let `z` = 0:R:C in:
                  block:
                    let `[internal] fresh #19` = 0 in:
                      let `[internal] fresh #20` = [internal] iteration limit in:
                        block:
                          if (!([internal] escape radius < |z|) and ([internal] fresh #19 < [internal] fresh #20)) then:
                            do-while (!([internal] escape radius < |z|) and ([internal] fresh #19 < [internal] fresh #20)):
                              block:
                                set `z` := ((z ^ 2:R:C) + C)
                                set `[internal] fresh #19` := ([internal] fresh #19 + 1)
                          else:
                            no-op
                          set `[internal] iteration count` := [internal] fresh #19
                          set `[internal] stuck` := ([internal] fresh #19 = [internal] fresh #20)
                    set `color` := if ([internal] escape radius < |z|) then blend(0.2, let #wheel-arg = (([internal] iteration count:R / 20:R) mod 1.0) in blend((1st if (#wheel-arg < (1.0 / 2.0)) then if (#wheel-arg < (1.0 / 4.0)) then if (#wheel-arg < (1.0 / 8.0)) then ((8.0 * (#wheel-arg - 0.0)), (Color 255 100 0, Color 255 0 0)) else ((8.0 * (#wheel-arg - 0.125)), (Color 255 255 0, Color 255 100 0)) else if (#wheel-arg < (3.0 / 8.0)) then ((8.0 * (#wheel-arg - 0.25)), (Color 0 180 0, Color 255 255 0)) else ((8.0 * (#wheel-arg - 0.375)), (Color 0 128 128, Color 0 180 0)) else if (#wheel-arg < (3.0 / 4.0)) then if (#wheel-arg < (5.0 / 8.0)) then ((8.0 * (#wheel-arg - 0.5)), (Color 0 0 255, Color 0 128 128)) else ((8.0 * (#wheel-arg - 0.625)), (Color 128 0 128, Color 0 0 255)) else if (#wheel-arg < (7.0 / 8.0)) then ((8.0 * (#wheel-arg - 0.75)), (Color 255 0 160, Color 128 0 128)) else ((8.0 * (#wheel-arg - 0.875)), (Color 255 0 0, Color 255 0 160))), (1st (2nd if (#wheel-arg < (1.0 / 2.0)) then if (#wheel-arg < (1.0 / 4.0)) then if (#wheel-arg < (1.0 / 8.0)) then ((8.0 * (#wheel-arg - 0.0)), (Color 255 100 0, Color 255 0 0)) else ((8.0 * (#wheel-arg - 0.125)), (Color 255 255 0, Color 255 100 0)) else if (#wheel-arg < (3.0 / 8.0)) then ((8.0 * (#wheel-arg - 0.25)), (Color 0 180 0, Color 255 255 0)) else ((8.0 * (#wheel-arg - 0.375)), (Color 0 128 128, Color 0 180 0)) else if (#wheel-arg < (3.0 / 4.0)) then if (#wheel-arg < (5.0 / 8.0)) then ((8.0 * (#wheel-arg - 0.5)), (Color 0 0 255, Color 0 128 128)) else ((8.0 * (#wheel-arg - 0.625)), (Color 128 0 128, Color 0 0 255)) else if (#wheel-arg < (7.0 / 8.0)) then ((8.0 * (#wheel-arg - 0.75)), (Color 255 0 160, Color 128 0 128)) else ((8.0 * (#wheel-arg - 0.875)), (Color 255 0 0, Color 255 0 160)))), (2nd (2nd if (#wheel-arg < (1.0 / 2.0)) then if (#wheel-arg < (1.0 / 4.0)) then if (#wheel-arg < (1.0 / 8.0)) then ((8.0 * (#wheel-arg - 0.0)), (Color 255 100 0, Color 255 0 0)) else ((8.0 * (#wheel-arg - 0.125)), (Color 255 255 0, Color 255 100 0)) else if (#wheel-arg < (3.0 / 8.0)) then ((8.0 * (#wheel-arg - 0.25)), (Color 0 180 0, Color 255 255 0)) else ((8.0 * (#wheel-arg - 0.375)), (Color 0 128 128, Color 0 180 0)) else if (#wheel-arg < (3.0 / 4.0)) then if (#wheel-arg < (5.0 / 8.0)) then ((8.0 * (#wheel-arg - 0.5)), (Color 0 0 255, Color 0 128 128)) else ((8.0 * (#wheel-arg - 0.625)), (Color 128 0 128, Color 0 0 255)) else if (#wheel-arg < (7.0 / 8.0)) then ((8.0 * (#wheel-arg - 0.75)), (Color 255 0 160, Color 128 0 128)) else ((8.0 * (#wheel-arg - 0.875)), (Color 255 0 0, Color 255 0 160))))), Color 255 255 255) else Color 0 0 0
                    if (!(re(C) < -2:R) and (!((1:R / 4:R) < re(C)) and ((offset < im(C)) and (im(C) < (offset + 1:R))))) then:
                      block:
                        let `r` = (1:R + sqrt((1:R - (4:R * re(C))))) in:
                          block:
                            let `x` = (im(C) - offset) in:
                              block:
                                let `x0` = x in:
                                  block:
                                    let `[internal] fresh #22` = 0 in:
                                      let `[internal] fresh #23` = warmup in:
                                        block:
                                          if (True and ([internal] fresh #22 < [internal] fresh #23)) then:
                                            do-while (True and ([internal] fresh #22 < [internal] fresh #23)):
                                              block:
                                                set `x` := ((r * x) * (1:R - x))
                                                set `[internal] fresh #22` := ([internal] fresh #22 + 1)
                                          else:
                                            no-op
                                          set `[internal] iteration count` := [internal] fresh #22
                                          set `[internal] stuck` := ([internal] fresh #22 = [internal] fresh #23)
                                    let `hit` = False in:
                                      block:
                                        let `[internal] fresh #23` = 0 in:
                                          let `[internal] fresh #24` = cycle_length in:
                                            block:
                                              if (!hit and ([internal] fresh #23 < [internal] fresh #24)) then:
                                                do-while (!hit and ([internal] fresh #23 < [internal] fresh #24)):
                                                  block:
                                                    block:
                                                      if (|(x - x0)| < pixel_size) then:
                                                        block:
                                                          set `hit` := True
                                                      else:
                                                        no-op
                                                      set `x` := ((x * r) * (1:R - x))
                                                    set `[internal] fresh #23` := ([internal] fresh #23 + 1)
                                              else:
                                                no-op
                                              set `[internal] iteration count` := [internal] fresh #23
                                              set `[internal] stuck` := ([internal] fresh #23 = [internal] fresh #24)
                                        set `color` := if hit then invert(color) else color
                    else:
                      no-op


--- tool Vertical line
  -- on click
let `[internal] vanishing radius` = vanishing_radius in:
  let `[internal] escape radius` = escape_radius in:
    let `[internal] iteration limit` = max_iters in:
      let `[internal] stuck` = False in:
        let `[internal] iteration count` = 0 in:
          let `C` = ([internal] x:C + (0.0 :+ 1.0 * [internal] y:C)) in:
            let `pixel_size` = [internal] px in:
              block:
                erase
                use Color 255 0 0 for line
                draw line from (re(C):C + (2:R:C * 0.0 :+ 1.0)):R^2 to (re(C):C - (2:R:C * 0.0 :+ 1.0)):R^2

  -- on drag
let `[internal] vanishing radius` = vanishing_radius in:
  let `[internal] escape radius` = escape_radius in:
    let `[internal] iteration limit` = max_iters in:
      let `[internal] stuck` = False in:
        let `[internal] iteration count` = 0 in:
          let `C` = ([internal] x:C + (0.0 :+ 1.0 * [internal] y:C)) in:
            let `[unused] start` = ([internal] oldx:C + (0.0 :+ 1.0 * [internal] oldy:C)) in:
              let `pixel_size` = [internal] px in:
                block:
                  erase
                  use Color 255 0 0 for line
                  draw line from (re(C):C + (2:R:C * 0.0 :+ 1.0)):R^2 to (re(C):C - (2:R:C * 0.0 :+ 1.0)):R^2


