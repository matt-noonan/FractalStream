--- tool Trace orbit
  -- on click
let `[internal] vanishing radius` = vanishing_radius in:
  let `[internal] escape radius` = escape_radius in:
    let `[internal] iteration limit` = iters in:
      let `[internal] stuck` = False in:
        let `[internal] iteration count` = 0 in:
          let `w` = ([internal] x:C + (0.0 :+ 1.0 * [internal] y:C)) in:
            let `pixel_size` = [internal] px in:
              block:
                let `per5_omega1` = 1.5470797535511203 in:
                  block:
                    let `per5_pconst` = -0.312026392806344 in:
                      block:
                        let `per5_q` = [0.4980983388024148; 1.8872778374306454e-3; 2.7094262443660302e-8; 1.4738034644543212e-15] in:
                          block:
                            erase
                            use Color 255 255 0 for line
                            let `pa` = 0.0:C in:
                              block:
                                let `pb` = 0.0:C in:
                                  block:
                                    block:
                                      let `[internal] per5_param.t #0` = t5 in:
                                        block:
                                          block:
                                            let `v` = ([internal] per5_param.t #0 / (2:R * per5_omega1):C) in:
                                              block:
                                                let `s1` = 0.0:C in:
                                                  block:
                                                    let `s2` = 0.0:C in:
                                                      block:
                                                        let `s3` = 0.0:C in:
                                                          block:
                                                            let `s4` = 0.0:C in:
                                                              block:
                                                                let `n` = 0 in:
                                                                  block:
                                                                    let `[internal] fresh #32` = 0 in:
                                                                      let `[internal] fresh #33` = 4 in:
                                                                        block:
                                                                          if (True and ([internal] fresh #32 < [internal] fresh #33)) then:
                                                                            do-while (True and ([internal] fresh #32 < [internal] fresh #33)):
                                                                              block:
                                                                                block:
                                                                                  let `ang` = ((((2 * n) + 1):R * 3.141592653589793):C * v) in:
                                                                                    block:
                                                                                      let `sign` = if ((n mod 2) = 0) then 1.0 else -1.0 in:
                                                                                        block:
                                                                                          let `coef` = (sign * (per5_q@(n + 1))) in:
                                                                                            block:
                                                                                              set `s1` := (s1 + (coef:C * sin(ang)))
                                                                                              set `s2` := (s2 + (((coef * ((2 * n) + 1):R) * 3.141592653589793):C * cos(ang)))
                                                                                              set `s3` := (s3 - ((coef * ((((2 * n) + 1):R * 3.141592653589793) ^ 2:R)):C * sin(ang)))
                                                                                              set `s4` := (s4 - ((coef * ((((2 * n) + 1):R * 3.141592653589793) ^ 3:R)):C * cos(ang)))
                                                                                              set `n` := (n + 1)
                                                                                set `[internal] fresh #32` := ([internal] fresh #32 + 1)
                                                                          else:
                                                                            no-op
                                                                          set `[internal] iteration count` := [internal] fresh #32
                                                                          set `[internal] stuck` := ([internal] fresh #32 = [internal] fresh #33)
                                                                    let `l2` = ((s3 / s1) - ((s2 / s1) ^ 2:R:C)) in:
                                                                      block:
                                                                        let `l3` = (((s4 / s1) - ((3:R:C * (s3 * s2)) / (s1 ^ 2:R:C))) + (2:R:C * ((s2 / s1) ^ 3:R:C))) in:
                                                                          block:
                                                                            let `wp` = (per5_pconst:C - (l2 / (4:R * (per5_omega1 ^ 2:R)):C)) in:
                                                                              block:
                                                                                let `wdp` = (-l3 / (8:R * (per5_omega1 ^ 3:R)):C) in:
                                                                                  block:
                                                                                    let `wx` = (-wp - 0.25:C) in:
                                                                                      block:
                                                                                        let `wy` = ((wdp + wx) + 1:R:C) in:
                                                                                          block:
                                                                                            set `wy` := (wy / (2:R:C * wx))
                                                                                            let `tmp` = ((wy - wx) - 1:R:C) in:
                                                                                              block:
                                                                                                set `wx` := (wx / tmp)
                                                                                                set `wy` := (wx - (1:R:C / tmp))
                                                                                                set `tmp` := ((wx + 1:R:C) * wy)
                                                                                                set `pb` := (wx / tmp)
                                                                                                set `pa` := ((wx * pb) - 1:R:C)
                                    let `prev` = w in:
                                      block:
                                        let `[internal] fresh #26` = 0 in:
                                          let `[internal] fresh #27` = 200 in:
                                            block:
                                              do-while (!(1.0e24 < |w|) and ([internal] fresh #26 < [internal] fresh #27)):
                                                block:
                                                  block:
                                                    draw point at w:R^2
                                                    set `prev` := w
                                                    set `w` := (1:R:C + (((pa * w) + pb) / (w ^ 2:R:C)))
                                                    draw line from prev:R^2 to w:R^2
                                                  set `[internal] fresh #26` := ([internal] fresh #26 + 1)
                                              set `[internal] iteration count` := [internal] fresh #26
                                              set `[internal] stuck` := ([internal] fresh #26 = [internal] fresh #27)

  -- on deactivated
let `[internal] vanishing radius` = vanishing_radius in:
  let `[internal] escape radius` = escape_radius in:
    let `[internal] iteration limit` = iters in:
      let `[internal] stuck` = False in:
        let `[internal] iteration count` = 0 in:
          let `pixel_size` = [internal] px in:
            block:
              erase


