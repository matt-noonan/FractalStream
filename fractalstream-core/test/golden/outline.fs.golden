=== viewer 0: Parameter plane
--- once per render
let `color` = Color 128 128 128 in:
  let `[internal] dy` = 0.0 in:
    let `[internal] dx` = 0.0 in:
      let `[internal] y` = 0.0 in:
        let `[internal] x` = 0.0 in:
          let `[internal] vanishing radius` = tiny in:
            let `[internal] escape radius` = escape_radius in:
              let `[internal] iteration limit` = max_iters in:
                let `[internal] stuck` = False in:
                  let `[internal] iteration count` = 0 in:
                    block:
                      let `z` = 0:R:C in:
                        block:
                          let `dzdc` = 0:R:C in:
                            block:
                              let `der` = 1:R:C in:
                                block:
                                  set `[hoisted] z` := z
                                  set `[hoisted] dzdc` := dzdc
                                  set `[hoisted] der` := der

--- body
let `[internal] vanishing radius` = tiny in:
  let `[internal] escape radius` = escape_radius in:
    let `[internal] iteration limit` = max_iters in:
      let `[internal] stuck` = False in:
        let `[internal] iteration count` = 0 in:
          block:
            set `C` := ([internal] x:C + (0.0 :+ 1.0 * [internal] y:C))
            let `pixel_size` = [internal] dx in:
              block:
                let `z` = [hoisted] z in:
                  block:
                    let `dzdc` = [hoisted] dzdc in:
                      block:
                        let `der` = [hoisted] der in:
                          block:
                            let `tol` = ((pixel_size * fatness) / 2:R) in:
                              block:
                                let `[internal] fresh #30` = 0 in:
                                  let `[internal] fresh #31` = [internal] iteration limit in:
                                    block:
                                      do-while (!((|(z / dzdc)| < tol) or (([internal] escape radius < |z|) or (|der| < [internal] vanishing radius))) and ([internal] fresh #30 < [internal] fresh #31)):
                                        block:
                                          block:
                                            set `dzdc` := (1:R:C + ((2:R:C * z) * dzdc))
                                            set `z` := ((z ^ 2:R:C) + C)
                                            set `der` := ((2:R:C * z) * der)
                                          set `[internal] fresh #30` := ([internal] fresh #30 + 1)
                                      set `[internal] iteration count` := [internal] fresh #30
                                      set `[internal] stuck` := ([internal] fresh #30 = [internal] fresh #31)
                                let `[internal] shade.on_boundary #0` = (|(z / dzdc)| < tol) in:
                                  block:
                                    if ([internal] escape radius < |z|) then:
                                      block:
                                        set `color` := exterior_color
                                    else:
                                      if [internal] shade.on_boundary #0 then:
                                        block:
                                          set `color` := boundary_color
                                      else:
                                        block:
                                          set `color` := interior_color


=== viewer 1: Dynamical plane
--- once per render
let `color` = Color 128 128 128 in:
  let `[internal] dy` = 0.0 in:
    let `[internal] dx` = 0.0 in:
      let `[internal] y` = 0.0 in:
        let `[internal] x` = 0.0 in:
          let `[internal] vanishing radius` = tiny in:
            let `[internal] escape radius` = escape_radius in:
              let `[internal] iteration limit` = max_iters in:
                let `[internal] stuck` = False in:
                  let `[internal] iteration count` = 0 in:
                    block:
                      let `dz` = 1:R:C in:
                        block:
                          set `[hoisted] dz` := dz

--- body
let `[internal] vanishing radius` = tiny in:
  let `[internal] escape radius` = escape_radius in:
    let `[internal] iteration limit` = max_iters in:
      let `[internal] stuck` = False in:
        let `[internal] iteration count` = 0 in:
          let `z` = ([internal] x:C + (0.0 :+ 1.0 * [internal] y:C)) in:
            let `pixel_size` = [internal] dx in:
              block:
                let `dz` = [hoisted] dz in:
                  block:
                    let `w` = z in:
                      block:
                        let `tol` = ((2:R * pixel_size) * fatness) in:
                          block:
                            let `[internal] fresh #28` = 0 in:
                              let `[internal] fresh #29` = [internal] iteration limit in:
                                block:
                                  do-while (!(([internal] escape radius < |z|) or ((|((z / dz) - (w / dz))| < tol) or (|dz| < [internal] vanishing radius))) and ([internal] fresh #28 < [internal] fresh #29)):
                                    block:
                                      block:
                                        set `dz` := ((2:R:C * z) * dz)
                                        set `z` := ((z ^ 2:R:C) + C)
                                      set `[internal] fresh #28` := ([internal] fresh #28 + 1)
                                  set `[internal] iteration count` := [internal] fresh #28
                                  set `[internal] stuck` := ([internal] fresh #28 = [internal] fresh #29)
                            let `[internal] shade.on_boundary #0` = (|((z / dz) - (w / dz))| < tol) in:
                              block:
                                if ([internal] escape radius < |z|) then:
                                  block:
                                    set `color` := exterior_color
                                else:
                                  if [internal] shade.on_boundary #0 then:
                                    block:
                                      set `color` := boundary_color
                                  else:
                                    block:
                                      set `color` := interior_color


