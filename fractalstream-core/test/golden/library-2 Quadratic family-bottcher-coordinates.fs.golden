                                                                let `b_L` = 0:R:C in:
                                                                  block:
                                                                    let `b_s` = 0.5 in:
                                                                      block:
                                                                        let `[internal] fresh #50` = 0 in:
                                                                          let `[internal] fresh #51` = 60 in:
                                                                            block:
                                                                              if ((|b_w| < (10:R ^ 8:R)) and ([internal] fresh #50 < [internal] fresh #51)) then:
