--- tool Böttcher coordinate
  -- on click
let `[internal] vanishing radius` = vanishing_radius in:
  let `[internal] escape radius` = escape_radius in:
    let `[internal] iteration limit` = max_iters in:
      let `[internal] stuck` = False in:
        let `[internal] iteration count` = 0 in:
          let `w` = ([internal] x:C + (0.0 :+ 1.0 * [internal] y:C)) in:
            let `pixel_size` = [internal] px in:
              block:
                erase
                let `phi` = 0:R:C in:
                  block:
                    let `grad` = 1:R in:
                      block:
                        let `found` = False in:
                          block:
                            block:
                              let `[internal] boettcher.start #0` = w in:
                                block:
                                  let `[internal] boettcher.d0 #0` = 1 in:
                                    block:
                                      let `[internal] boettcher.dc #0` = 0 in:
                                        block:
                                          block:
                                            let `b_w` = [internal] boettcher.start #0 in:
                                              block:
                                                let `b_dw` = [internal] boettcher.d0 #0:R:C in:
                                                  block:
                                                    let `b_scale` = 1.0 in:
                                                      block:
                                                        let `b_safe` = if (1:R < |C|) then (2:R * sqrt(|C|)) else 2:R in:
                                                          block:
                                                            let `b_m` = 0 in:
                                                              block:
                                                                let `[internal] fresh #35` = 0 in:
                                                                  let `[internal] fresh #36` = [internal] iteration limit in:
                                                                    block:
                                                                      if (!(b_safe < |b_w|) and ([internal] fresh #35 < [internal] fresh #36)) then:
                                                                        do-while (!(b_safe < |b_w|) and ([internal] fresh #35 < [internal] fresh #36)):
                                                                          block:
                                                                            block:
                                                                              set `b_dw` := (((2:R:C * b_w) * b_dw) + [internal] boettcher.dc #0:R:C)
                                                                              set `b_w` := ((b_w ^ 2:R:C) + C)
                                                                              set `b_scale` := (b_scale / 2:R)
                                                                              set `b_m` := (b_m + 1)
                                                                            set `[internal] fresh #35` := ([internal] fresh #35 + 1)
                                                                      else:
