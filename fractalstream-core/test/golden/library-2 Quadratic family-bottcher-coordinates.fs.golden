                                                                                else:
                                                                                  no-op
                                                                                let `G` = log(|phi|) in:
                                                                                  block:
                                                                                    let `u` = (log(G) / log(2:R)) in:
                                                                                      block:
                                                                                        let `lvl` = floor(-u) in:
                                                                                          block:
                                                                                            let `nk` = (2 ^ if (0 < (lvl + detail)) then (lvl + detail) else 0) in:
                                                                                              block:
                                                                                                let `j` = floor((t * nk:R)) in:
                                                                                                  block:
                                                                                                    let `odd` = (((lvl + j) mod 2) = 1) in:
