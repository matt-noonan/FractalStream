                                                                                let `[internal] fresh #52` = 0 in:
                                                                                  let `[internal] fresh #53` = b_m in:
                                                                                    block:
                                                                                      if (!(b_k < 0) and ([internal] fresh #52 < [internal] fresh #53)) then:
                                                                                        do-while (!(b_k < 0) and ([internal] fresh #52 < [internal] fresh #53)):
                                                                                          block:
                                                                                            block:
                                                                                              let `b_u` = [internal] boettcher.start #0 in:
                                                                                                block:
                                                                                                  let `[internal] fresh #55` = 0 in:
                                                                                                    let `[internal] fresh #56` = b_k in:
                                                                                                      block:
                                                                                                        if (True and ([internal] fresh #55 < [internal] fresh #56)) then:
                                                                                                          do-while (True and ([internal] fresh #55 < [internal] fresh #56)):
                                                                                                            block:
