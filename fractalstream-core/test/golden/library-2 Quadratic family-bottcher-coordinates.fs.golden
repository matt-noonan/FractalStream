--- tool Trace orbit
  -- on click
let `[internal] vanishing radius` = vanishing_radius in:
  let `[internal] escape radius` = escape_radius in:
    let `[internal] iteration limit` = max_iters in:
      let `[internal] stuck` = False in:
        let `[internal] iteration count` = 0 in:
          let `[internal] click` = [internal] point a in:
            let `pixel_size` = [internal] px in:
              block:
                let `w` = [internal] click in:
                  block:
                    erase
                    use Color 255 255 0 for line
                    use Color 255 255 0 for line
                    let `prev` = w in:
                      block:
                        let `[internal] fresh #24` = 0 in:
                          let `[internal] fresh #25` = 200 in:
                            block:
                              do-while (!([internal] escape radius < |w|) and ([internal] fresh #24 < [internal] fresh #25)):
                                block:
                                  block:
                                    draw point at (w, 1.0 :+ 0.0)
                                    set `prev` := w
                                    set `w` := let [internal] f.z #0 = w in (([internal] f.z #0 ^ 2:R:C) + C)
                                    draw line from (prev, 1.0 :+ 0.0) to (w, 1.0 :+ 0.0)
                                  set `[internal] fresh #24` := ([internal] fresh #24 + 1)
                              set `[internal] iteration count` := [internal] fresh #24
                              set `[internal] stuck` := ([internal] fresh #24 = [internal] fresh #25)

  -- on drag
let `[internal] vanishing radius` = vanishing_radius in:
  let `[internal] escape radius` = escape_radius in:
    let `[internal] iteration limit` = max_iters in:
      let `[internal] stuck` = False in:
        let `[internal] iteration count` = 0 in:
          let `[internal] click` = [internal] point a in:
            let `[unused] drag start` = [internal] old point a in:
              let `pixel_size` = [internal] px in:
                block:
                  let `w` = [internal] click in:
                    block:
                      erase
                      use Color 255 255 0 for line
                      use Color 255 255 0 for line
                      let `prev` = w in:
                        block:
                          let `[internal] fresh #27` = 0 in:
                            let `[internal] fresh #28` = 200 in:
                              block:
                                do-while (!([internal] escape radius < |w|) and ([internal] fresh #27 < [internal] fresh #28)):
                                  block:
                                    block:
                                      draw point at (w, 1.0 :+ 0.0)
                                      set `prev` := w
                                      set `w` := let [internal] f.z #0 = w in (([internal] f.z #0 ^ 2:R:C) + C)
                                      draw line from (prev, 1.0 :+ 0.0) to (w, 1.0 :+ 0.0)
                                    set `[internal] fresh #27` := ([internal] fresh #27 + 1)
                                set `[internal] iteration count` := [internal] fresh #27
                                set `[internal] stuck` := ([internal] fresh #27 = [internal] fresh #28)

  -- on deactivated
let `[internal] vanishing radius` = vanishing_radius in:
  let `[internal] escape radius` = escape_radius in:
    let `[internal] iteration limit` = max_iters in:
      let `[internal] stuck` = False in:
        let `[internal] iteration count` = 0 in:
          let `pixel_size` = [internal] px in:
            block:
              erase


