=== viewer 0: Dynamical plane
--- once per render
let `color` = Color 128 128 128 in:
  let `[internal] dy` = 0.0 in:
    let `[internal] dx` = 0.0 in:
      let `[internal] y` = 0.0 in:
        let `[internal] x` = 0.0 in:
          let `[internal] vanishing radius` = vanishing_radius in:
            let `[internal] escape radius` = escape_radius in:
              let `[internal] iteration limit` = max_iters in:
                let `[internal] stuck` = False in:
                  let `[internal] iteration count` = 0 in:
                    block:
                      let `v` = C in:
                        block:
                          let `n` = 0 in:
                            block:
                              let `[internal] fresh #48` = 0 in:
                                let `[internal] fresh #49` = [internal] iteration limit in:
                                  block:
                                    if ((|v| < (10:R ^ 8:R)) and ([internal] fresh #48 < [internal] fresh #49)) then:
                                      do-while ((|v| < (10:R ^ 8:R)) and ([internal] fresh #48 < [internal] fresh #49)):
                                        block:
                                          block:
                                            set `v` := ((v ^ 2:R:C) + C)
                                            set `n` := (n + 1)
                                          set `[internal] fresh #48` := ([internal] fresh #48 + 1)
                                    else:
                                      no-op
                                    set `[internal] iteration count` := [internal] fresh #48
                                    set `[internal] stuck` := ([internal] fresh #48 = [internal] fresh #49)
                              let `crit` = if [internal] stuck then 0:R else (log(|v|) / (2:R ^ (n + 1):R)) in:
                                block:
                                  let `phi` = 0:R:C in:
                                    block:
                                      let `grad` = 1:R in:
                                        block:
                                          let `found` = False in:
                                            block:
                                              let `[internal] boettcher.d0 #0` = 1 in:
                                                block:
                                                  let `[internal] boettcher.dc #0` = 0 in:
                                                    block:
                                                      let `b_dw` = [internal] boettcher.d0 #0:R:C in:
                                                        block:
                                                          let `b_scale` = 1.0 in:
                                                            block:
                                                              let `b_safe` = if (1:R < |C|) then (2:R * sqrt(|C|)) else 2:R in:
                                                                block:
                                                                  let `b_m` = 0 in:
                                                                    block:
                                                                      set `[hoisted] crit` := crit
                                                                      set `[hoisted] phi` := phi
                                                                      set `[hoisted] grad` := grad
                                                                      set `[hoisted] found` := found
                                                                      set `[hoisted] [internal] boettcher.dc #0` := [internal] boettcher.dc #0
                                                                      set `[hoisted] b_dw` := b_dw
                                                                      set `[hoisted] b_scale` := b_scale
                                                                      set `[hoisted] b_safe` := b_safe
                                                                      set `[hoisted] b_m` := b_m
                                                                      set `[hoisted] iteration count` := [internal] iteration count
                                                                      set `[hoisted] stuck` := [internal] stuck

--- body
let `[internal] vanishing radius` = vanishing_radius in:
  let `[internal] escape radius` = escape_radius in:
    let `[internal] iteration limit` = max_iters in:
      let `[internal] stuck` = [hoisted] stuck in:
        let `[internal] iteration count` = [hoisted] iteration count in:
          let `z` = ([internal] x:C + (0.0 :+ 1.0 * [internal] y:C)) in:
            let `pixel_size` = [internal] dx in:
              if ([internal] sphere view and (1.0 < (([internal] x * [internal] x) + ([internal] y * [internal] y)))) then:
                set `color` := Color 48 48 48
              else:
                block:
                  if [internal] sphere view then:
                    block:
                      let `[internal] sphere.s` = sqrt((1.0 - (([internal] x * [internal] x) + ([internal] y * [internal] y)))) in:
                        block:
                          let `[internal] sphere.X` = (([internal] sphere rotation 11 * [internal] x) + (([internal] sphere rotation 12 * [internal] y) + ([internal] sphere rotation 13 * [internal] sphere.s))) in:
                            block:
                              let `[internal] sphere.Y` = (([internal] sphere rotation 21 * [internal] x) + (([internal] sphere rotation 22 * [internal] y) + ([internal] sphere rotation 23 * [internal] sphere.s))) in:
                                block:
                                  let `[internal] sphere.Z` = (([internal] sphere rotation 31 * [internal] x) + (([internal] sphere rotation 32 * [internal] y) + ([internal] sphere rotation 33 * [internal] sphere.s))) in:
                                    block:
                                      set `z` := (([internal] sphere.X:C + ([internal] sphere.Y:C * 0.0 :+ 1.0)) / (1.0 + [internal] sphere.Z):C)
                  else:
                    no-op
                  block:
                    let `crit` = [hoisted] crit in:
                      block:
                        let `phi` = [hoisted] phi in:
                          block:
                            let `grad` = [hoisted] grad in:
                              block:
                                let `found` = [hoisted] found in:
                                  block:
                                    let `[internal] boettcher.dc #0` = [hoisted] [internal] boettcher.dc #0 in:
                                      block:
                                        let `b_dw` = [hoisted] b_dw in:
                                          block:
                                            let `b_scale` = [hoisted] b_scale in:
                                              block:
                                                let `b_safe` = [hoisted] b_safe in:
                                                  block:
                                                    let `b_m` = [hoisted] b_m in:
                                                      block:
                                                        let `[internal] boettcher.start #0` = z in:
                                                          block:
                                                            let `b_w` = [internal] boettcher.start #0 in:
                                                              block:
                                                                let `[internal] fresh #59` = 0 in:
                                                                  let `[internal] fresh #60` = [internal] iteration limit in:
                                                                    block:
                                                                      if (!(b_safe < |b_w|) and ([internal] fresh #59 < [internal] fresh #60)) then:
                                                                        do-while (!(b_safe < |b_w|) and ([internal] fresh #59 < [internal] fresh #60)):
                                                                          block:
                                                                            block:
                                                                              set `b_dw` := (((2:R:C * b_w) * b_dw) + [internal] boettcher.dc #0:R:C)
                                                                              set `b_w` := ((b_w ^ 2:R:C) + C)
                                                                              set `b_scale` := (b_scale / 2:R)
                                                                              set `b_m` := (b_m + 1)
                                                                            set `[internal] fresh #59` := ([internal] fresh #59 + 1)
                                                                      else:
                                                                        no-op
                                                                      set `[internal] iteration count` := [internal] fresh #59
                                                                      set `[internal] stuck` := ([internal] fresh #59 = [internal] fresh #60)
                                                                set `found` := (b_safe < |b_w|)
                                                                if found then:
                                                                  block:
                                                                    let `b_L` = 0:R:C in:
                                                                      block:
                                                                        let `b_s` = 0.5 in:
                                                                          block:
                                                                            let `[internal] fresh #61` = 0 in:
                                                                              let `[internal] fresh #62` = 60 in:
                                                                                block:
                                                                                  if ((|b_w| < (10:R ^ 8:R)) and ([internal] fresh #61 < [internal] fresh #62)) then:
                                                                                    do-while ((|b_w| < (10:R ^ 8:R)) and ([internal] fresh #61 < [internal] fresh #62)):
                                                                                      block:
                                                                                        block:
                                                                                          set `b_L` := (b_L + (b_s:C * log((1:R:C + (C / (b_w ^ 2:R:C))))))
                                                                                          set `b_dw` := (((2:R:C * b_w) * b_dw) + [internal] boettcher.dc #0:R:C)
                                                                                          set `b_w` := ((b_w ^ 2:R:C) + C)
                                                                                          set `b_scale` := (b_scale / 2:R)
                                                                                          set `b_s` := (b_s / 2:R)
                                                                                        set `[internal] fresh #61` := ([internal] fresh #61 + 1)
                                                                                  else:
                                                                                    no-op
                                                                                  set `[internal] iteration count` := [internal] fresh #61
                                                                                  set `[internal] stuck` := ([internal] fresh #61 = [internal] fresh #62)
                                                                            let `b_r` = exp(b_L) in:
                                                                              block:
                                                                                let `b_k` = (b_m - 1) in:
                                                                                  block:
                                                                                    let `[internal] fresh #63` = 0 in:
                                                                                      let `[internal] fresh #64` = b_m in:
                                                                                        block:
                                                                                          if (!(b_k < 0) and ([internal] fresh #63 < [internal] fresh #64)) then:
                                                                                            do-while (!(b_k < 0) and ([internal] fresh #63 < [internal] fresh #64)):
                                                                                              block:
                                                                                                block:
                                                                                                  let `b_u` = [internal] boettcher.start #0 in:
                                                                                                    block:
                                                                                                      let `[internal] fresh #66` = 0 in:
                                                                                                        let `[internal] fresh #67` = b_k in:
                                                                                                          block:
                                                                                                            if (True and ([internal] fresh #66 < [internal] fresh #67)) then:
                                                                                                              do-while (True and ([internal] fresh #66 < [internal] fresh #67)):
                                                                                                                block:
                                                                                                                  block:
                                                                                                                    set `b_u` := ((b_u ^ 2:R:C) + C)
                                                                                                                  set `[internal] fresh #66` := ([internal] fresh #66 + 1)
                                                                                                            else:
                                                                                                              no-op
                                                                                                            set `[internal] iteration count` := [internal] fresh #66
                                                                                                            set `[internal] stuck` := ([internal] fresh #66 = [internal] fresh #67)
                                                                                                      set `b_r` := sqrt((b_r * (1:R:C + (C / (b_u ^ 2:R:C)))))
                                                                                                      set `b_k` := (b_k - 1)
                                                                                                set `[internal] fresh #63` := ([internal] fresh #63 + 1)
                                                                                          else:
                                                                                            no-op
                                                                                          set `[internal] iteration count` := [internal] fresh #63
                                                                                          set `[internal] stuck` := ([internal] fresh #63 = [internal] fresh #64)
                                                                                    set `phi` := ([internal] boettcher.start #0 * b_r)
                                                                                    set `grad` := ((b_scale * |b_dw|) / |b_w|)
                                                                else:
                                                                  no-op
                                                                if found then:
                                                                  block:
                                                                    block:
                                                                      let `[internal] paint.valid #1` = (crit < log(|phi|)) in:
                                                                        block:
                                                                          block:
