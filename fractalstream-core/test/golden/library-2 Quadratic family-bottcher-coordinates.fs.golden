--- tool Böttcher coordinate
  -- on click
let `[internal] vanishing radius` = vanishing_radius in:
  let `[internal] escape radius` = escape_radius in:
    let `[internal] iteration limit` = max_iters in:
      let `[internal] stuck` = False in:
        let `[internal] iteration count` = 0 in:
          let `[internal] click` = [internal] point a in:
            let `pixel_size` = [internal] px in:
              block:
                let `w` = [internal] click in:
                  block:
                    erase
                    let `phi` = 0:R:C in:
                      block:
                        let `grad` = 1:R in:
                          block:
                            let `found` = False in:
                              block:
                                block:
                                  let `[internal] boettcher.start #0` = w in:
                                    block:
                                      let `[internal] boettcher.d0 #0` = 1 in:
                                        block:
                                          let `[internal] boettcher.dc #0` = 0 in:
                                            block:
                                              block:
                                                let `b_w` = [internal] boettcher.start #0 in:
                                                  block:
                                                    let `b_dw` = [internal] boettcher.d0 #0:R:C in:
                                                      block:
                                                        let `b_scale` = 1.0 in:
                                                          block:
                                                            let `b_safe` = if (1:R < |C|) then (2:R * sqrt(|C|)) else 2:R in:
                                                              block:
                                                                let `b_m` = 0 in:
                                                                  block:
                                                                    let `[internal] fresh #36` = 0 in:
                                                                      let `[internal] fresh #37` = [internal] iteration limit in:
                                                                        block:
                                                                          if (!(b_safe < |b_w|) and ([internal] fresh #36 < [internal] fresh #37)) then:
                                                                            do-while (!(b_safe < |b_w|) and ([internal] fresh #36 < [internal] fresh #37)):
                                                                              block:
                                                                                block:
                                                                                  set `b_dw` := (((2:R:C * b_w) * b_dw) + [internal] boettcher.dc #0:R:C)
                                                                                  set `b_w` := ((b_w ^ 2:R:C) + C)
                                                                                  set `b_scale` := (b_scale / 2:R)
                                                                                  set `b_m` := (b_m + 1)
                                                                                set `[internal] fresh #36` := ([internal] fresh #36 + 1)
                                                                          else:
                                                                            no-op
                                                                          set `[internal] iteration count` := [internal] fresh #36
                                                                          set `[internal] stuck` := ([internal] fresh #36 = [internal] fresh #37)
                                                                    set `found` := (b_safe < |b_w|)
                                                                    if found then:
                                                                      block:
                                                                        let `b_L` = 0:R:C in:
                                                                          block:
                                                                            let `b_s` = 0.5 in:
                                                                              block:
                                                                                let `[internal] fresh #38` = 0 in:
                                                                                  let `[internal] fresh #39` = 60 in:
                                                                                    block:
                                                                                      if ((|b_w| < (10:R ^ 8:R)) and ([internal] fresh #38 < [internal] fresh #39)) then:
                                                                                        do-while ((|b_w| < (10:R ^ 8:R)) and ([internal] fresh #38 < [internal] fresh #39)):
                                                                                          block:
                                                                                            block:
                                                                                              set `b_L` := (b_L + (b_s:C * log((1:R:C + (C / (b_w ^ 2:R:C))))))
                                                                                              set `b_dw` := (((2:R:C * b_w) * b_dw) + [internal] boettcher.dc #0:R:C)
                                                                                              set `b_w` := ((b_w ^ 2:R:C) + C)
                                                                                              set `b_scale` := (b_scale / 2:R)
                                                                                              set `b_s` := (b_s / 2:R)
                                                                                            set `[internal] fresh #38` := ([internal] fresh #38 + 1)
                                                                                      else:
                                                                                        no-op
                                                                                      set `[internal] iteration count` := [internal] fresh #38
                                                                                      set `[internal] stuck` := ([internal] fresh #38 = [internal] fresh #39)
                                                                                let `b_r` = exp(b_L) in:
                                                                                  block:
                                                                                    let `b_k` = (b_m - 1) in:
                                                                                      block:
                                                                                        let `[internal] fresh #40` = 0 in:
                                                                                          let `[internal] fresh #41` = b_m in:
                                                                                            block:
                                                                                              if (!(b_k < 0) and ([internal] fresh #40 < [internal] fresh #41)) then:
                                                                                                do-while (!(b_k < 0) and ([internal] fresh #40 < [internal] fresh #41)):
                                                                                                  block:
                                                                                                    block:
                                                                                                      let `b_u` = [internal] boettcher.start #0 in:
                                                                                                        block:
                                                                                                          let `[internal] fresh #43` = 0 in:
                                                                                                            let `[internal] fresh #44` = b_k in:
                                                                                                              block:
                                                                                                                if (True and ([internal] fresh #43 < [internal] fresh #44)) then:
                                                                                                                  do-while (True and ([internal] fresh #43 < [internal] fresh #44)):
                                                                                                                    block:
                                                                                                                      block:
                                                                                                                        set `b_u` := ((b_u ^ 2:R:C) + C)
                                                                                                                      set `[internal] fresh #43` := ([internal] fresh #43 + 1)
                                                                                                                else:
                                                                                                                  no-op
                                                                                                                set `[internal] iteration count` := [internal] fresh #43
                                                                                                                set `[internal] stuck` := ([internal] fresh #43 = [internal] fresh #44)
                                                                                                          set `b_r` := sqrt((b_r * (1:R:C + (C / (b_u ^ 2:R:C)))))
                                                                                                          set `b_k` := (b_k - 1)
                                                                                                    set `[internal] fresh #40` := ([internal] fresh #40 + 1)
                                                                                              else:
                                                                                                no-op
                                                                                              set `[internal] iteration count` := [internal] fresh #40
                                                                                              set `[internal] stuck` := ([internal] fresh #40 = [internal] fresh #41)
                                                                                        set `phi` := ([internal] boettcher.start #0 * b_r)
                                                                                        set `grad` := ((b_scale * |b_dw|) / |b_w|)
                                                                    else:
                                                                      no-op
                                use Color 255 255 255 for line
                                use Color 255 255 255 for line
                                draw filled circle at (w, 1.0 :+ 0.0) with radius (3:R * pixel_size)
                                if found then:
                                  block:
                                    let `t` = (arg(phi) / (2:R * 3.141592653589793)) in:
                                      block:
                                        if (t < 0:R) then:
                                          block:
                                            set `t` := (t + 1:R)
                                        else:
                                          no-op
                                        write text("\952 = ", t:Text, "\nG = ", log(|phi|):Text) at ((w + ((80:R:C + (30:R:C * 0.0 :+ 1.0)) * pixel_size:C)), 1.0 :+ 0.0)
                                        set `saved_angle` := t
                                        set `saved_G` := log(|phi|)
                                else:
                                  block:
                                    write "in K" at ((w + ((15:R:C * 0.0 :+ 1.0) * pixel_size:C)), 1.0 :+ 0.0)
                                    set `saved_angle` := 0:R
                                    set `saved_G` := 0:R

  -- on drag
let `[internal] vanishing radius` = vanishing_radius in:
  let `[internal] escape radius` = escape_radius in:
    let `[internal] iteration limit` = max_iters in:
      let `[internal] stuck` = False in:
        let `[internal] iteration count` = 0 in:
          let `[internal] click` = [internal] point a in:
            let `[unused] drag start` = [internal] old point a in:
              let `pixel_size` = [internal] px in:
                block:
                  let `w` = [internal] click in:
                    block:
                      erase
                      let `phi` = 0:R:C in:
                        block:
                          let `grad` = 1:R in:
                            block:
                              let `found` = False in:
                                block:
                                  block:
                                    let `[internal] boettcher.start #0` = w in:
                                      block:
                                        let `[internal] boettcher.d0 #0` = 1 in:
                                          block:
                                            let `[internal] boettcher.dc #0` = 0 in:
                                              block:
                                                block:
                                                  let `b_w` = [internal] boettcher.start #0 in:
                                                    block:
                                                      let `b_dw` = [internal] boettcher.d0 #0:R:C in:
                                                        block:
                                                          let `b_scale` = 1.0 in:
                                                            block:
                                                              let `b_safe` = if (1:R < |C|) then (2:R * sqrt(|C|)) else 2:R in:
                                                                block:
                                                                  let `b_m` = 0 in:
                                                                    block:
                                                                      let `[internal] fresh #39` = 0 in:
                                                                        let `[internal] fresh #40` = [internal] iteration limit in:
                                                                          block:
                                                                            if (!(b_safe < |b_w|) and ([internal] fresh #39 < [internal] fresh #40)) then:
                                                                              do-while (!(b_safe < |b_w|) and ([internal] fresh #39 < [internal] fresh #40)):
                                                                                block:
                                                                                  block:
