cabal-version:       3.0
name:                fractalstream-core
version:             2.0.0.0
synopsis:            Tool for dynamical systems research.
description:         Dynamical system visualization
license:             BSD-3-Clause
license-file:        LICENSE
author:              Matt Noonan
maintainer:          matt.noonan@gmail.com
copyright:           2021, Matt Noonan
category:            Math
build-type:          Simple
extra-source-files:  fonts/DejaVuSans.ttf
                     fonts/DejaVuSans-LICENSE

common FractalStream-common
  ghc-options:         -Wall -Werror -O2
  -- This is basically the list of extensions from
  -- https://lexi-lambda.github.io/blog/2018/02/10/an-opinionated-guide-to-haskell-in-2018/
  -- with a few minor additions like ViewPatterns.
  -- I also switch on RecordWildCards because I like it: it lets you bring
  -- all fields of a record into scope, giving some of the flavor of an OOP
  -- language with member variables automatically in scope of object methods.
  default-extensions:  ApplicativeDo
                     , BangPatterns
                     , ConstraintKinds
                     , DataKinds
                     , DefaultSignatures
                     , DeriveFoldable
                     , DeriveFunctor
                     , DeriveGeneric
                     , DeriveLift
                     , DeriveTraversable
                     , DerivingStrategies
                     , EmptyCase
                     , ExistentialQuantification
                     , FlexibleContexts
                     , FlexibleInstances
                     , FunctionalDependencies
                     , GADTs
                     , GeneralizedNewtypeDeriving
                     , InstanceSigs
                     , KindSignatures
                     , LambdaCase
                     , MultiParamTypeClasses
                     , MultiWayIf
                     , NamedFieldPuns
                     , PatternSynonyms
                     , RankNTypes
                     , RecordWildCards
                     , RequiredTypeArguments
                     , ScopedTypeVariables
                     , StandaloneDeriving
                     , TupleSections
                     , TypeApplications
                     , TypeFamilies
                     , TypeFamilyDependencies
                     , TypeOperators
                     , ViewPatterns
  default-language:    Haskell2010

library
  import: FractalStream-common
  exposed-modules:
                       FractalStream.Prelude
                       FractalStream.Metadata

                       Actor.Tool
                       Actor.Configuration
                       Actor.Colorizer
                       Actor.Autocolor
                       Actor.Ensemble
                       Actor.Layout
                       Actor.UI
                       Actor.Viewer
                       Actor.Viewer.Types
                       Actor.Viewer.Complex
                       Actor.Viewer.Overlay
                       Actor.Viewer.Sphere
                       Actor.Viewer.Preview
                       Actor.Movie
                       Actor.Metadata
                       Actor.SavedValues
                       FractalStream.Settings
                       FractalStream.Quoted
                       FractalStream.Console
                       Actor.Viewer.Overlay.Font
                       Actor.Event
                       Actor.Script

                       Event

                       Task.Concurrent
                       Task.Block

                       Language.Code
                       Language.Code.Simulator
                       Language.Code.InterpretIO
                       Language.Code.Parser
                       Language.Code.Typecheck
                       Language.Code.Syntax
                       Language.Code.Infer
                       Language.Code.Procedures
                       Language.Code.Stops
                       Language.Code.Tuples
                       Language.Legacy.Syntax
                       Language.Legacy.Parser
                       Language.Legacy.Translate
                       Language.Legacy.Binary
                       Language.Editor
                       Language.Editor.Highlight
                       Language.Editor.Lines
                       Language.Editor.Normalize
                       Language.Editor.Symbols
                       Language.Code.Typecheck.Functions
                       Language.Type
                       Language.Environment
                       Language.Value
                       Language.Value.Differentiate
                       Language.Value.Evaluator
                       Language.Value.Parser
                       Language.Value.Typecheck
                       Language.Value.Syntax
                       Language.Value.Builtins
                       Language.Value.Typing
                       Language.Value.Elaborate
                       Language.Value.Transform
                       Language.Draw
                       Language.Parser
                       Language.Typecheck
                       Language.Parser.Tokenizer
                       Language.Parser.SourceRange

                       Project

                       Data.Indexed.Functor
                       Data.Planar
                       Data.Color
                       Data.Recursive
                       Data.DynamicValue
                       Data.Codec
                       Data.YamlUnicode
                       Data.PNG
                       Data.Movie

  c-sources: src/FractalStream/find_jemalloc.c
             src/Actor/autocolor_cache.c

  build-depends:       base >=4.8 && <5,
                       random,
                       aeson,
                       yaml,
                       array,
                       async,
                       containers,
                       constraints,
                       megaparsec >= 9.1,
                       parser-combinators,
                       mtl,
                       transformers,
                       monad-parallel,
                       monad-par,
                       monad-par-extras,
                       numeric-extras,
                       text,
                       unicode-transforms,
                       time,
                       bytestring,
                       vector,
                       first-class-families,
                       bifunctors,
                       Earley,
                       file-embed,
                       directory,
                       filepath,
                       utf8-string,
                       githash,
                       zlib,
                       JuicyPixels,
                       base64-bytestring,
                       Rasterific,
                       FontyFruity,
  hs-source-dirs:      src

test-suite spec
  import: FractalStream-common
  hs-source-dirs: test
  type: exitcode-stdio-1.0
  main-is: Spec.hs
  -- (threaded, as the app is: some tests run lookups on several OS threads)
  ghc-options:        -threaded -rtsopts -with-rtsopts=-N4
  build-depends:      base >=4.8 && <5
                    , fractalstream-core
                    , hspec
                    , first-class-families
                    , raw-strings-qq
                    , mtl
                    , containers
                    , aeson
                    , yaml
                    , text
                    , vector
                    , directory
                    , filepath
                    , JuicyPixels
                    , bytestring
                    , base64-bytestring
  other-modules:      Data.Indexed.FunctorSpec
                    , Language.Value.DerivativeSpec
                    , Language.Value.EvaluatorSpec
                    , Language.Value.ParserSpec
                    , Language.Code.ParserSpec
                    , Language.Code.TuplesSpec
                    , Language.LegacySpec
                    , Language.EditorSpec
                    , Language.Editor.HighlightSpec
                    , Language.Editor.NormalizeSpec
                    , Language.Editor.SymbolsSpec
                    , Language.Effect.ListSpec
                    , Actor.EventSpec
                    , Actor.ScriptSpec
                    , Actor.EnsembleBuildSpec
                    , Actor.RealViewerSpec
                    , Actor.SphereSpec
                    , Actor.ColorizerSpec
                    , Actor.AutocolorSpec
                    , Task.ConcurrentSpec
                    , Actor.GoldenSpec
                    , Actor.OverlaySpec
                    , FractalStream.SettingsSpec
                    , Data.YamlUnicodeSpec
                    , SpecHook
  build-tool-depends: hspec-discover:hspec-discover == 2.*
