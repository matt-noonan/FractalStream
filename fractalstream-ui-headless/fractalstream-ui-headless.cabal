cabal-version:       3.0
name:                fractalstream-ui-headless
version:             2.0.0.0
synopsis:            Headless command-line frontend for FractalStream
description:         Renders a FractalStream project's named viewer to an
                      on-disk image, with no GUI. A frontend analogous to
                      fractalstream-ui-wx, implementing the same Actor.UI.UI
                      interface headlessly.
license:             BSD-3-Clause
license-file:        LICENSE
author:              Matt Noonan
maintainer:          matt.noonan@gmail.com
copyright:           2026, Matt Noonan
category:            Math
build-type:          Simple

flag use-llvm
  description: Use the LLVM backend
  default: True
  manual: True

common FractalStream-common
  ghc-options:         -Wall -Werror -O2 -Wno-star-is-type
  -- This is basically the list of extensions from
  -- https://lexi-lambda.github.io/blog/2018/02/10/an-opinionated-guide-to-haskell-in-2018/
  -- with a few minor additions like ViewPatterns.
  -- I also switch on RecordWildCards because I like it: it lets you bring
  -- all fields of a record into scope, giving some of the flavor of an OOP
  -- language with member variables automatically in scope of object methods.
  default-extensions:  ApplicativeDo
                     , BangPatterns
                     , ConstraintKinds
                     , DataKinds
                     , DefaultSignatures
                     , DeriveFoldable
                     , DeriveFunctor
                     , DeriveGeneric
                     , DeriveLift
                     , DeriveTraversable
                     , DerivingStrategies
                     , EmptyCase
                     , ExistentialQuantification
                     , FlexibleContexts
                     , FlexibleInstances
                     , FunctionalDependencies
                     , GADTs
                     , GeneralizedNewtypeDeriving
                     , InstanceSigs
                     , KindSignatures
                     , LambdaCase
                     , MultiParamTypeClasses
                     , MultiWayIf
                     , NamedFieldPuns
                     , PatternSynonyms
                     , RankNTypes
                     , RecordWildCards
                     , ScopedTypeVariables
                     , StandaloneDeriving
                     , TupleSections
                     , TypeApplications
                     , TypeFamilies
                     , TypeFamilyDependencies
                     , TypeOperators
                     , ViewPatterns
  default-language:    Haskell2010

library
  import: FractalStream-common
  exposed-modules:     Scenario
                     , Interpreter
  build-depends:       base >=4.8 && <5
                     , fractalstream-core
                     , containers
                     , JuicyPixels
                     , bytestring
                     , filepath
  hs-source-dirs:      src/lib

executable fsrun
  import: FractalStream-common
  -- -N: render on every core unless -j says otherwise
  ghc-options:         -Wall -Werror -O2
  -- (WebAssembly has no threaded RTS. There, fsrun uses the wasm backend,
  -- which loads its kernels through the JavaScript FFI, so it's a reactor
  -- module exporting its main as hs_start, for a JavaScript host to run:
  -- see dev-tools/wasm/run-node.mjs.)
  if arch(wasm32)
    ghc-options:       -no-hs-main -optl-mexec-model=reactor -optl-Wl,--export=hs_start
  else
    ghc-options:       -threaded -rtsopts -with-rtsopts=-N

  main-is:             Main.hs

  build-depends:       base >=4.8 && <5
                     , fractalstream-core
                     , fractalstream-ui-headless
                     , bytestring
                     , directory
                     , filepath
                     , text
                     , optparse-applicative

  if arch(wasm32)
     build-depends: fractalstream-backend-wasm
  elif flag(use-llvm)
     build-depends: fractalstream-backend-llvm
  else
     build-depends: fractalstream-backend-pure

  hs-source-dirs:      src

test-suite spec
  import: FractalStream-common
  hs-source-dirs: test
  type: exitcode-stdio-1.0
  main-is: Spec.hs
  build-depends:      base >=4.8 && <5
                    , fractalstream-core
                    , fractalstream-ui-headless
                    , hspec
                    , raw-strings-qq
  other-modules:      ScenarioSpec
                    , SpecHook
  build-tool-depends: hspec-discover:hspec-discover == 2.*

-- Tests that run projects end to end, with a backend (see test-backend/Main.hs)
test-suite end-to-end
  import: FractalStream-common
  hs-source-dirs: test-backend
  type: exitcode-stdio-1.0
  main-is: Main.hs
  -- (On WebAssembly, with the wasm backend, as a reactor module exporting
  -- its main as hs_start, like fsrun: run it under Node with
  -- dev-tools/wasm/node.sh fractalstream-ui-headless:test:end-to-end.)
  if arch(wasm32)
    ghc-options:      -no-hs-main -optl-mexec-model=reactor -optl-Wl,--export=hs_start
  else
    ghc-options:      -threaded
  build-depends:      base >=4.8 && <5
                    , fractalstream-core
                    , fractalstream-ui-headless
                    , hspec
                    , bytestring
  other-modules:      OverlaySpec
                    , DragSpec
                    , GeometrySpec
                    , DiskSpec
                    , GroupSpec
                    , PixelSizeSpec
                    , BlocksSpec
                    , TextSpec
                    , ToolAutocolorSpec
                    , TableSpec
                    , HoistSpec

  if arch(wasm32)
     build-depends: fractalstream-backend-wasm
  elif flag(use-llvm)
     build-depends: fractalstream-backend-llvm
  else
     build-depends: fractalstream-backend-pure
