# The native dependencies CI builds FractalStream with, prebuilt by
# .github/workflows/deps.yml and attached to the GitHub release named
# DEPS_RELEASE (a prerelease, not a FractalStream release). The desktop
# builds download them from there (dev-tools/ci/fetch-deps.sh), rather than
# keeping them in caches, which expire after a week unused.
#
# A release's files never change: to change a dependency, change it here,
# name a new DEPS_RELEASE, and run deps.yml (Actions > CI dependencies >
# Run workflow) before the builds that need it.
#
# Sourced by bash (and appended to $GITHUB_ENV): plain NAME=value lines.

DEPS_RELEASE=ci-deps-1

# LLVM, for the LLVM backend (llvm-hs): the libraries, headers and
# llvm-config, for the host's target only.
LLVM_VERSION=12.0.1

# wxWidgets, built from source on macOS (Linux and Windows use their
# package managers' 3.2).
WX_VERSION=3.2.9

# The commit of github.com/matt-noonan/wxHaskell-3.2 to build wxc from.
WXC_COMMIT=36e1fec2ed6a6b1e397544af3c13610f9e10d673

# Windows' LLVM is built with the clang of stack's GHC, which llvm-hs's C++
# shims are compiled with: so it's for this GHC (fractalstream-ui-wx's
# resolver's).
GHC_VERSION=9.10.3
