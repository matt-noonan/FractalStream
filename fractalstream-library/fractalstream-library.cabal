cabal-version:       3.0
name:                fractalstream-library
version:             2.0.0.0
synopsis:            The library of projects that ships with FractalStream.
description:         Every project under projects/, compiled in, for a
                     frontend to offer as ready-made starting points.
license:             BSD-3-Clause
author:              Matt Noonan
maintainer:          matt.noonan@gmail.com
copyright:           2021, Matt Noonan
category:            Math
build-type:          Simple
-- Listing the projects here is what makes Stack rebuild this package
-- when one is added, removed, or changed.
extra-source-files:  projects/**/*.fs
                     assets/no-preview.png

common FractalStream-common
  ghc-options:         -Wall -Werror -O2
  default-extensions:  LambdaCase
                     , ScopedTypeVariables
                     , RecordWildCards
                     , TupleSections
  default-language:    Haskell2010

library
  import: FractalStream-common
  exposed-modules:     FractalStream.Library
  build-depends:       base >=4.8 && <5
                     , fractalstream-core
                     , bytestring
                     , file-embed
                     , filepath
                     , directory
  hs-source-dirs:      src

test-suite spec
  import: FractalStream-common
  hs-source-dirs: test
  type: exitcode-stdio-1.0
  main-is: Spec.hs
  build-depends:      base >=4.8 && <5
                    , fractalstream-core
                    , fractalstream-library
                    , hspec
                    , aeson
                    , directory
                    , filepath
  other-modules:      LibrarySpec
                    , MyProjectsSpec
  build-tool-depends: hspec-discover:hspec-discover == 2.*
